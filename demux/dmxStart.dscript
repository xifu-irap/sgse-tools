/**
 * Definition of constants
 */

// Delays
const fdbkDelayOpt = -90;
const offsetDelayOpt = -94;
const sampDelayOpt = 16;
const pulseShapingSetOpt = 1;

// Levels
const fb0Opt = -528;

//const fb0Opt = 620*4;
const offsetLSBOpt = 10;
const offsetFineOpt = 0;
//const offsetLSBOpt = 0x0FFF;
//const offsetFineOpt = 7;
//const offsetCoarseOpt = 1900;
const offsetCoarseOpt = 800;

//const lockPointVOpt = -15148;
const lockPointVOpt = -14900/4;

const aOpt = [0.2, 0.2, 0.2, 0.2];
const muxInputGain = [-1, -1, -1, -1];
const ampInputGain = [1, 1, 1, 1];
//const pattern = "FULL";
//const pattern = "MINI";

/**
 * Configuring the test setup
 *  Sets all the DMX fb0 to the same value (in open loop mode)
 *  Sets all the DMX offset to the same value (in open loop mode)
 *  Sets the RA_DELAY to the value provided by the parameter ra_delay_p
 *  Does a DMX dump
 * @param {number} samp_delay_p - sampling delay [0, 19].
 * @param {number} bxLength_p - boxcar length 4 values U(4,0).
 * @param {number} fb_delay_p - feedback delay [-512, 40].
 * @param {number} fb0_p - Feedback at MUX SQUID operating point s(16,2).
 * @param {number} offsetLSB_p - offset LSB value at AMP SQUID operating point U(12,0).
 * @param {number} offsetFine_p - offset fine value at AMP SQUID operating point U(3,0).
 * @param {number} offsetCoarse_p - offset coarse value at AMP SQUID operating point U(12,0).
 * @param {number} pulseShapingSet_p - Pulse shaping set Id [0-3].
 * @param {number} lockPointV_p - Feedback lockpoints (four values) (S(12,0).
 * @param {number} muxInputGain_p - input gain for the MUX SQUID loop (four values) S(4,0).
 * @param {number} ampInputGain_p - input gain for the AMP SQUID loop (four values) S(4,0).
 * @param {number} a_p - parameter a = 1/(1+Tau) (four values) U(16, 16).
 * @param {number} pattern_p - parameters of the test pattern. 
 */
function demuxStart(samp_delay_p, bxLength_p, fb_delay_p, fb0_p, offsetLSB_p, offsetFine_p, offsetCoarse_p, pulseShapingSet_p, lockPointV_p, muxInputGain_p, ampInputGain_p, a_p, pattern_p) {

	// Autorelock parameters
	const relockThreshold = 0xFFFF;
	const relockDelay = 0xFFFF;
	//const relockThreshold = 0x0400; // 1024 
	//const relockThreshold = 0x0100; // 256 
	//const relockDelay = 0x0400;  // 1024 frames
	
    print("");
    print("***");
    print("* Configuring DEMUX firmware");
    print("***");

	print(TAB1 + "Going to IDL acquisition mode...");
	sendToDMXGoToIdleMode();
	
	print(TAB1 + "Switching off the test pattern (just in case...)");
	setDMX_testPatternEnable(false, false, 0);

    // Switching ON the feedback for all the columns
	print(TAB1+"Switching OFF the feedback OnOff for all the columns...");
    setDMX_feedbackOnOff([OFF, OFF, OFF, OFF]);
	
	print(TAB1 + "Setting the test pattern");
    const a1 = -1*Math.pow(2, 15);
    const b1 = 0;
    const c1 = 64;
    const N1 = 1023;
    const aa1 = Math.pow(2, 15)-1;
	const fullPattern = [
        [a1, b1, c1, N1],  // Slope upward -32768 -> 32704
        [aa1, b1, -c1, N1],  // Slope downward 32767 -> -32705
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0]  // Nothing
    ];
	
    const N2 = 1023;
	const c2 = 4;
	const a2 = fb0_p - Math.round(N2/2*c2);
	const aa2 = fb0_p + Math.round(N2/2*c2);
    const b2 = 0;
	const miniPattern = [
        [a2, b2, c2, N2],  // Slope upward
        [aa2, b2, -c2, N2],  // Slope downward
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0]  // Nothing
    ];

	if (pattern_p === "FULL") {
		print(TAB2 + "Defining the pattern over a full range"); 
		setDMX_testPattern(fullPattern);
	}
	else {
		if (pattern_p === "MINI") {
			print(TAB2 + "Defining the pattern over a reduced range"); 
			setDMX_testPattern(miniPattern);
		}
		else print(TAB2 + "Error, unknown pattern type");
	}
	print("");

    // set the register: SAMPLING_DELAY
    print(TAB1+"Setting the 4 registers SAMPLING_DELAY to " + samp_delay_p);
	for (var col=0; col<DMX_NB_COL; col++) setDMX_sampling_delay(col, samp_delay_p);

	// Setting the BOXCAR LENGTH
    print(TAB1+"Setting the boxcar length to " + bxLength_p);
	setDMX_boxcarLength(bxLength_p);

    // set the register: FEEDBACK_DELAY
    print(TAB1+"Setting the FB_DELAY to " + fb_delay_p);
	for (col=0; col<DMX_NB_COL; col++) setDMX_feedback_delay(col, fb_delay_p);

    // set the register: MUX_SQ_FB_DELAY
    print(TAB1 + "Setting the register MUX_SQ_FB_DELAY to " + fb_delay_p);
	for (col=0; col<DMX_NB_COL; col++) setDMX_feedback_delay(col, fb_delay_p);

    // Selecting the pulse shaping set
	print(TAB1+"Selecting the pulse shaping set number " + pulseShapingSet_p + ":");
	for (col=0; col<DMX_NB_COL; col++)	setDMX_pulseShapingSelection(col, pulseShapingSet_p);

	// Autorelock
	print(TAB1 + "Setting auto relock parameters");
	print(TAB2 + "Delay: " + relockDelay);
	print(TAB2 + "Threshold: " + relockThreshold);
	for (col=0; col<DMX_NB_COL; col++) {
		setDMX_relock_delay(col, relockDelay);
		setDMX_relock_threshold(col, relockThreshold);
	}

    // DEMUX offset
	print(TAB1+"Setting the Offset close to the AMP SQUID operating point...");
	for (col=0; col<DMX_NB_COL; col++) {
		setDMX_sqa_OffsetLSB(col, offsetLSB_p);
		setDMX_sqa_OffsetLSBptr(col, offsetLSB_p);
		setDMX_sqa_OffsetFine(col, makeArray(DMX_NB_PIX_PER_COL, offsetFine_p), makeArray(DMX_NB_PIX_PER_COL, offsetFine_p));
		setDMX_sqa_OffsetCoarse(col, offsetCoarse_p);
	}

    // Setting parameter A
	print(TAB1+"Setting the feedback parameter A: " + a_p);
	for (col=0; col<DMX_NB_COL; col++)	setDMX_a(col, makeArray(DMX_NB_PIX_PER_COL, a_p));
	
    // Setting the feedback LOCKPOINT_V
	print(TAB1+"Setting the feedback lockpoints : " + lockPointV_p);
	for (col=0; col<DMX_NB_COL; col++)	setDMX_lockpointV(col, makeArray(DMX_NB_PIX_PER_COL, lockPointV_p));

    // Setting the MUX INPUT GAIN
	print(TAB1 + "Setting the MUX SQUID loop input gain to " + muxInputGain_p);
	for (col=0; col<DMX_NB_COL; col++) setDMX_sqm_inputGain(col, muxInputGain_p[col]);

    // Setting the AMP INPUT GAIN
	print(TAB1 + "Setting the AMP SQUID loop input gain to " + ampInputGain_p);
	for (col=0; col<DMX_NB_COL; col++) setDMX_sqa_inputGain(col, ampInputGain_p[col]);

    // DEMUX feedback
	print(TAB1+"Setting the DMX FB0 values: " + fb0_p);
    var fb = makeArray(DMX_NB_PIX_PER_COL, fb0_p);
	for (col=0; col<DMX_NB_COL; col++) setDMX_fb0(col, fb);

	print(TAB1+"Switching ON the feedback OnOff for all the columns...");
    setDMX_feedbackOnOff([ON, ON, ON, ON]);

	print(TAB1+"Setting the DMX feedback mode to OPEN LOOP...");
	fbMode = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_OPEN_LOOP);
	for (col=0; col<DMX_NB_COL; col++) setDMX_sqm_FBMode(col, fbMode);

    // DEMUX offset compensation
	print(TAB1+"Setting the offset mode to OFFSET (OFFSET -> OFFSET output)...");
	setDMX_offsetMode(makeArray(DMX_NB_COL, OFFSET_MODE_OFFSET));

}

// -------------------------------------------------------------------------------------------------------------
