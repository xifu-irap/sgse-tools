// imports
include("../demux/dmxTools.dscript");
include("../demux/dmxRegAddresses.dscript");
include("../demux/dmxHk.dscript");
include("../common/utilTools.dscript");
include("../common/constants.dscript");


const ARROW = "-----------------------------------------------> "
const MESSAGE_ERROR = ARROW + " [ ERROR ]";
const MESSAGE_OK = ARROW + " [  OK  ]";


/**
 * This function checks if two values are equals. It displays a message accordingly and updates an error counter.
 * @param {number} value1 - first value
 * @param {number} value2 - second value
 * @param {number} ERROR_COUNT - counter to be updated if the 2 values are different
 * @param {string} TAB - Tabulation to be inserted before the message
 * @return {number} ERROR_COUNT - the updated value of the error counter
 */
function error_number_manager(value1, value2, ERROR_COUNT, TAB) {

    var MESSAGE = MESSAGE_OK;
    if (value1 !== value2) {
        MESSAGE = MESSAGE_ERROR;
        ERROR_COUNT++;
    }
    print(TAB + MESSAGE);

    return ERROR_COUNT;
}


/**
 * This function checks if two arrays are equals. It displays a message accordingly and updates an error counter.
 * @param {number} array1 - first value
 * @param {number} array2 - second value
 * @param {number} ERROR_COUNT - counter to be updated if the 2 arrays are different
 * @param {string} TAB - Tabulation to be inserted before the message
 * @return {number} ERROR_COUNT - the updated value of the error counter
 */
function error_array_manager(array1, array2, ERROR_COUNT, TAB) {

    var MESSAGE = MESSAGE_OK;
    if (!arraysAreEquals(array1, array2)) {
        MESSAGE = MESSAGE_ERROR;
        ERROR_COUNT++;
    }
    print(TAB + MESSAGE);

    return ERROR_COUNT;
}


/**
 * This function tests the demux commands
 */
function dmxCheckReadWrite() {

    var ERROR_COUNTER = 0;

    /******************************************************************************************************************/
    plotLongLine();
	print("| Testing the read and write of the DEMUX registers...");
    print("| " + maDate());
    plotLongLine();
    print("");


    /******************************************************************************************************************/
    plotLongLine();
    print("Reading the firmware version");
    const fwVersion = readDMX_firmwareVersion(true);


    /******************************************************************************************************************/
    plotLongLine();
    print("Reading the hardware version");
    readDMX_hardwareVersion(true);


    /******************************************************************************************************************/
    plotLongLine();
    print("Reading the delock flags");
    readDMX_delockFlag(true);


    /******************************************************************************************************************/
    plotLongLine();
    print("Reading the delock counters");

    for (var col=0; col<DMX_NB_COL; col++) {

        print(TAB1 + "Testing column " + col)
        readDMX_delockCounters(col, true);
	}

    /******************************************************************************************************************/
    plotLongLine();
    print("Reading the housekeepings");
    printDMX_HK();


    /* DATA_ACQ_MODE **************************************************************************************************/
    plotLongLine();
    print("Testing the setting of the data acquisition mode (DATA_ACQ_MODE):");

    var initial_value = readDMX_dataAcqMode();
    print(TAB1 + "Initial value is: " + initial_value);

    var new_value = ACQ_MODE_ERROR;
    print(TAB1 + "Setting new value to: " + new_value);
    setDMX_dataAcqMode(new_value);

    var checked_value = readDMX_dataAcqMode();
    print(TAB1 + "Reading the new value from the firmware: " + checked_value);

    ERROR_COUNTER = error_number_manager(new_value, checked_value, ERROR_COUNTER, TAB1);

    print(TAB1 + "Setting back the initial value");
    setDMX_dataAcqMode(initial_value);


    /* MUX_SQ_FB_ON_OFF ***********************************************************************************************/
    plotLongLine();
    print("Testing the setting of feedback on/off mode (MUX_SQ_FB_ON_OFF):");

    initial_value = readDMX_feedbackOnOff();
    print(TAB1 + "Initial value is: " + initial_value);

    new_value = [ON, OFF, OFF, ON];
    print(TAB1 + "Setting new value to: " + new_value);
    setDMX_safeFeedbackOnOff(new_value);

    checked_value = readDMX_feedbackOnOff();
    print(TAB1 + "Reading the new value from the firmware: " + checked_value);

    ERROR_COUNTER = error_array_manager(new_value, checked_value, ERROR_COUNTER, TAB1);

    print(TAB1 + "Setting back the initial value");
    setDMX_safeFeedbackOnOff(initial_value);


    /* AMP_SQ_OFFSET_MODE *********************************************************************************************/
    plotLongLine();
    print("Testing the setting of offset mode (AMP_SQ_OFFSET_MODE):");

    initial_value = readDMX_offsetMode();
    print(TAB1 + "Initial value is: " + initial_value);

    new_value = [3, 2, 1, 0];
    print(TAB1 + "Setting new value to: " + new_value);
    setDMX_offsetMode(new_value);

    checked_value = readDMX_offsetMode();
    print(TAB1 + "Reading the new value from the firmware: " + checked_value);

    ERROR_COUNTER = error_array_manager(new_value, checked_value, ERROR_COUNTER, TAB1);

    print(TAB1 + "Setting back the initial value");
    setDMX_offsetMode(initial_value);


    /* TEST_PATTERN ***************************************************************************************************/
    plotLongLine();
    print("Testing the definition of the test patterns (TEST_PATTERN):");

    initial_value = readDMX_testPattern();
    print(TAB1 + "Initial value is: " + initial_value);

    new_value = [[1024, 65535, 4, 2048],
        [-32768, 65535, 32767, 0],
        [1024, 65535, 4, 2048],
        [-32768, 65535, 32767, 0],
        [1024, 65535, 4, 2048]];
    print(TAB1 + "Setting new value to: " + new_value);
    setDMX_testPattern(new_value);

    checked_value = readDMX_testPattern();
    print(TAB1 + "Reading the new value from the firmware: " + checked_value);

    ERROR_COUNTER = error_array_manager(new_value, checked_value, ERROR_COUNTER, TAB1);

    print(TAB1 + "Setting back the initial value");
    setDMX_testPattern(initial_value);


    /* TEST_PATTERN_ENABLE ********************************************************************************************/
    plotLongLine();
    print("Testing the status of the test patterns (TEST_PATTERN_ENABLE):");

    initial_value = readDMX_testPatternEnable();
    print(TAB1 + "Initial value is: " + initial_value);

    new_value = [true, false, 0x9];
    print(TAB1 + "Setting new value to: " + new_value);
    setDMX_testPatternEnable(new_value[0], new_value[1], new_value[2]);

    checked_value = readDMX_testPatternEnable();
    print(TAB1 + "Reading the new value from the firmware: " + checked_value);

    ERROR_COUNTER = error_array_manager(new_value, checked_value, ERROR_COUNTER, TAB1);

    print(TAB1 + "Setting back the initial value");
    setDMX_testPatternEnable(initial_value[0], initial_value[1], initial_value[2]);


    /* BOXCAR_LENGTH **************************************************************************************************/
    plotLongLine();
    print("Testing the setting of the boxcar length (BOXCAR_LENGTH):");

    initial_value = readDMX_boxcarLength();
    print(TAB1 + "Initial value is: " + initial_value);

    new_value = [0, 1, 2, 3];
    print(TAB1 + "Setting new value to: " + new_value);
    setDMX_boxcarLength(new_value);

    checked_value = readDMX_boxcarLength();
    print(TAB1 + "Reading the new value from the firmware: " + checked_value);

    ERROR_COUNTER = error_array_manager(new_value, checked_value, ERROR_COUNTER, TAB1);

    print(TAB1 + "Setting back the initial value");
    setDMX_boxcarLength(initial_value);


    /* A **************************************************************************************************************/
    plotLongLine();
    print("Testing the setting of feedback algo parameter A:");

    for (var col=0; col<DMX_NB_COL; col++) {

        print(TAB1 + "Testing column " + col);

        initial_value = readDMX_a(col);
        print(TAB2 + "Initial value is: " + initial_value);

        new_value = [DMX_NB_PIX_PER_COL];
        for (pix = 0; pix < DMX_NB_PIX_PER_COL; pix++) {
			new_value[pix] = Math.round((pix / DMX_NB_PIX_PER_COL) * Math.pow(2,16))/ Math.pow(2,16);
		}
        print(TAB1 + "Setting new value to: " + new_value);
        setDMX_a(col, new_value);

        checked_value = readDMX_a(col);
        print(TAB2 + "Reading the new value from the firmware: " + checked_value);

        ERROR_COUNTER = error_array_manager(new_value, checked_value, ERROR_COUNTER, TAB2);

        print(TAB2 + "Setting back the initial value");
        setDMX_a(col, initial_value);
    }


    /* MUX_SQ_INPUT_GAIN **********************************************************************************************/
    plotLongLine();
    print("Testing the setting of the MUX SQUID input gain (MUX_SQ_INPUT_GAIN):");

    initial_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) initial_value[col] = readDMX_sqm_inputGain(col);
    print(TAB1 + "Initial value is: " + initial_value);

    new_value = [7, 4, -8, 0];
    print(TAB1 + "Setting new value to: " + new_value);
    for (col=0; col<DMX_NB_COL; col++) setDMX_sqm_inputGain(col, new_value[col]);

    checked_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) checked_value[col] = readDMX_sqm_inputGain(col);
    print(TAB1 + "Reading the new value from the firmware: " + checked_value);

    ERROR_COUNTER = error_array_manager(new_value, checked_value, ERROR_COUNTER, TAB1);

    print(TAB1 + "Setting back the initial value");
    for (col=0; col<DMX_NB_COL; col++) setDMX_sqm_inputGain(col, initial_value[col]);


    /* AMP_SQ_INPUT_GAIN **********************************************************************************************/
    plotLongLine();
    print("Testing the setting of the AMP SQUID input gain (AMP_SQ_INPUT_GAIN):");

    initial_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) initial_value[col] = readDMX_sqa_inputGain(col);
    print(TAB1 + "Initial value is: " + initial_value);

    new_value = [7, 4, -8, 0];
    print(TAB1 + "Setting new value to: " + new_value);
    for (col=0; col<DMX_NB_COL; col++) setDMX_sqa_inputGain(col, new_value[col]);

    checked_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) checked_value[col] = readDMX_sqa_inputGain(col);
    print(TAB1 + "Reading the new value from the firmware: " + checked_value);

    ERROR_COUNTER = error_array_manager(new_value, checked_value, ERROR_COUNTER, TAB1);

    print(TAB1 + "Setting back the initial value");
    for (col=0; col<DMX_NB_COL; col++) setDMX_sqa_inputGain(col, initial_value[col]);


    /* MUX_SQ_KI_KNORM ************************************************************************************************/
    plotLongLine();
    print("Testing the setting of ki.knorm for the MUX SQUID loop (MUX_SQ_KI_KNORM):");

    for (col=0; col<DMX_NB_COL; col++) {
        print(TAB1 + "Testing column " + col);

        initial_value = readDMX_sqm_kiknorm(col);
        print(TAB2 + "Initial value is: " + initial_value);

        new_value = [DMX_NB_PIX_PER_COL];
        for (pix = 0; pix < DMX_NB_PIX_PER_COL; pix++) {
			new_value[pix] = Math.round((pix*2+1) / (2*DMX_NB_PIX_PER_COL) * Math.pow(2,16)) / Math.pow(2,16);
		}
        print(TAB2 + "Setting new value to: " + new_value);
        setDMX_sqm_kiknorm(col, new_value);

        checked_value = readDMX_sqm_kiknorm(col);
        print(TAB2 + "Reading the new value from the firmware: " + checked_value);

        ERROR_COUNTER = error_array_manager(new_value, checked_value, ERROR_COUNTER, TAB2);

        print(TAB2 + "Setting back the initial value");
        setDMX_sqm_kiknorm(col, initial_value);
    }


    /* AMP_SQ_KI_KNORM ************************************************************************************************/
    plotLongLine();
    print("Testing the setting of ki.knorm for the AMP SQUID loop (AMP_SQ_KI_KNORM):");

    initial_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) initial_value[col] = readDMX_sqa_kiknorm(col);
    print(TAB1 + "Initial value is: " + initial_value);

    new_value = [0.01212, 0.2626, 0.55, 0.99];
	// taking into account the rounding

	for (col=0; col<DMX_NB_COL; col++) new_value[col] = Math.round(new_value[col]* Math.pow(2,16)) / Math.pow(2, 16);

    print(TAB1 + "Setting new value to: " + new_value);
    for (col=0; col<DMX_NB_COL; col++) setDMX_sqa_kiknorm(col, new_value[col]);

    checked_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) checked_value[col] = readDMX_sqa_kiknorm(col);
    print(TAB1 + "Reading the new value from the firmware: " + checked_value);

    ERROR_COUNTER = error_array_manager(new_value, checked_value, ERROR_COUNTER, TAB1);

    print(TAB1 + "Setting back the initial value");
    for (col=0; col<DMX_NB_COL; col++) setDMX_sqa_kiknorm(col, initial_value[col]);


    /* MUX_SQ_KNORM ***************************************************************************************************/
    plotLongLine();
    print("Testing the setting of knorm for the MUX SQUID loop (MUX_SQ_KNORM):");

    for (col=0; col<DMX_NB_COL; col++) {
        print(TAB1 + "Testing column " + col);

        initial_value = readDMX_sqm_knorm(col);
        print(TAB2 + "Initial value is: " + initial_value);

        new_value = [DMX_NB_PIX_PER_COL];
        for (pix = 0; pix < DMX_NB_PIX_PER_COL; pix++) {
			new_value[pix] = Math.round(pix / (7*DMX_NB_PIX_PER_COL) * Math.pow(2,18)) / Math.pow(2,18);
		}
        print(TAB2 + "Setting new value to: " + new_value);
        setDMX_sqm_knorm(col, new_value);

        checked_value = readDMX_sqm_knorm(col);
        print(TAB2 + "Reading the new value from the firmware: " + checked_value);

        ERROR_COUNTER = error_array_manager(new_value, checked_value, ERROR_COUNTER, TAB2);

        print(TAB2 + "Setting back the initial value");
        setDMX_sqm_knorm(col, initial_value);
    }


    /* AMP_SQ_KNORM ***************************************************************************************************/
    plotLongLine();
    print("Testing the setting of knorm for the AMP SQUID loop (AMP_SQ_KNORM):");

    initial_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) initial_value[col] = readDMX_sqa_knorm(col);
    print(TAB1 + "Initial value is: " + initial_value);

    new_value = [0.01212, 0.245, 0.12, 0.0001];
	// taking into account the rounding
	for (col=0; col<DMX_NB_COL; col++) new_value[col] = Math.round(new_value[col]* Math.pow(2,16)) / Math.pow(2, 16);
    print(TAB1 + "Setting new value to: " + new_value);
    for (col=0; col<DMX_NB_COL; col++) setDMX_sqa_knorm(col, new_value[col]);

    checked_value = [DMX_NB_COL];
    for (var col=0; col<DMX_NB_COL; col++) checked_value[col] = readDMX_sqa_knorm(col);
    print(TAB1 + "Reading the new value from the firmware: " + checked_value);

    ERROR_COUNTER = error_array_manager(new_value, checked_value, ERROR_COUNTER, TAB1);

    print(TAB1 + "Setting back the initial value");
    for (col=0; col<DMX_NB_COL; col++) setDMX_sqa_knorm(col, initial_value[col]);


