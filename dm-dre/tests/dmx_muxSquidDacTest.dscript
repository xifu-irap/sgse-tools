// imports
include("../demux/dmxTools.dscript");
include("../demux/dmxRegAddresses.dscript");
include("../demux/dmxHk.dscript");
include("../common/utilTools.dscript");
include("../common/constants.dscript");

/**
 * This function activates the Mux SQUID and outputs the FB0 set of values or the test pattern
 * @param {number} fbMode - id of the pulse shaping set [0; 3]
 * @param {number} fb_delay_p - feedback delay [-512, +40]
 * @param {number} plsIndex - feedback mode (FEEDBACK_MODE_OPEN_LOOP or FEEDBACK_MODE_TESTPATTERN)
 */
function testSequence(fbMode,fb_delay_p,  plsIndex_p) {

    // Switching ON the columns
    setDMX_feedbackOnOff([ON, ON, ON, ON]);

    // Setting the feedback FB0 values
	const margin = 1800
    const minVal = -1*Math.pow(2, 13) + margin;
    const midVal = 0;
    const maxVal = Math.pow(2, 13) - (1/Math.pow(2, 2)) - margin;
	
    const tabFb0_0 = [
        minVal, midVal, maxVal, minVal, midVal, maxVal, minVal, midVal, maxVal,
        minVal, midVal, maxVal, minVal, midVal, maxVal, minVal, midVal, maxVal,
        minVal, midVal, maxVal, minVal, midVal, maxVal, minVal, midVal, maxVal,
        minVal, midVal, maxVal, minVal, midVal, maxVal, minVal
    ];
    const tabFb0_1 = [
        maxVal, minVal, minVal, minVal, minVal, minVal, minVal, minVal, minVal,
        minVal, minVal, minVal, minVal, minVal, minVal, minVal, minVal, minVal,
        minVal, minVal, minVal, minVal, minVal, minVal, minVal, minVal, minVal,
        minVal, minVal, minVal, minVal, minVal, minVal, minVal
    ];
    for (var col=0; col<DMX_NB_COL; col++) setDMX_fb0(col, tabFb0_1);

    // Setting the testPattern to 2 rising slopes
    const a = -1*Math.pow(2, 15);
    const b = 0;
    const c = Math.pow(2,8);
    const N = Math.pow(2,8) - 1;
    const sawPattern = [
        [a, b, c, N],  // Slope upward
        [a/2, b, c/2, N],  // Slope upward
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0]  // Nothing
    ];

    const c2 = Math.pow(2,4);
    const N2 = Math.pow(2,12) - 1;
	const rampPattern = [
        [a, b, c2, N2],  // Slope upward
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0]  // Nothing
    ];

    setDMX_testPattern(sawPattern); 
    //setDMX_testPattern(rampPattern); 

    // Selecting the pulse shaping type (0, 1, 2, 3)
    print(TAB1 + "Setting the pulse shapping (PULSE_SHAPING_SELECTION) to " + plsIndex_p);
    for (col=0; col<DMX_NB_COL; col++) setDMX_pulseShapingSelection(col, plsIndex_p);

    // setting the feedback delay (register: MUX_SQ_FB_DELAY)
    print(TAB1 + "Setting the feedback delay (MUX_SQ_FB_DELAY) to " + fb_delay_p);
	for (col=0; col<DMX_NB_COL; col++) setDMX_feedback_delay(col, fb_delay_p);

    if (fbMode === FEEDBACK_MODE_OPEN_LOOP) {
        // Setting the feedback modes to "open loop" for all the pixels
        var tabFbModesOpenLoop = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_OPEN_LOOP);
        for (col=0; col<DMX_NB_COL; col++) setDMX_sqm_FBMode(col, tabFbModesOpenLoop);
    }

    if (fbMode === FEEDBACK_MODE_TESTPATTERN) {
        // Setting the feedback mode to "test pattern" for all the pixels
        var tabFbModesTstPattern = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_TESTPATTERN);
        for (col=0; col<DMX_NB_COL; col++) setDMX_sqm_FBMode(col, tabFbModesTstPattern);

        // Activation of the test pattern indefinitely
        var enable = true;
        var infinitely = true;
        var nbTime = 0x9;
        setDMX_testPatternEnable(enable, infinitely, nbTime);
    }


    // Saving some data
    // You need to loop the feedback to the error input to see the feedback in the TM data
	var answer=getText("Start saving some data?", "");

    // Saving some data in error acquisition mode
    sendToDMXGoToErrorSignalMode();
    const durationMs = 500;
    sendToDMXSaveScienceRaw("feedbackInErrorSignal", durationMs, 0xF, 0);
	waitMs(durationMs + 100);

    // Saving some data in dump acquisition mode
    sendToDMXGoToDumpMode();


	var answer=getText("Type enter to finish the test", "");
}


function startSession(sessionName) {
    // Init CDIF IRAP
    sendToTMTC_SetWireIn(0, 1);
    sendToTMTC_SetWireIn(0, 0);
    sendToTMTC_SetWireIn(0, 2);
    sendStartNewSession(sessionName, "");
}

/**
 * This function is called when the script is aborted
 */
function onAbortScript() {

    // resetting the set of FB0 values
    resetTabFB0 = makeArray(DMX_NB_PIX_PER_COL, 0);
    for (var col=0; col<DMX_NB_COL; col++) setDMX_fb0(col, resetTabFB0);

    // de-activating the test pattern
    setDMX_testPatternEnable(false, false, 0);

	sendToDMXGoToIdleMode();
	print("End of script!");
}

// -------------------------------------------------------------------------------------------------------------

startSession("fdbkTest");

const FEEDBACK_MODE = FEEDBACK_MODE_OPEN_LOOP;
//const FEEDBACK_MODE = FEEDBACK_MODE_TESTPATTERN;

const PLS_INDEX = 0;  // PLS_INDEX in [0; 3]
const FB_DELAY = -3;   // FB_DELAY in [-512, +40]


testSequence(FEEDBACK_MODE, FB_DELAY, PLS_INDEX);

onAbortScript();

// -------------------------------------------------------------------------------------------------------------
