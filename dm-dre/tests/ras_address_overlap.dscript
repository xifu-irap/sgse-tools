// imports
include("../ras/rasTools.dscript");
include("../ras/rasRegAddresses.dscript");
include("../ras/rasSequences.dscript");

include("../common/utilTools.dscript");
include("../common/constants.dscript");


/**
 * Checks the setting of the ps overlap
 */
function ras_ps_overlap() {

    plotLongLine();
    print("* Checking the setting of the ps overlap");
    print(" ");


    var overlap = 0;
    print(TAB1 + "Setting the PS overlap to " + overlap);
	setRAS_seqMode(OFF);
    setRAS_psOverlap(overlap);
	setRAS_seqMode(ON);
    var answer1 = getText("Observe the delay between the falling edge of PS7 and the rising edge of PS0 (set to 0)", " ");

    overlap = -8;
    print(TAB1 + "Setting the PS overlap to " + overlap);
	setRAS_seqMode(OFF);
    setRAS_psOverlap(overlap);
	setRAS_seqMode(ON);
    answer1 = getText("Observe the delay between the falling edge of PS7 and the rising edge of PS0 (set to -8)", " ");

    overlap = 7;
    print(TAB1 + "Setting the PS overlap to " + overlap);
	setRAS_seqMode(OFF);
    setRAS_psOverlap(overlap);
	setRAS_seqMode(ON);
    answer1 = getText("Observe the delay between the falling edge of PS7 and the rising edge of PS0 (set to 7)", " ");

    const step_ms = 600;
    print(" ");
    print(TAB1 + "Scanning the PS overlap");
    answer = getText("Click when ready", " ");
	setRAS_seqMode(OFF);
    RASscan_overlap(true, false, step_ms, true)
	setRAS_seqMode(ON);

    print(" ");

}

/**
 * Checks the setting of the gs overlap
 */
function ras_gs_overlap() {

    plotLongLine();
    print("* Checking the setting of the gs overlap");
    print(" ");


    var overlap = 0;
    print(TAB1 + "Setting the GS overlap to " + overlap);
	setRAS_seqMode(OFF);
    setRAS_gsOverlap(overlap);
	setRAS_seqMode(ON);
    var answer2 = getText("Observe the delay between the falling edge of GS4 and the rising edge of GS0 (set to 0)", " ");

    overlap = -8;
    print(TAB1 + "Setting the GS overlap to " + overlap);
	setRAS_seqMode(OFF);
    setRAS_gsOverlap(overlap);
	setRAS_seqMode(ON);
    var answer2 = getText("Observe the delay between the falling edge of GS4 and the rising edge of GS0 (set to -8)", " ");

    overlap = 7;
    print(TAB1 + "Setting the GS overlap to " + overlap);
	setRAS_seqMode(OFF);
    setRAS_gsOverlap(overlap);
	setRAS_seqMode(ON);
    var answer2 = getText("Observe the delay between the falling edge of GS4 and the rising edge of GS0 (set to 7)", " ");

    const step_ms = 600;
    print(" ");
    print(TAB1 + "Scanning the GS overlap");
    answer = getText("Click when ready", " ");
	setRAS_seqMode(OFF);
    RASscan_overlap(false, true, step_ms, true)
	setRAS_seqMode(ON);

    print(" ");

}

rasInit();
ras_ps_overlap();
ras_gs_overlap();

print("End of script");
/**********************************************************************************************************************/

