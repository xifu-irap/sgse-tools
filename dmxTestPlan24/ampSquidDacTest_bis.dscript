//    email                     laurent.ravera@irap.omp.eu
//    @file                     ampSquidDacTest_bis.dscript
// -------------------------------------------------------------------------------------------------------------
//    @details
//
//    This file tests the Amp SQUID DACs of the DMX boards.
//    It does an infinite sequence over 2 settings on the DAC Offset.
//    This allows to check the DAC's SPI signals along long durations with the oscilloscope or on Xifu Studio
//
// -------------------------------------------------------------------------------------------------------------

// imports
include("../common/utilTools.dscript");
include("../common/constants.dscript");
include("../demux/dmxTools.dscript");
include("../demux/dmxRegAddresses.dscript");

/**
 * This function does an infinite sequence over 2 values with the ofco LSB DAC
 */
function testSequence() {

	const offsetCoarse = OFFSET_COARSE_ADU_MIN;

	const offsetFine = [  // 34 3-bit values
	   0, 7, 7, 7, 7, 7, 7, 7,
	   7, 7, 7, 7, 7, 7, 7, 7,
	   7, 7, 7, 7, 7, 7, 7, 7,
	   7, 7, 7, 7, 7, 7, 7, 7,
	   7, 7
	];


	const offsetMUX_delay = -4;  // to be tunned by test with scripts

	const sampling_delay = 17;

    // Switching ON the columns one by one
    setDMX_safeFeedbackOnOff([ON, ON, ON, ON]);
	
	// Setting the offset mode to OFFSET for all the columns
	setDMX_offsetMode([OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET]);

	// Setting the Offset fine, the offset coarse and the delays
	for (var col = 0; col < DMX_NB_COL; col++) {
		setDMX_sqa_OffsetCoarse(col, offsetCoarse);
		setDMX_sqa_OffsetFine(col, offsetFine, offsetFine);
		setDMX_offsetMUX_delay(col, offsetMUX_delay);
		setDMX_sampling_delay(col, sampling_delay);
	}

	// Activating data acquisition in Error mode
	sendToDMXGoToErrorSignalMode();
	
	// Setting the offset LSB in an infinite sequence
	print("Setting the offset LSB of some pixels to 2 values in an infinite sequence");
	print("Press -Abort- to stop the script");
	while(true) {
		for (col = 0; col < DMX_NB_COL; col++) setDMX_sqa_OffsetLSB(col, Math.pow(2, 12)-1);
		waitMs(1000);

		for (col = 0; col < DMX_NB_COL; col++) setDMX_sqa_OffsetLSB(col, Math.pow(2, 10)-1);
		waitMs(1000);
	}
}

/**
 * This function is called when the script is aborted
 */
function onAbortScript() {
	sendToDMXGoToIdleMode();
	setDMX_safeFeedbackOnOff([OFF, OFF, OFF, OFF]);

	print("End of script!");
}

// -------------------------------------------------------------------------------------------------------------

testSequence();

// -------------------------------------------------------------------------------------------------------------
