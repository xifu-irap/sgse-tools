// -------------------------------------------------------------------------------------------------------------
//    email                     laurent.ravera@irap.omp.eu
//    @file                     scanAmpSquid.dscript
// -------------------------------------------------------------------------------------------------------------
//    @details
//
//    This file is used to characterise the AMP SQUID in the FPAsim + DMX configuration.
//    A scan is done on the Ofco while the feedback is in open loop mode.	   
//
// -------------------------------------------------------------------------------------------------------------

// imports
const includes_path = "../../includes/";
include(includes_path + "common_constants.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "dmxTools.dscript");
include(includes_path + "dmxConfigurations.dscript");
include(includes_path + "dmxStart.dscript");
include(includes_path + "/fpasim/fpasim_includes.dscript");

// -------------------------------------------------------------------------------------------------------------


// Init CDIF
sendToTMTC_SetWireIn(0 , 1);
sendToTMTC_SetWireIn(0 , 0);
sendToTMTC_SetWireIn(0 , 2);

/*
  Starting and initializing the FPAsim
  If the FPAsim function is already enabled nothing is done unless the "force_p" parameter is set to true.
*/
fpasimStartup();

/*
  Configuring the FPAsim
*/
fpasimConfig(raDelayOpt, SteadyMode25Fsr);
//fpasimConfig(raDelayOpt, SteadyMode0);

/*
 Starting and configuring the DEMUX
*/

// Asking for the test pattern shape
var conf = conf_default_fpasim;



const confTptTab = ["FULL SLOW", "MINI OFCO"];
var tptId = getItem("Please, indicates the test pattern: ", confTptTab);
var tpt = confTptTab[tptId];
conf["PATTERN"] = tpt;
conf["AMP_SQ_OFFSET_MODE"] = makeArray(DMX_NB_COL, OFFSET_MODE_TESTPATTERN);
demuxStart(conf);

print(TAB1 + "Starting data acquisition in ERROR mode...");
sendToDMXGoToErrorSignalMode();

start_demux_pattern();

// Saving a scan
print(TAB1 + "Saving scans in Error and Science data acquisition mode");
waitMs(500);
sendSaveNextScans(4, 1<<col, "amp_VPhi_error_");

alert("Stop the test?");


// -------------------------------------------------------------------------------------------------------------
onAbortScript();

function onAbortScript() {
	sendToDMXGoToIdleMode();
	stop_demux_pattern();
	print("End of script!");
}
