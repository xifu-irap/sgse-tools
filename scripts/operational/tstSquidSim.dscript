//    email                     laurent.ravera@irap.omp.eu
//    @file                     tstSquidSim.dscript
// -------------------------------------------------------------------------------------------------------------
//    @details
//
//    This file is used to test the SQUID sim.
//
// -------------------------------------------------------------------------------------------------------------


// imports
include("../../includes/dmxTools.dscript");
include("../../includes/dmxStart.dscript");

include("../../includes/common/utilTools.dscript");
include("../../includes/common/constants.dscript");

function tstSquidSim(col_A_p, fb0_A_p, col_B_p, fb0_B_p) {

    // Switching ON the feedback for all the columns
	print(TAB1+"Switching ON the feedback OnOff for all the columns...");
    setDMX_safeFeedbackOnOff([ON, ON, ON, ON]);

    // DEMUX feedback
	print(TAB1+"Setting the DMX FB0 values for col : " + col_A_p);
	setDMX_fb0(col_A_p, fb0_A_p);

	print(TAB1+"Setting the DMX FB0 values for col : " + col_B_p);
	setDMX_fb0(col_B_p, fb0_B_p);

}

const signal = "squid-sim";
const sessionName = "tst_"+signal;
startSession(sessionName);

const noise_measurement = true;
const col_A = 3;
const col_B = 2;
const delta = 0;

var fb0_A = makeArray(DMX_NB_PIX_PER_COL, 100);
fb0_A[0] += delta;

var fb0_B = makeArray(DMX_NB_PIX_PER_COL, 0);
fb0_B[0] += delta;

// delay
setDMX_feedback_delay(col_A, 0);
setDMX_feedback_delay(col_B, 0);

tstSquidSim(col_A, fb0_A, col_B, fb0_B);

if (noise_measurement) {

	const nbDumpFiles = 128;
	const errorFileDurationInS = 20;
	const errorFilenames="error_noise";

	// Measuring several dump files (will be averaged during data processing)
	print(TAB1+"Measuring " + nbDumpFiles + " dump files...");
	for (var i = 0; i<nbDumpFiles; i++) sendToDMXGoToDumpMode();

	// Measuring error data
	sendToDMXGoToErrorSignalMode();
	print(TAB1+"Measuring error data...");
	sendToDMXSaveScienceRaw(errorFilenames, errorFileDurationInS*1000, 1<<col_A, 0);
	waitMs(errorFileDurationInS*1000);
}

onAbortScript();

function startSession(sessionName) {
    // Init CDIF IRAP
    sendToTMTC_SetWireIn(0, 1);
    sendToTMTC_SetWireIn(0, 0);
    sendToTMTC_SetWireIn(0, 2);
    sendStartNewSession(sessionName, "");
}

function onAbortScript() {
	sendStopSession();
	sendToDMXGoToIdleMode();
	print("End of script!");
}

