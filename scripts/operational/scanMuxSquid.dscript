// -------------------------------------------------------------------------------------------------------------
//    email                     laurent.ravera@irap.omp.eu
//    @file                     scanMuxSquid.dscript
// -------------------------------------------------------------------------------------------------------------
//    @details
//
//    This file is used to characterise the MUX SQUID in the FPAsim + DMX configuration.
//    A scan is done with the feedback signal while the Ofco is in closed loop mode.
//
// -------------------------------------------------------------------------------------------------------------

// imports
const includes_path = "../../includes/";
include(includes_path + "common_constants.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "dmxTools.dscript");
include(includes_path + "dmxConfigurations.dscript");
include(includes_path + "dmxStart.dscript");
include(includes_path + "/fpasim/fpasim_includes.dscript");

// -------------------------------------------------------------------------------------------------------------


/*
 Getting the column under test Id
*/
var col = -1;
while ((col < 0) || (col > DMX_NB_COL-1)) col = getInt("Please, enter the Id of the column under test:");
sessionName = "scanMuxSQUID-col"+col;
sendStartNewSession(sessionName, "");


const durationScanMs = 10000;
const waitDelayMs = 1000;

/*
  Starting and initializing the FPAsim
  If the FPAsim function is already enabled nothing is done unless the "force_p" parameter is set to true.
*/
fpasimStartup();

/*
  Configuring the FPAsim
*/
fpasimConfig(raDelayOpt, SteadyMode25Fsr);
//fpasimConfig(raDelayOpt, SteadyMode90Fsr);

/*
 Starting and configuring the DEMUX
*/
//setDMX_offsetMode(makeArray(DMX_NB_COL, OFFSET_MODE_OFF));
var conf = conf_fpasim_FLL_AMP_SQUID;
// Using non optimal value to show that with FLL OFF the MUX SQUID characteristic is incorrect
conf["AMP_SQ_OFFSET_COARSE"] = [3700, 3700, 3700, 3700]; 
demuxStart(conf);

start_demux_pattern();

/* 
 Characterisation with FLL OFF
*/
setDMX_offsetMode(makeArray(DMX_NB_COL, OFFSET_MODE_OFFSET));

// Saving scans
print(TAB1 + "Saving a scan with FLL OFF in Error acquisition mode");
sendToDMXGoToErrorSignalMode();
sendSaveNextScans(1, 1<<col, "mux_IPhi_FLL-OFF_error_");
waitMs(durationScanMs);

/* 
 Characterisation with FLL ON
*/
setDMX_offsetMode(makeArray(DMX_NB_COL, OFFSET_MODE_CLOSED));

// Saving scans
print(TAB1 + "Saving scans with FLL ON in Error and Science data acquisition mode");

waitMs(waitDelayMs);
sendSaveNextScans(1, 1<<col, "mux_IPhi_FLL-ON_error_");
waitMs(durationScanMs);

sendToDMXGoToScienceMode();
waitMs(waitDelayMs);

sendSaveNextScans(1, 1<<col, "mux_IPhi_FLL-ON_science_");
waitMs(durationScanMs);


print("Processing data ...")
output = copyDirToBackupDirAndExecuteBat(analysis_tools_path,".\\SCRIPTS_ANALYSE\\dmx-dm","do_processing.bat")

alert("Finish the test?");


// -------------------------------------------------------------------------------------------------------------
onAbortScript();

function onAbortScript() {
	stop_demux_pattern();
	sendStopSession();
	
	print(TAB1 + "Setting the OFFSET mode back to OFFSET")
    setDMX_offsetMode(makeArray(DMX_NB_COL, OFFSET_MODE_OFFSET));

	sendToDMXGoToIdleMode();
	print("End of script!");
}



