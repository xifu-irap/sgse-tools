// importsconst includes_path = "../../includes/";include(includes_path + "common_constants.dscript");include(includes_path + "utilTools.dscript");include(includes_path + "dmxTools.dscript");include(includes_path + "dmxConfigurations.dscript");var config = conf_fpasim_FLL_AMP_SQUID;// To reset the AMP SQUID loop filters//print(TAB1+"Setting the offset mode to: " + OFFSET_MODE_OFF);//setDMX_offsetMode(OFFSET_MODE_OFF);const ki = 0.4const a = 0.1// Setting parameters A, knorm and kiknormprint(TAB1+"Setting the feedback parameter A to: " + config["A"]);print(TAB1+"Setting the Amp SQUID FLL ki to: " + ki);print(TAB1+"Setting the Amp SQUID FLL knorm to: " + config["AMP_SQ_KNORM"]);for (col=0; col<DMX_NB_COL; col++) {	setDMX_a(col, makeArray(DMX_NB_PIX_PER_COL, a));	setDMX_sqa_kiknorm(col, ki * config["AMP_SQ_KNORM"][col]);	setDMX_sqa_knorm(col, config["AMP_SQ_KNORM"][col]);}