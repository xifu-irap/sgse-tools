// -------------------------------------------------------------------------------------------------------------
//    email                     laurent.ravera@irap.omp.eu
//    @file                     measurePulses.dscript
// -------------------------------------------------------------------------------------------------------------
//    @details
//
//    This script measures pulses with the FPAsim.
//    It operates the DEMUX in open loop and in closed loop.
//    In open loop data are measured in Error acquisition mode only.
//    In closed loop data are measured both in Error and Science acquisition modes.
//
// -------------------------------------------------------------------------------------------------------------

// imports
const includes_path = "../../includes/";
include(includes_path + "common_constants.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "dmxTools.dscript");
include(includes_path + "dmxConfigurations.dscript");
include(includes_path + "dmxStart.dscript");
include(includes_path + "/fpasim/fpasim_includes.dscript");


const datafileDurationMs = 2000;
const pulseDataDurationMs = 4000;

const pulseHeightPc = 50; // Modulation
//const pulseHeightPcMax = 90;  // to make delocks


function doingPulses(nbIterations_P, pulseHeightPcSingle_P) {

	for (iteration = 0; iteration < nbIterations_P; iteration++) {
		print(TAB2 + "Iteration " + iteration + " / " + nbIterations);
		for (var iPix=0; iPix < DMX_NB_PIX_PER_COL; iPix++) {
				pulseHeight = Math.round(TesSteady * pulseHeightPcSingle_P / 100);
				sendToFPAsim_makePulse(iPix, 0, pulseHeight);
		}
	}
}


// -------------------------------------------------------------------------------------------------------------

/*
 Getting the column under test Id
*/
var colUT = -1;
while ((colUT < 0) || (colUT > DMX_NB_COL-1)) colUT = getInt("Please, enter the Id of the column under test:");
sessionName = "MEASURE_PULSES-col"+colUT;
sendStartNewSession(sessionName, "");

/*
  Starting and initializing the FPAsim
*/
fpasimStartup(); // If the FPAsim is already enabled nothing is done unless the "force_p" parameter is set to true.
//fpasimConfig(raDelayOpt, SteadyMode90Fsr);

const TesSteady = fpasimConfig(raDelayOpt, SteadyMode25Fsr);


/*
 Starting and configuring the DEMUX
*/
demuxStart(conf_default_fpasim);


/*-------------------------
Operation in open loop
*/
fbMode = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_OPEN_LOOP);
setDMX_sqm_FBMode(colUT, fbMode);

// Doing pulses
var nbIterations = 5;

// Starting a data acquisition of error data
sendToDMXGoToErrorSignalMode();
waitMs(500);
sendToDMXSaveScienceRaw("pulses_FLL_OFF_error", pulseDataDurationMs , 1<<colUT, 0);
doingPulses(nbIterations, pulseHeightPc);


/*-------------------------
Operation in close loop
*/
fbMode = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_CLOSED_LOOP);
setDMX_sqm_FBMode(colUT, fbMode);

print(TAB1 + "Delock counters at the beggining: " + readDMX_delockCounters(colUT, false));

// Doing pulses

// Starting a data acquisition of error data
sendToDMXGoToErrorSignalMode();
waitMs(500);
sendToDMXSaveScienceRaw("pulses_FLL_ON_error", pulseDataDurationMs , 1<<colUT, 0);
doingPulses(nbIterations, pulseHeightPc);

// Starting a data acquisition of science data
sendToDMXGoToScienceMode();
waitMs(500);
sendToDMXSaveScienceRaw("pulses_FLL_ON_science", pulseDataDurationMs , 1<<colUT, 0);
doingPulses(nbIterations, pulseHeightPc);


print(TAB1 + "Delock counters at the end: " + readDMX_delockCounters(colUT, false));


print("Processing data ...")
output = copyDirToBackupDirAndExecuteBat(analysis_tools_path,".\\SCRIPTS_ANALYSE\\dmx-dm","do_processing.bat")


// -------------------------------------------------------------------------------------------------------------
onAbortScript();

function onAbortScript() {
	sendStopSession();
	sendToDMXGoToIdleMode();
	print("End of script!");
}



