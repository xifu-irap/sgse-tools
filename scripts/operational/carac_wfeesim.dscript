// imports
const includes_path = "../../includes/";
include(includes_path + "wfeeTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");

// -------------------------------------------------------------------------------------------------------------

/**
 * This function tests the functionalities of the WFEEsim
 * @param {boolean} verbose - If true, the commands are printed. Default is false.
 */
function caracWFEEsim(verbose) {

    const valDacMin = 0;
    const valDacMax = 255;  // 255 is a reserved value for some DAC (--> heater command)
    const nramps = 100;
    const nsteps = 128;
    const stepDurationMs = 4;

    // Selecting the asic
    const asicTab = [asic1.name, asic2.name, asic3.name, asic4.name];
    const asicDictTab = [asic1, asic2, asic3, asic4];
    testAsic = getItem("Please, select the ASIC: ", asicTab);
    const asic = asicDictTab[testAsic];

    // Selecting the column
    const colTab = [col0.name, col1.name];
	const colDictTab = [col0, col1];
	testCol = getItem("Please, select the column: ", colTab);
    const col = colDictTab[testCol];

    // Selecting the DAC
    const dacTab = [i_tes_bias.name, i_sqm_bias.name, i_sqm_fdbk.name, i_sqa_bias.name, i_sqa_ofcm.name];
    const dacDictTab = [i_tes_bias, i_sqm_bias, i_sqm_fdbk, i_sqa_bias, i_sqa_ofcm];
    testDac = getItem("Please, select the DAC: ", dacTab);
    const dac = dacDictTab[testDac];

    // Selecting the type of signal
    const signalTab = ["constant", "ramp"];
    testSignal = getItem("Please, select the kind of signal: ", signalTab);
    const signal = signalTab[testSignal];

    if (signal === "constant") {
        // Selecting the constant value
		var value=-1;
        while (value < valDacMin || value > valDacMax) value = getInt("Wich value in ADU? [0; 255]");
    }

    // Avoiding or using the 255 code? (heater)
	aduMax = "No";
	if (signal === "ramp") {
        // Asking if the 255 ADU shall be used
		const aduMaxTab = ["No", "Yes"];
		aduMax = getItem("Do you want to apply the 255 setting?: ", aduMaxTab);
    }


    // Printing a summary of the test configuration
    print("");
    plotSmallLine();
	if (signal === "constant") print(TAB1 + "Sending " + value + " ADU on DAC \"" + dac.name + "\" of " + asic.name + " and " + col.name);
	else print(TAB1 + "Sending a FSR ramp on DAC \"" + dac.name + "\" of " + asic.name + " and " + col.name);
	if (signal === "ramp" && aduMax === 1) print(TAB1 + "The setting 255 will be used");
    plotSmallLine();


    if (signal === "ramp") {
        for (iramp=0; iramp<nramps; iramp++) {

			// Doing the scan except the max value (255 ADU)
            WFEEScan(asic, col, dac, valDacMin, valDacMax-1, nsteps, stepDurationMs, verbose);

            // Using the max value (255 ADU) if requested
			if (aduMax === 1) {
				setWFEEDAC(asic, col, dac, valDacMax, verbose);
				waitMs(500);
			}
        }
    }

    if (signal === "constant") {
        setWFEEDAC(asic, col, dac, value, verbose);

		// relecture du paramËtre
        const possible_answers = ["Yes", "No"];
		const answer_id = getItem("Read the parameter back from the ASIC?: ", possible_answers);
        const answer = possible_answers[answer_id];
        if (answer === "Yes") {
            address = WFEEBuildAddress(asic, col, dac);
            print(Tab2 + "Returned parameter is:" + sendToAthenapic_WFEE_readRegister(address));
        }
    }
}

caracWFEEsim(false);
