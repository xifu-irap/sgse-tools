// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");

/**
 * 
 */
function carac_ofco_fll_filter() {
	
	//const test_pattern = "saw";
	const test_pattern = "square";
	
	//const offset_mode = "OFF";
	const offset_mode = "CLOSED";
	
	print(TAB1 + "Setting the test pattern");
	const a1 = -1 * Math.pow(2, 15);
	const a2 = +1 * Math.pow(2, 15)-1;
	const b = 1;
	const c = 0;
	const N = 1023;
	const stepPattern = [
		[a1, b, c, N],  // Step down
		[a2, b, c, N],  // Step up
		[0, 0, 0, 0],  // Nothing
		[0, 0, 0, 0],  // Nothing
		[0, 0, 0, 0]  // Nothing
	];

	const a1 = -1 * Math.pow(2, 14)-1024*4*3.8;
	const b = 60;
	//const c = 128;
	const c = 64;
	const margin = 50;
	const N = 511;
	const a2 = a1 + (c*N);
	const sawPattern = [
		//[a1, 1, 0, 2047],  // Nothing
		[a1, b, c, N],  // Slope upward
		[a2, b, -c, N],  // Slope downward
		[0, 0, 0, 0],  // Nothing
		[0, 0, 0, 0],  // Nothing
		[0, 0, 0, 0]  // Nothing
	];

    print(TAB1 + "Switching ON the columns");
    setDMX_safeFeedbackOnOff([ON, ON, ON, ON]);

	// Setting the test pattern in the FPGA registers
	if (test_pattern == "square") setDMX_testPattern(stepPattern);
	else setDMX_testPattern(sawPattern);

	print(TAB1 + "Configuring the Feedback in test pattern");
	var tabFbModesTstPattern = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_TESTPATTERN);
	for (col=0; col<DMX_NB_COL; col++) setDMX_sqm_FBMode(col, tabFbModesTstPattern);

	setDMX_offsetMode([OFFSET_MODE_OFF, OFFSET_MODE_OFF, OFFSET_MODE_OFF, OFFSET_MODE_OFF]);
	if (offset_mode == "CLOSED") {
		print(TAB1 + "Configuring the Offset in Closed loop mode");	
		setDMX_offsetMode([OFFSET_MODE_CLOSED, OFFSET_MODE_CLOSED, OFFSET_MODE_CLOSED, OFFSET_MODE_CLOSED]);
	}

	print(TAB1 + "Configuring the Offset Fine");
	for (var col = 0; col < DMX_NB_COL; col++) {
		setDMX_sqa_OffsetCoarse(col, OFFSET_COARSE_ADU_MIN);
		setDMX_sqa_OffsetLSB(col, OFFSET_LSB_ADU_MIN);
		setDMX_sqa_OffsetFine(col, 0, 0);
	}


	print(TAB1 + "Switching On the pattern");
	var enable = true;
	var infinitely = true;
	var nbTime = 0x9;
	setDMX_testPatternEnable(enable, infinitely, nbTime);

	// Activating the data acquisition in Error mode
	sendToDMXGoToErrorSignalMode();

	// Reading a scan
	colMask = 4;
	sendSaveNextScans(4, colMask, "ofco_response_");
	
	alert("Finish the test?");

}


function startSession(sessionName) {
	sendStartNewSession(sessionName, "");
}


/**
 * This function is called when the script is aborted
 */
function onAbortScript() {

    // de-activating the test pattern
    setDMX_testPatternEnable(false, false, 0);

	sendToDMXGoToIdleMode();
	print("End of script!");
}

// -------------------------------------------------------------------------------------------------------------

startSession("ofcoFilterTest");

carac_ofco_fll_filter();

// -------------------------------------------------------------------------------------------------------------

onAbortScript();
