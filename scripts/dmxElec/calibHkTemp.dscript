// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");


/**
 * This function drives the test
 */
function calibHkTemp() {

    duration_per_step_in_min = 15;

    plotSmallLine();
	print("/ Temperature HK calibration");
	plotSmallLine();
	print("");

    alert("Please check that HK are measured at 1Hz. Click when OK.");

    // First measurement just after switch on and with columns off
    waitMs(duration_per_step_in_min*60000);

    // Second measurement with columns on
	setDMX_safeFeedbackOnOff(all_on);
    waitMs(duration_per_step_in_min*60000);

    // Third measurement with columns off
	setDMX_safeFeedbackOnOff(all_off);
    waitMs(duration_per_step_in_min*60000);

    print("Processing data ...")
    output = copyDirToBackupDirAndExecuteBat(analysis_tools_path, ".\\SCRIPTS_ANALYSE\\dmx-dm", "do_processing.bat")

}


/**
 * This function is called when the script is aborted
 */
function onAbortScript() {
	print("End of script!");
	sendStopSession();
}

// -------------------------------------------------------------------------------------------------------------

sendStartNewSession("CALIB-HK-TEMP--", "");

calibHkTemp();

onAbortScript();

// -------------------------------------------------------------------------------------------------------------
