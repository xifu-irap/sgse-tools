// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");

// -------------------------------------------------------------------------------------------------------------

// Setting the acquisition mode to IDLE (ADC should be OFF).
setDMX_dataAcqMode(ACQ_MODE_IDLE);

alert("OK to switch ON the error ADCs all at once?");
setDMX_dataAcqMode(ACQ_MODE_ERROR);

alert("OK to switch OFF the error ADCs all at once?");
setDMX_dataAcqMode(ACQ_MODE_IDLE);

