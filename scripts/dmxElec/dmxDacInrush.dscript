// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");

// -------------------------------------------------------------------------------------------------------------

print("Current status:" + readDMX_feedbackOnOff());

alert("OK to switch ON the feedback DACs in sequence?");
setDMX_safeFeedbackOnOff([ON, ON, ON, ON]);

alert("OK to switch OFF the feedback DACs in sequence?");
setDMX_safeFeedbackOnOff([OFF, OFF, OFF, OFF]);

alert("OK to switch ON the feedback DACs all at once?");
setDMX_feedbackOnOff([ON, ON, ON, ON]);

alert("OK to switch OFF the feedback DACs all at once?");
setDMX_feedbackOnOff([OFF, OFF, OFF, OFF]);

