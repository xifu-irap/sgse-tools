// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");

/**
 * This function outputs a set of values or the test pattern on the offset compensation output
 */
function testSequence() {

    // Switching ON the columns
    setDMX_safeFeedbackOnOff(all_on);

	const AMP_SQ_OFFSET_FINE_RAMP =
		[  // 34 3-bit values
			0, 1, 2, 3, 4, 5, 6, 7,
			0, 1, 2, 3, 4, 5, 6, 7,
			7, 6, 5, 4, 3, 2, 1, 0,
			7, 6, 5, 4, 3, 2, 1, 0,
			0, 0
		];

	for (var col = 0; col < DMX_NB_COL; col++) {
		setDMX_sqa_OffsetCoarse(col, OFFSET_COARSE_ADU_MIN);
		setDMX_sqa_OffsetLSB(col, OFFSET_LSB_ADU_MAX);
		setDMX_sqa_OffsetFine(col, AMP_SQ_OFFSET_FINE_RAMP, AMP_SQ_OFFSET_FINE_RAMP);
	}

	// Setting the offset mode to OFFSET for all the columns
	colOffsetMode = [OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET];
	setDMX_offsetMode(colOffsetMode);

	alert("Finish the test?");

}


/**
 * This function is called to start a new session
 */
function startSession(sessionName) {
	sendStartNewSession(sessionName, "");
}


/**
 * This function is called when the script is aborted
 */
function onAbortScript() {

    // Switching OFF the columns
    setDMX_safeFeedbackOnOff(all_off);

    // resetting the set of Offset values
    const zeroArray = makeArray(DMX_NB_PIX_PER_COL, 0);
    for (var col = 0; col < DMX_NB_COL; col++) {
        setDMX_sqa_OffsetLSB(col, OFFSET_LSB_ADU_MIN);
        setDMX_sqa_OffsetCoarse(col, OFFSET_COARSE_ADU_MIN);
		setDMX_sqa_OffsetFine(col, zeroArray, zeroArray);
    }

	sendToDMXGoToIdleMode();
	print("End of script!");
}

// -------------------------------------------------------------------------------------------------------------

startSession("ELEC-OFCO-MUX--");

testSequence();

onAbortScript();

// -------------------------------------------------------------------------------------------------------------
