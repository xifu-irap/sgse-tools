//    @details
//
//    This file tests the SPI links to the slow DACs of the ofco.
//
// -------------------------------------------------------------------------------------------------------------

// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");

/**
 * This function sends commands to the slow DACs of the ofco
 */
function testSequence() {

    // Switching ON the columns
    setDMX_safeFeedbackOnOff([ON, ON, ON, ON]);

	setDMX_offsetMode([OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET]);

	alert("OK to send SPI commands indefinitely?");
	while(true){  // Changing values is mandatory. When sending the same value the FPGA does nothing
		for(colid=0; colid<DMX_NB_COL; colid++) {
			setDMX_sqa_OffsetCoarse(colid, OFFSET_COARSE_ADU_MIN);
			setDMX_sqa_OffsetCoarse(colid, OFFSET_COARSE_ADU_MAX);
			setDMX_sqa_OffsetLSB(colid, OFFSET_LSB_ADU_MIN);
			setDMX_sqa_OffsetLSB(colid, OFFSET_LSB_ADU_MAX);
		}
	}
}


/**
 * This function is called to start a new session
 */
function startSession(sessionName) {
	sendStartNewSession(sessionName, "");
}


/**
 * This function is called when the script is aborted
 */
function onAbortScript() {

	sendToDMXGoToIdleMode();
	print("End of script!");
}

// -------------------------------------------------------------------------------------------------------------

startSession("ELEC-OFCO-SPI--");

testSequence();

onAbortScript();

// -------------------------------------------------------------------------------------------------------------
