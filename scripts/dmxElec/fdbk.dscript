// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");

/**
 * This function activates the Mux SQUID and outputs the FB0 set
 */
function run_fdbk_open_loop() {
	
    // Pulse shaping
    print(TAB1+"Disabling the pulse shaping...");
    const pulseShapingType = 0;

    // Feedback mode
    print(TAB1+"Setting the feedback mode to open-loop for all the pixels");
    const tabFbModesOpenLoop = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_OPEN_LOOP);

    // Fb0
    const tabFb0 = [
        minVal, midVal, maxVal, minVal, midVal, maxVal, minVal, midVal, maxVal,
        minVal, midVal, maxVal, minVal, midVal, maxVal, minVal, midVal, maxVal,
        minVal, midVal, maxVal, minVal, midVal, maxVal, minVal, midVal, maxVal,
        minVal, midVal, maxVal, minVal, midVal, maxVal, minVal
    ];
    print(TAB1+"Setting the FB0 to:");
    print(tabFb0);

    // Sending the parameters
    for (colId=0; colId<DMX_NB_COL; colId+=1) {
        setDMX_sqm_FBMode(colId, tabFbModesOpenLoop);
        setDMX_fb0(colId, tabFb0);
        setDMX_pulseShapingSelection(colId, pulseShapingType);
    }

    // Switching ON the columns
    print(TAB1+"Switching ON the feedback for all the columns: ");
    setDMX_safeFeedbackOnOff([ON, ON, ON, ON]);

	alert("Finish the test?");
}


/**
 * This function is called when the script is aborted
 */
function onAbortScript() {

	print("End of script!");
}


// -------------------------------------------------------------------------------------------------------------

sendStartNewSession("ELEC-FDBK-OL---", "");

run_fdbk_open_loop();

onAbortScript();

// -------------------------------------------------------------------------------------------------------------
