//    @details
//
//    This file tests the Mux SQUID DACs of the DMX boards.
//
// -------------------------------------------------------------------------------------------------------------

// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");

/**
 * This function allows to start the 4 feedback DACs simultaneously or in sequence and to stop them in sequence
 */
function testSequence() {

    // Defining a testPattern to 2 rising slopes
    var a = -1*Math.pow(2, 15);
    var b = 0;
    var c = Math.pow(2,8);
    var N = Math.pow(2,8) - 1;
    const sawPattern = [
        [a, b, c, N],  // Slope upward
        [a/2, b, c/2, N],  // Slope upward
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0]  // Nothing
    ];

    // Configuring the DEMUX feedback in test pattern mode
    var tabFbModesTstPattern = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_TESTPATTERN);
    for (col=0; col<DMX_NB_COL; col++) setDMX_sqm_FBMode(col, tabFbModesTstPattern);

    setDMX_testPattern(sawPattern);

    // Activation of the test pattern indefinitely
    var enable = true;
    var infinitely = true;
    var nbTime = 0x9;
    setDMX_testPatternEnable(enable, infinitely, nbTime);

    while (true) {
        // Asking for the start mode
        const methodTab = ["All at once", "One after the other", "Stop the test"];
        var iMethod = getItem("Please, indicates the feedback DAC start method: ", methodTab);
        var method = methodTab[iMethod];

        // Switching ON the columns
        if (method === "All at once") setDMX_feedbackOnOff([ON, ON, ON, ON]);
        else if (method === "One after the other") setDMX_safeFeedbackOnOff([ON, ON, ON, ON]);
        else return;
        print("Columns have been switched ON");

        // Asking to stop the DACs
        alert("Stop the feedback DACs one after the other?");
        setDMX_safeFeedbackOnOff([OFF, OFF, OFF, OFF]);
    }
}


/**
 * This function is called when the script is aborted
 */
function onAbortScript() {

    // de-activating the test pattern
    setDMX_testPatternEnable(false, false, 0);

    // de-activating data acquisition
    sendToDMXGoToIdleMode();

    // Switching OFF the columns
    setDMX_safeFeedbackOnOff([OFF, OFF, OFF, OFF]);

	print("End of script!");
}

// -------------------------------------------------------------------------------------------------------------

testSequence();

onAbortScript();

// -------------------------------------------------------------------------------------------------------------
