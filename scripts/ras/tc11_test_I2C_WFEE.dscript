// imports
const includes_path = "../../includes/";

include(includes_path + "rasTools.dscript");
include(includes_path + "rasRegAddresses.dscript");
include(includes_path + "rasSequences.dscript");
include(includes_path + "wfeeTools.dscript");

include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");


/**
 * This function tests the I2C interface between DRE-RAS and WFEE
 */
function tst_I2C() {
	// address and parameter used in some of the tests
	const addr = WFEEBuildAddress(asic0, col0, i_tes_bias);
	const param = 0x55;  // 01010101 in binary

	// Asking for the test type
	const confTestTab = [
		"Write in WFEE register",
		"Read WFEE register",
		"Repeat write in WFEE register",
		"Write and read in WFEE register",
		"Repeat write and read in WFEE register"
	];
	var iConfTest = getItem("Please, select the test: ", confTestTab);
	const test_mode = confTestTab[iConfTest];

	if (test_mode === "Repeat write in WFEE register") {
		print(TAB1 + "Sending always the same write command:");
		print(TAB2 + "Address = " + addr.toString(16).toUpperCase());
		print(TAB2 + "Parameter = " + param.toString(16).toUpperCase());
		print(TAB1 + "Abort the script to stop...");
		while(true) sendToWFEEWriteRegister(addr, param);
	}

	if (test_mode === "Write in WFEE register") {
		print(TAB1 + "Sending a write command:");
		print(TAB2 + "Address = " + addr.toString(16).toUpperCase());
		print(TAB2 + "Parameter = " + param.toString(16).toUpperCase());
		sendToWFEEWriteRegister(addr, param);
	}

	if (test_mode === "Read WFEE register") {
		print(TAB1 + "Sending a read command:");
		print(TAB2 + "Address = " + addr.toString(16).toUpperCase());
		sendToWFEEReadRegister(addr);
	}

	if (test_mode === "Write and read in WFEE register") {
		print(TAB1 + "Sending a write command:");
		print(TAB2 + "Address = " + addr.toString(16).toUpperCase());
		print(TAB2 + "Parameter = " + param.toString(16).toUpperCase());
		sendToWFEEWriteRegister(addr, param);
		print(TAB1 + "Sending a read command to the same address");
		var checked_param = sendToWFEEReadRegister(addr);
		print(TAB2 + "The returned parameter value is " + checked_param.toString(16).toUpperCase());
	}

	if (test_mode === "Repeat write and read in WFEE register") {

		error_counter = 0;

		const add_function_shift = 3;
		const nb_iterations = 10000;
		for (var iteration=0; iteration<nb_iterations; iteration++){
			print("Iteration " + iteration);
			for (col_id=0; col_id<2; col_id++){
				print(TAB1 + "Testing column " + col_id);
				col_add=col_id*4;
				for (asic_add=1; asic_add<5; asic_add++) {
					print(TAB2 + "Testing ASIC " + asic_add);

					dac_id = i_tes_bias;
					print(TAB3 + "Write / Read on " + dac_id.name);
				    add_function = dac_id.address | col_add;
				    add = (asic_add + (add_function << add_function_shift));
					sendToWFEEWriteRegister(add, param);
					checked_param = sendToWFEEReadRegister(add);
					if (checked_param !== param) error_counter++;
					print(TAB3 + "   ---> " + error_counter + " errors in total");

					dac_id = i_sqm_bias;
					print(TAB3 + "Write / Read on " + dac_id.name);
				    add_function = dac_id.address | col_add;
				    add = (asic_add + (add_function << add_function_shift));
					sendToWFEEWriteRegister(add, param);
					checked_param = sendToWFEEReadRegister(add);
					if (checked_param !== param) error_counter++;
					print(TAB3 + "   ---> " + error_counter + " errors in total");

					dac_id = i_sqm_fdbk;
					print(TAB3 + "Write / Read on " + dac_id.name);
				    add_function = dac_id.address | col_add;
				    add = (asic_add + (add_function << add_function_shift));
					sendToWFEEWriteRegister(add, param);
					checked_param = sendToWFEEReadRegister(add);
					if (checked_param !== param) error_counter++;
					print(TAB3 + "   ---> " + error_counter + " errors in total");

					dac_id = i_sqa_bias;
					print(TAB3 + "Write / Read on " + dac_id.name);
				    add_function = dac_id.address | col_add;
				    add = (asic_add + (add_function << add_function_shift));
					sendToWFEEWriteRegister(add, param);
					checked_param = sendToWFEEReadRegister(add);
					if (checked_param !== param) error_counter++;
					print(TAB3 + "   ---> " + error_counter + " errors in total");

					dac_id = i_sqa_ofcm;
					print(TAB3 + "Write / Read on " + dac_id.name);
				    add_function = dac_id.address | col_add;
				    add = (asic_add + (add_function << add_function_shift));
					sendToWFEEWriteRegister(add, param);
					checked_param = sendToWFEEReadRegister(add);
					if (checked_param !== param) error_counter++;
					print(TAB3 + "   ---> " + error_counter + " errors in total");

				}
			}
		}
	}
}

// -------------------------------------------------------------------------------------------------------------

tst_I2C();

// -------------------------------------------------------------------------------------------------------------
