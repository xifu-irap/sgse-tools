// Feedback mode (FB0)
// setDMX_sqm_FBMode(0, [...]);  -> MUX_SQ_FB_MODE (0x0300..0x0321), 34 pixels = 0
sendToDMXWriteRegister(0x0300, 0);
sendToDMXWriteRegister(0x0301, 0);
