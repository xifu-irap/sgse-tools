// Offset mode (OFFSET_MODE_TESTPATTERN)
// setDMX_offsetMode([3, 3, 3, 3]);  -> AMP_SQ_OFFSET_MODE (0x4002) = 0x3333
sendToDMXWriteRegister(0x4002, 0x3333);


// -------------------------------------------------------------------------------------------------------------

// Starting data acquisition in ACQ_MODE_ERROR (2)
// setDMX_dataAcqMode(ACQ_MODE_ERROR);  -> DATA_ACQ_MODE (0x4000) = 2
sendToDMXWriteRegister(0x4000, 2);

// start_demux_pattern(); // sets TEST_PATTERN_ENABLE: enable=1, infinite=0, nbTime=0x9 -> value 0x29
sendToDMXWriteRegister(0x4150, 0x29);

// Saving scans
// ---->>>  EP shall save the data
	
// Setting ACQ_MODE_ERROR to IDLE (0)
// setDMX_dataAcqMode(ACQ_MODE_IDLE);  -> DATA_ACQ_MODE (0x4000) = 0
sendToDMXWriteRegister(0x4000, 0);

// Switching the feedback off in sequence
sendToDMXWriteRegister(0x4001, 0x1110); // col0 off -> 0x1110
sendToDMXWriteRegister(0x4001, 0x1100); // col0, col1 off -> 0x1100
sendToDMXWriteRegister(0x4001, 0x1000); // col0, col1, col2 off -> 0x1000
sendToDMXWriteRegister(0x4001, 0x0000); // col0, col1, col2, col3 off -> 0x0000

