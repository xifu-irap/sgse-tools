//    @file                     scan_amp_squid_llc.dscript
// -------------------------------------------------------------------------------------------------------------
//    @details
//
//    This file is used to characterise the AMP SQUID in the FPAsim + DMX configuration.
//    A scan is done on the Ofco while the feedback is in open loop mode.	   
//
// -------------------------------------------------------------------------------------------------------------


// -------------------------------------------------------------------------------------------------------------
/*
  Starting and initializing the FPAsim
  If the FPAsim function is already enabled nothing is done unless the "force_p" parameter is set to true.

-------> Done by DEMUX EGSE
*/
// fpasimStartup();  
// fpasimConfig(raDelayOpt, SteadyMode25Fsr);


// -------------------------------------------------------------------------------------------------------------
/*
 Starting and configuring the DEMUX

-------> Done by EP
*/

// Switching the feedback on in sequence
sendToDMXWriteRegister(0x4001, 0x1000); // col3 on -> 0x1000
sendToDMXWriteRegister(0x4001, 0x1100); // col3, col2 on -> 0x1100
sendToDMXWriteRegister(0x4001, 0x1110); // col3, col2, col1 on -> 0x1110
sendToDMXWriteRegister(0x4001, 0x1111); // col3, col2, col1, col0 on -> 0x1111

// Definition of a slow test pattern on FSR
// setDMX_testPattern(slowSawPattern);  -> TEST_PATTERN (0x4100..0x4113), 5 regions x 4 params
// Region 0: [a3=-32768, b3=7, c3=2, N3=32767]
sendToDMXWriteRegister(0x4100, -32768);
sendToDMXWriteRegister(0x4101, 7);
sendToDMXWriteRegister(0x4102, 2);
sendToDMXWriteRegister(0x4103, 32767);
// Region 1: [aa3=32767, b3=7, -c3=-2, N3=32767]
sendToDMXWriteRegister(0x4104, 32767);
sendToDMXWriteRegister(0x4105, 7);
sendToDMXWriteRegister(0x4106, -2);
sendToDMXWriteRegister(0x4107, 32767);
// Regions 2 to 4: [0, 0, 0, 0]
sendToDMXWriteRegister(0x4108, 0);
sendToDMXWriteRegister(0x4109, 0);
sendToDMXWriteRegister(0x410A, 0);
sendToDMXWriteRegister(0x410B, 0);
// Des qu'une région du pattern à N=0, le pattern se termine
//sendToDMXWriteRegister(0x410C, 0);
//sendToDMXWriteRegister(0x410D, 0);
//sendToDMXWriteRegister(0x410E, 0);
//sendToDMXWriteRegister(0x410F, 0);
//sendToDMXWriteRegister(0x4110, 0);
//sendToDMXWriteRegister(0x4111, 0);
//sendToDMXWriteRegister(0x4112, 0);
//sendToDMXWriteRegister(0x4113, 0);

// set the register: SAMPLING_DELAY (0x0504 + col<<12) = 16
// 16 is the optimal value
sendToDMXWriteRegister(0x0504, 16);
sendToDMXWriteRegister(0x1504, 16);
sendToDMXWriteRegister(0x2504, 16);
sendToDMXWriteRegister(0x3504, 16);

// No need to set the register MUX_SQ_FB_DELAY because feedback is constant in this test

// No need to set the register AMP_SQ_OFFSET_MUX_DELAY because the offset fine is constant in this test

// Setting DEMUX offset LSB to 10: AMP_SQ_OFFSET_LSB (0x0440 + col<<12)
sendToDMXWriteRegister(0x0440, 10);
sendToDMXWriteRegister(0x1440, 10);
sendToDMXWriteRegister(0x2440, 10);
sendToDMXWriteRegister(0x3440, 10);
// Setting DEMUX offset LSB PTR to 10: AMP_SQ_OFFSET_LSB_PTR (0x0439 + col<<12)
sendToDMXWriteRegister(0x0439, 10);
sendToDMXWriteRegister(0x1439, 10);
sendToDMXWriteRegister(0x2439, 10);
sendToDMXWriteRegister(0x3439, 10);
// Setting DEMUX offset COARSE to 705: AMP_SQ_OFFSET_COARSE (0x0441 + col<<12)
// 705 is the operating point for the FPAsim
sendToDMXWriteRegister(0x0441, 705);
sendToDMXWriteRegister(0x1441, 705);
sendToDMXWriteRegister(0x2441, 705);
sendToDMXWriteRegister(0x3441, 705);
// Using Offset fine default values (0)

// DEMUX feedback
// setDMX_fb0(0, [...]);  -> MUX_SQ_FB0 (0x0200 + col<<12), 34 pixels, S(16,2): 92*4 = 368
