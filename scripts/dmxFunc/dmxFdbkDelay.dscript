// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");

/**
 * Configuring the test setup
 *  Sets all the DMX fb0 to the same value except for pixel 0 (in open loop mode)
 *  Sets all the DMX offset to the same value (in open loop mode)
 *  Does a DMX dump
 */
function configure_test() {

    print("");
    print("* Configuring setup");

    // Switching off the Offset
    setDMX_offsetMode([OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET]);
    for(colid=0; colid<DMX_NB_COL; colid++) {
        setDMX_sqa_OffsetCoarse(colid, OFFSET_COARSE_ADU_MIN);
        setDMX_sqa_OffsetLSB(colid, OFFSET_LSB_ADU_MIN);
        setDMX_sqa_OffsetFine(colid, makeArray(DMX_NB_PIX_PER_COL, 0), makeArray(DMX_NB_PIX_PER_COL, 0));
    }

    // Setting the pulse shaping set to 0 (no pulse shaping)
	print(TAB1+"Setting the pulse shaping set to - No pulse shaping -:");
	const pulseShapingSet = 0;
	for (var col=0; col<DMX_NB_COL; col++)	setDMX_pulseShapingSelection(col, pulseShapingSet);

    // Switching ON the feedback for all the columns
	print(TAB1+"Switching the feedback ON for all the columns:");
    setDMX_safeFeedbackOnOff([ON, ON, ON, ON]);

    // DEMUX feedback
    const val_min = - Math.pow(2, DMX_NB_BITS_DAC_FDBK-1);
    const val_max = Math.pow(2, DMX_NB_BITS_DAC_FDBK-1)-1;
    var fb = makeArray(DMX_NB_PIX_PER_COL, val_min);
    fb[0] = val_max;

	print(TAB1+"Setting the DMX feedback mode to OPEN_LOOP (FB0 -> FEEDBACK output)...");
	print(TAB1+"Setting the FB0 to: ");
    print(TAB2 + fb);
	for (col=0; col<DMX_NB_COL; col++) {
		setDMX_fb0(col, fb);
		setDMX_sqm_FBMode(col, makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_OPEN_LOOP));
	}
	print("");
}

/**
 * Sets the FB_DELAY to a value and does a dump file.
 *  Sets the FB_DELAY to the value provided by the parameter fb_delay_p
 *  Does a DMX dump
 * @param {number} fb_delay_p - feedback delay s(16,0) [-512, 40].
 */
function measure_FB_DELAY(fb_delay_p) {

    print("");
    print("* Setting the FB_DELAY to " + fb_delay_p + " and doing a Dump");

    // set the register: MUX_SQ_FB_DELAY
	for (col=0; col<DMX_NB_COL; col++) setDMX_feedback_delay(col, fb_delay_p);

    // Data acquisition
	sendToDMXGoToDumpMode();
}


/**
 * This function is called when the script is aborted
 */
function onAbortScript() {
    sendToDMXGoToIdleMode();
	print("End of script!");
	sendStopSession();
}


/**
 * This function drives the test
 */
function carac_feedback_delay() {

    plotSmallLine();
	print("/ Feedback delay measurement");
	plotSmallLine();
	print("");

    // Definition of the feedback delay scan limits
    const delay_min = -512;
    const delay_max = 40;
    const start = delay_min;
    const end = delay_max;

    const sessionName = "FDBK-DELAY-----" + toStringWithNoSigns(start,'') + "_" + toStringWithNoSigns(end,'');
    sendStartNewSession(sessionName, "");

    // DEMUX configuration
    configure_test();

    // Doing a scan on the feedback delay
    for (var i = start; i < end + 1; i++) measure_FB_DELAY(i);

    print("Processing data ...")

    output = copyDirToBackupDirAndExecuteBat(analysis_tools_path, ".\\SCRIPTS_ANALYSE\\dmx-dm", "do_processing.bat")
}

// -------------------------------------------------------------------------------------------------------------

carac_feedback_delay();

onAbortScript();

// -------------------------------------------------------------------------------------------------------------
