// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");


/**
 * Configuring the test setup
 *  Sets all the DMX fb0 to the same value except for pixel 0 (in open loop mode)
 *  Sets all the DMX offset to the same value (in open loop mode)
 *  Does a DMX dump
 * @param {number} fb0_p - Feedback at MUX SQUID operating point s(16,2).
 */
function configure_test(fb0_p) {

    print("");
    print("***");
    print("* Configuring setup");
    print("***");

    // Setting the pulse shaping set
	const pulseShapingSet_min = 0;
	const pulseShapingSet_max = 3;
	var pulseShapingSet = pulseShapingSet_min - 1;
	while (pulseShapingSet < pulseShapingSet_min || pulseShapingSet > pulseShapingSet_max) {
		pulseShapingSet = getInt("Pulse shaping set? [" + pulseShapingSet_min +"; " + pulseShapingSet_max + "]");
	}
	for (var col=0; col<DMX_NB_COL; col++)	setDMX_pulseShapingSelection(col, pulseShapingSet);

    // Switching ON the feedback for all the columns
	print(TAB1+"Switching the feedback OnOff for all the columns:");
    setDMX_safeFeedbackOnOff([ON, ON, ON, ON]);

    // DEMUX feedback
	print(TAB1+"Setting the DMX feedback mode to OPEN_LOOP (FB0 -> FEEDBACK output)...");
	print(TAB1+"Setting all the FB0 to " + fb0_p + " except for pixel 0...");
    var fb = makeArray(DMX_NB_PIX_PER_COL, fb0_p);
    fb[0] += 1000;
    print(TAB2 + fb);
	for (var col=0; col<DMX_NB_COL; col++) {
		setDMX_fb0(col, fb);
		setDMX_sqm_FBMode(col, makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_OPEN_LOOP));
	}
	print("");
}

/**
 * Sets the FB_DELAY to a value and does a dump file.
 *  Sets the FB_DELAY to the value provided by the parameter fb_delay_p
 *  Does a DMX dump
 * @param {number} fb_delay_p - feedback delay s(16,0) [-512, 40].
 */
function measure_FB_DELAY(fb_delay_p) {

    print("");
    print("***");
    print("* Setting the FB_DELAY and doing a Dump");
    print("***");

    // set the register: MUX_SQ_FB_DELAY
    print(TAB1 + "Setting the register MUX_SQ_FB_DELAY to " + fb_delay_p);
	for (var col=0; col<DMX_NB_COL; col++) setDMX_feedback_delay(col, fb_delay_p);

    // Data acquisition
	print(TAB1+"Doing an acquisition in DUMP mode...");
	sendToDMXGoToDumpMode();
}


/**
 * This function is called when the script is aborted
 */
function onAbortScript() {
    sendToDMXGoToIdleMode();
    setDMX_safeFeedbackOnOff([OFF, OFF, OFF, OFF]);
	print("End of script!");
	sendStopSession();
}


/**
 * This function drives the test
 */
function carac_feedback_delay() {

    plotSmallLine();
	print("/ Feedback delay measurement");
	plotSmallLine();
	print("");

    // Definition of the feedback delay scan limits
    const delay_min = -512;
    const delay_max = 40;
    var start = delay_min - 1;
    while (start < delay_min || start > delay_max) start = getInt("Fdbk delay min? [" + delay_min + "; " + delay_max + "]");
    var end = start - 1;
    while (end < start || end > delay_max) end = getInt("Fdbk delay max? [" + start + "; " + delay_max + "]");

    const sessionName = "FDBK_DELAY_____" + toStringWithNoSigns(start) + "_" + toStringWithNoSigns(end);
    sendStartNewSession(sessionName, "");

    // DEMUX configuration
    const fb0 = 0;
    configure_test(fb0);

    // Doing a scan on the feedback delay
    for (var i = start; i < end + 1; i++) measure_FB_DELAY(i);

    print("Processing data ...")
    output = copyDirToBackupDirAndExecuteBat("c:\\analysis-tools\\dmx-dm", ".\\SCRIPTS_ANALYSE\\dmx-dm", "do_processing.bat")
    //addToFile(output)
}

// -------------------------------------------------------------------------------------------------------------

carac_feedback_delay();

onAbortScript();

// -------------------------------------------------------------------------------------------------------------
