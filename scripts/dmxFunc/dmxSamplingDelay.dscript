// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");

const file_conversion_delay = 1000;

/**
 * Configuring the test setup
 *  Sets all the DMX fb0 to the same value except for pixel 0 (in open loop mode)
 *  Sets all the DMX offset to the same value (in open loop mode)
 *  Does a DMX dump
 */
function configure_test(bxl_p) {

	const fb0 = 0;

    print("");
    print("***");
    print("* Configuring setup");
    print("***");

	const fb_delay= -2;
    print(TAB1 + "Setting the MUX_SQ_FB_DELAY to " + fb_delay + "...");

    print(TAB1 + "de-activating the pulse shaping...");
	const pulseShapingSet = 0;

    // DEMUX feedback
	const fbMin = -Math.pow(2, DMX_NB_BITS_DAC_FDBK-1);
	const fbMax = Math.pow(2, DMX_NB_BITS_DAC_FDBK-1) - 1;
    const fb = makeArray(DMX_NB_PIX_PER_COL, fbMin);
    fb[0] = fbMax;
	print(TAB1 + "Setting the DMX feedback mode to OPEN_LOOP (FB0 -> FEEDBACK output)...");
	print(TAB1 + "Setting all the set of FB0 to: ");
    print(TAB2 + fb);

	for (var col=0; col<DMX_NB_COL; col++) {
		setDMX_feedback_delay(col, fb_delay);
		setDMX_pulseShapingSelection(col, pulseShapingSet);
		setDMX_fb0(col, fb);
		setDMX_sqm_FBMode(col, makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_OPEN_LOOP));
	}

	// Switching OFF the OFCO
	print(TAB1 + "Setting the DMX offset mode to OFF...");
	setDMX_offsetMode([OFFSET_MODE_OFF, OFFSET_MODE_OFF, OFFSET_MODE_OFF, OFFSET_MODE_OFF]);

	print(TAB1 + "Switching the feedback ON for all the columns...");
    setDMX_safeFeedbackOnOff([ON, ON, ON, ON]);

}


/**
 * Scanning the sampling delay values and measuring error files.
 */
function scan_sampling_delay() {

	const duration = 200;
	const delta_duration=100;

	for (var sampDelay=0; sampDelay<20; sampDelay++) {

		print(TAB2 + "Doing a measurement with a SAMPLING DELAY set to " + sampDelay + " ...");
		for (colId = 0; colId < DMX_NB_COL; colId++) setDMX_sampling_delay(colId, sampDelay);

		// Doing an error file
		sendToDMXGoToErrorSignalMode();
		filename = "SamplingDelay_" + ("00" + sampDelay).slice(-2);
		sendToDMXSaveScienceRaw(filename, duration, 0xF, 0);
		waitMs(duration + delta_duration);

		sendToDMXGoToIdleMode();
	}
}


/**
 * This function is called when the script is aborted
 */
function onAbortScript() {
    sendToDMXGoToIdleMode();
    setDMX_safeFeedbackOnOff([OFF, OFF, OFF, OFF]);
	print("End of script!");
	sendStopSession();
}


/**
 * This function drives the test for a given boxcar length value
 */
function carac_sampling_delay(boxcarL) {

	setDMX_boxcarLength([boxcarL, boxcarL, boxcarL, boxcarL]);

	const nbDumpFiles = 8;
	const sessionName = "SAMP-DELAY-----BXL"+ boxcarL;
	sendStartNewSession(sessionName, "");

	print(TAB1 + "Measuring input signal with dumps...");
	for (var i = 0; i<nbDumpFiles; i++) sendToDMXGoToDumpMode();

    print("");
    print(TAB1 + "Scanning the SAMPLING_DELAY and doing ERROR files");
	scan_sampling_delay();

	waitMs(file_conversion_delay); // delay for file format conversion
	print("Processing data ...")
	output = copyDirToBackupDirAndExecuteBat(analysis_tools_path,".\\SCRIPTS_ANALYSE\\dmx-dm","do_processing.bat")
	//addToFile(output)

}


/**
 * This function drives the test
 */
function carac_sampling_delay_and_bxl() {

	plotSmallLine();
	print("/ Sampling delay and boxcar length measurements");
	plotSmallLine();
	print("");

	configure_test();

	// Scanning the different values of boxcar length
	for (var bxl=0; bxl<6; bxl+=1) {
		print(TAB2 + "Characterising BOXCAR_LENGTH = " + bxl + "...");
		carac_sampling_delay(bxl);
	}

}

// -------------------------------------------------------------------------------------------------------------

carac_sampling_delay_and_bxl();

onAbortScript();

// -------------------------------------------------------------------------------------------------------------
