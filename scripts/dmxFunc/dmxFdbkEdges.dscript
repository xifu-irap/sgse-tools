// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");

/**
 * Configuring the test setup
 *  Sets all the DMX fb0 to the same value except for pixel 0 (in open loop mode)
 *  Sets all the DMX offset to the same value (in open loop mode)
 *  Does a DMX dump
 */
function start_test(fb0_p) {

    print("");
    print("* Configuring setup");

    // Setting the pulse shaping set to 0 (no pulse shaping)
	print(TAB1+"Setting the pulse shaping set to - No pulse shaping -:");
	const pulseShapingSet = 0;
	for (var col=0; col<DMX_NB_COL; col++)	setDMX_pulseShapingSelection(col, pulseShapingSet);

    // Switching ON the feedback for all the columns
	print(TAB1+"Switching the feedback ON for all the columns:");
    setDMX_safeFeedbackOnOff([ON, ON, ON, ON]);

    // DEMUX feedback
    const val_min = - Math.pow(2, DMX_NB_BITS_DAC_FDBK-1);
    const val_max = Math.pow(2, DMX_NB_BITS_DAC_FDBK-1)-1;
    var fb = makeArray(DMX_NB_PIX_PER_COL, val_min);
    fb[0] = val_max;

	print(TAB1+"Setting the DMX feedback mode to OPEN_LOOP (FB0 -> FEEDBACK output)...");
	print(TAB1+"Setting the FB0 to: ");
    print(TAB2 + fb);
	for (col=0; col<DMX_NB_COL; col++) {
		setDMX_fb0(col, fb);
		setDMX_sqm_FBMode(col, makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_OPEN_LOOP));
	}
	print("");

    alert("Measure the rising and falling time of the 4 feedback signals on the Ofco loopback");

}


/**
 * This function is called when the script is aborted
 */
function onAbortScript() {
    sendToDMXGoToIdleMode();
	print("End of script!");
	sendStopSession();
}


/**
 * This function drives the test
 */
function carac_feedback_edges() {

    plotSmallLine();
	print("/ Feedback edges measurement");
	plotSmallLine();
	print("");

    start_test();
}

// -------------------------------------------------------------------------------------------------------------

startSession("fdbkEdgesTest");

carac_feedback_edges();

onAbortScript();

// -------------------------------------------------------------------------------------------------------------
