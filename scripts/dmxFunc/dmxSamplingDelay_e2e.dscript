// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");


/**
 * Configuring the test setup
 *  Sets all the DMX fb0 to the same value except for pixel 0 (in open loop mode)
 *  Sets all the DMX offset to the same value (in open loop mode)
 *  Does a DMX dump
 * @param {number} fb0_p - Feedback at MUX SQUID operating point s(16,2).
 * @param {number} pulseShapingSet_p - Pulse shaping set Id [0-3].
 * @param {number} fb_delay_p - feedback delay s(16,0) [-512, 40].
 * @param {number} boxcarL_p - Boxcar length [0-3].
 */
function configure_test(fb0_p, pulseShapingSet_p, fb_delay_p, boxcarL_p) {

    print("");
    print("***");
    print("* Configuring setup");
    print("***");

    // Selecting the pulse shaping set
	print(TAB1+"Selecting the pulse shaping set number " + pulseShapingSet_p + ":");
	for (var col=0; col<DMX_NB_COL; col++)	setDMX_pulseShapingSelection(col, pulseShapingSet_p);

    // setting the MUX_SQ_FB_DELAY
    print(TAB1+"Setting the register MUX_SQ_FB_DELAY to " + fb_delay_p);
	for (col=0; col<DMX_NB_COL; col++) setDMX_feedback_delay(col, fb_delay_p);

    // Switching ON the feedback for all the columns
	print(TAB1+"Switching the feedback OnOff for all the columns:");
    setDMX_safeFeedbackOnOff([ON, ON, ON, ON]);

    // DEMUX feedback
	print(TAB1+"Setting the DMX feedback mode to OPEN_LOOP (FB0 -> FEEDBACK output)...");
	print(TAB1+"Setting all the FB0 to " + fb0_p + " except for pixel 0...");
    var fb = makeArray(DMX_NB_PIX_PER_COL, fb0_p);
    fb[0] += 1000;
    print(TAB2 + fb);
	for (var col=0; col<DMX_NB_COL; col++) {
		setDMX_fb0(col, fb);
		setDMX_sqm_FBMode(col, makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_OPEN_LOOP));
	}

    // Setting the boxcar length
	print(TAB1+"Setting the boxcar length to " + boxcarL_p);
	setDMX_boxcarLength(boxcarL_p);

	print("");
}


/**
 * Scanning the sampling delay values and measuring error files.
 */
function scan_sampling_delay() {

	const duration = 200;
	const delta_duration=100;

    print("");
    print("***");
    print("* Scanning the SAMPLING_DELAY and doing ERROR files");
    print("***");

	for (var sampDelay=0; sampDelay<20; sampDelay++) {

		print(TAB2 + "Doing a measurement with a SAMPLING DELAY set to " + sampDelay + " ...");

		for (colId = 0; colId < DMX_NB_COL; colId++) setDMX_sampling_delay(colId, sampDelay);

		// Doing an error file
		sendToDMXGoToErrorSignalMode();
		filename = "SamplingDelay_" + ("00" + sampDelay).slice(-2);
		sendToDMXSaveScienceRaw(filename, duration, 0xF, 0);
		waitMs(duration + delta_duration);

		sendToDMXGoToIdleMode();
	}
}


/**
 * This function is called when the script is aborted
 */
function onAbortScript() {
    sendToDMXGoToIdleMode();
    setDMX_safeFeedbackOnOff([OFF, OFF, OFF, OFF]);
	print("End of script!");
	sendStopSession();
}


/**
 * @param {number} fb0_p - Feedback at MUX SQUID operating point s(16,2).
 * @param {number} pulseShapingSet_p - Pulse shaping set Id [0-3].
 * @param {number} fb_delay_p - feedback delay s(16,0) [-512, 40].
 * @param {number} boxcarL_p - Boxcar length [0-3].
 */
function carac_sampling_delay(fb0_p, pulseShapingSet_p, fb_delay_p, boxcarL_p) {

	nbDumpFiles = 16;

	sessionName = "samplingDelay-Bxl"+("00" + boxcarL).slice(-2)+"-pulseShapingSet"+pulseShapingSet;
	sendStartNewSession(sessionName, "");

	configure_test(fb0_p, pulseShapingSet_p, fb_delay_p, boxcarL_p)

	print(TAB1+"Measuring input signal with dumps...");
	for (var i = 0; i<nbDumpFiles; i++) sendToDMXGoToDumpMode();

	scan_sampling_delay();

}


// -------------------------------------------------------------------------------------------------------------

const fb0 = 0;
const pulseShapingSet  =  1;
const fb_delay = 13;
const boxcarL = 0;
const boxcarLArray = [boxcarL, boxcarL, boxcarL, boxcarL];

carac_sampling_delay(fb0, pulseShapingSet, fb_delay, boxcarLArray);

print("Processing data ...")
//output = copyDirToBackupDirAndExecuteBat("..\\analysis-tools",".\\SCRIPTS_ANALYSE\\analysis-tools","dmx-dm\\samplingDelayAnalysis.bat")
//addToFile(output)

onAbortScript();

// -------------------------------------------------------------------------------------------------------------
