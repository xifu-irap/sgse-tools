// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");

const file_conversion_delay = 3000;

/**
 * Configuring the test setup
 *  Sets all the DMX fb0 to the same value (in open loop mode)
 *  Sets all the DMX offset MUX to the same value except for pixel 0 (in open loop mode)
 *  Does a DMX dump
 */
function configure_test_MUX() {

    print("");
    print("***");
    print("* Configuring setup");
    print("***");

	// OFCO
	print(TAB1+"Setting the DMX offset mode to OFFSET...");
	setDMX_offsetMode([OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET]);

	print(TAB1+"Setting the Offset COARSE to 0...");
	print(TAB1+"Setting the Offset LSB to 2^12 - 1...");
	print(TAB1+"Setting the Offset FINE to 0 for all pixels except for pixel 0...");
    var offsetFine = makeArray(DMX_NB_PIX_PER_COL, 0);
	offsetFine[0] = 7;
	for(colid=0; colid<DMX_NB_COL; colid++) {				
		setDMX_sqa_OffsetCoarse(colid, OFFSET_COARSE_ADU_MIN);				
		setDMX_sqa_OffsetLSB(colid, OFFSET_LSB_ADU_MAX);	
		setDMX_sqa_OffsetFine(colid, offsetFine, offsetFine);
	}		
}


/**
 * Configuring the test setup
 *  Sets all the DMX fb0 to the same value (in open loop mode)
 *  Sets all the DMX offset MUX to the same value except for pixel 0 (in open loop mode)
 *  Does a DMX dump
 */
function configure_test_DAC() {

    print("");
    print("***");
    print("* Configuring setup");
    print("***");

	// OFCO
	print(TAB1+"Setting the Offset LSB to 0 for all the pixels...");
	print(TAB1+"Setting the Offset FINE to 0 for all the pixels...");
    const offsetFine_0 = makeArray(DMX_NB_PIX_PER_COL, 0);
	for(colid=0; colid<DMX_NB_COL; colid++) {
		setDMX_sqa_OffsetCoarse(colid, OFFSET_COARSE_ADU_MIN);
		setDMX_sqa_OffsetLSB(colid, OFFSET_LSB_ADU_MIN);
		setDMX_sqa_OffsetFine(colid, offsetFine_0, offsetFine_0);
	}
	
	print(TAB1+"Setting the Offset COARSE to an alternating value with the test pattern...");
	const a = -1*Math.pow(2, 15);
	const b = 0;
	const c = 2000;
	const N = 2;
	const rampPattern = [
		[a, b, c, N],  // Slope upward
		[0, 0, 0, 0],  // Nothing
		[0, 0, 0, 0],  // Nothing
		[0, 0, 0, 0],  // Nothing
		[0, 0, 0, 0]  // Nothing
	]; 
	setDMX_testPattern(rampPattern);


	// Setting the testPattern to a rising slope
	print(TAB1+"Setting the DMX offset mode to TEST PATTERN...");
	colOffsetMode = [OFFSET_MODE_TESTPATTERN, OFFSET_MODE_TESTPATTERN, OFFSET_MODE_TESTPATTERN, OFFSET_MODE_TESTPATTERN];
	setDMX_offsetMode(colOffsetMode);

	var enable = true;
	var infinitely = true;
	var nbTime = 0x9;
	setDMX_testPatternEnable(enable, infinitely, nbTime);

}


/**
 * Sets the AMP_SQ_OFFSET_MUX_DELAY to a value and does a dump file.
 *  Does a DMX dump
 * @param {number} delay_p - offset MUX delay s(16,0) [-512, 40].
 * @param {boolean} verbose - if true some text is ddisplayed (default=false)
 */
function measure_OFCO_MUX_DELAY(delay_p, verbose=false) {

	if (verbose) {
		print("");
		print("***");
		print("* Setting the AMP_SQ_OFFSET_MUX_DELAY and doing a Dump");
		print("***");

		print(TAB1 + "Setting the register AMP_SQ_OFFSET_MUX_DELAY to " + delay_p);

		print(TAB1+"Doing an acquisition in DUMP mode...");
	}

	for (var colId=0; colId<DMX_NB_COL; colId++) setDMX_offsetMUX_delay(colId, delay_p);

	sendToDMXGoToDumpMode();
}


/**
 * Sets the AMP_SQ_OFFSET_DAC_DELAY to a value and does a dump file.
 *  Does a DMX dump
 * @param {number} delay_p - offset DAC delay s(16,0) [-512, 40].
 */
function measure_OFCO_DAC_DELAY(delay_p) {

	const nb_dumps_per_delay = 10;
	
    print("");
    print("***");
    print("* Setting the AMP_SQ_OFFSET_DAC_DELAY and doing a Dump");
    print("***");

    // set the register: AMP_SQ_OFFSET_MUX_DELAY
    print(TAB1 + "Setting the register AMP_SQ_OFFSET_DAC_DELAY to " + delay_p);
	for (var colId=0; colId<DMX_NB_COL; colId++) setDMX_offsetDAC_delay(colId, delay_p);

    // Data acquisition
	print(TAB1+"Doing acquisitions in DUMP mode...");
	for (var iDump = 0; iDump < nb_dumps_per_delay; iDump ++) sendToDMXGoToDumpMode();
}


/**
 * This function drives the test
 */
function carac_OFCO_MUX_delay() {

    plotSmallLine();
	print("/ OFCO MUX delay measurement");
	plotSmallLine();
	print("");

	setDMX_safeFeedbackOnOff([ON, ON, ON, ON]);

    // Definition of the delay scan limits
	const delay_mux_min = -512;
	const delay_mux_max = 40;
	print(TAB1 + "measuring " + (delay_mux_max - delay_mux_min) + " dump files...");

    const sessionName = "OFCOMUX-DELAY--" + toStringWithNoSigns(delay_mux_min,'') + "_" + toStringWithNoSigns(delay_mux_max,'');
    sendStartNewSession(sessionName, "");

    // DEMUX configuration
    configure_test_MUX();

    // Doing a scan on the OFCO MUX delay
    for (var i = delay_mux_min; i < delay_mux_max + 1; i++) measure_OFCO_MUX_DELAY(i);

    print("Processing data ...")
    output = copyDirToBackupDirAndExecuteBat(analysis_tools_path, ".\\SCRIPTS_ANALYSE\\dmx-dm", "do_processing.bat")
    //addToFile(output)
}

function carac_OFCO_DAC_delay() {

    plotSmallLine();
	print("/ OFCO DAC delay measurement");
	plotSmallLine();
	print("");

    setDMX_safeFeedbackOnOff([ON, ON, ON, ON]);

    // Definition of the delay scan limits
	const start = 0;
	const delay_step = 40;
	const delay_nb_steps = 4;
	const end = start + delay_nb_steps*delay_step;

    const sessionName = "OFCODAC-DELAY--" + toStringWithNoSigns(start,'') + "_" + toStringWithNoSigns(end,'');
    sendStartNewSession(sessionName, "");

    // DEMUX configuration
    configure_test_DAC(fb0);
	
    // Doing a scan on the OFCO DAC delay
    for (var delay=start; delay <= end; delay+=delay_step) measure_OFCO_DAC_DELAY(delay);

	print(TAB1 + "Stoping the test pattern");
	var enable = false;
	var infinitely = false;
	var nbTime = 0x9;
	setDMX_testPatternEnable(enable, infinitely, nbTime);
	waitMs(file_conversion_delay); // delay for file format conversion
	
    print("Processing data ...")
    output = copyDirToBackupDirAndExecuteBat(analysis_tools_path, ".\\SCRIPTS_ANALYSE\\dmx-dm", "do_processing.bat")
    //addToFile(output)
}


/**
 * This function is called when the script is aborted
 */
function onAbortScript() {
    sendToDMXGoToIdleMode();
    //setDMX_safeFeedbackOnOff([OFF, OFF, OFF, OFF]);
	print("End of script!");
	sendStopSession();
}


// -------------------------------------------------------------------------------------------------------------

carac_OFCO_MUX_delay();

// carac_OFCO_DAC_delay();

onAbortScript();

// -------------------------------------------------------------------------------------------------------------
