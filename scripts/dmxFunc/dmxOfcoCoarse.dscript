// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");

/**
 * This function outputs a test pattern on the offset compensation output
 */
function run_ofco_coarse() {

	sendStartNewSession("OFCO-COAR-TPT--", "");

    print(TAB1 + "Switching ON the columns...");
    setDMX_safeFeedbackOnOff([ON, ON, ON, ON]);
	sendToDMXGoToErrorSignalMode();

    // Setting a start value close to the beginning of the scan
    setDMX_offsetMode(makeArray(DMX_NB_COL, OFFSET_MODE_OFFSET));
	for (var colId=0; colId<DMX_NB_COL; colId++) {
		setDMX_sqa_OffsetCoarse(colId, OFFSET_COARSE_ADU_MIN);
	}

	const a1 = -1 * Math.pow(2, 15) + 10 * 4;  // + 10 * 4 in order to avoid the saturation at low level
	const b = 127;
	const N = 64;
//	const c = Math.pow(2, 16) / N;  // --> saturates the ADC
	const c = Math.floor(Math.pow(2, 16) * 0.9 / N);

	const sawPattern = [
		[a1, b, 0, 1],  // Plate at 0 at beginning
		[a1, b, c, N],  // Slope upward
		[0, 0, 0, 0],  // Nothing
		[0, 0, 0, 0],  // Nothing
		[0, 0, 0, 0]  // Nothing
	];

	print(TAB1 + "Setting the test pattern...");
	setDMX_testPattern(sawPattern);

	print(TAB1 + "Switching off the MUX contribution...");
	for (var col = 0; col < DMX_NB_COL; col++) {
		setDMX_sqa_OffsetLSB(col, OFFSET_LSB_ADU_MIN);
		setDMX_sqa_OffsetFine(col, 0, 0);
	}

    // Request to save the next scan
	nFiles = 1;
	column_mask = 0xF;
	name = "ofco_lin"
	sendSaveNextScans(nFiles, column_mask, name);

	print(TAB1 + "Setting the offset mode to TEST_PATTERN...");
	setDMX_offsetMode([OFFSET_MODE_TESTPATTERN, OFFSET_MODE_TESTPATTERN, OFFSET_MODE_TESTPATTERN, OFFSET_MODE_TESTPATTERN]);

	print(TAB1 + "Switching ON the test pattern...");
	start_demux_pattern();

    waitMs(1000);

	stop_demux_pattern();

	print(TAB1 + "Processing data ...")
	output = copyDirToBackupDirAndExecuteBat(analysis_tools_path,".\\SCRIPTS_ANALYSE\\dmx-dm","do_processing.bat")

	sendStopSession();

}


/**
 * This function is called when the script is aborted
 */
function onAbortScript() {

    // de-activating the test pattern
	stop_demux_pattern();

	// Setting the Offset OFF
	setDMX_offsetMode(OFFSET_MODE_OFF, OFFSET_MODE_OFF, OFFSET_MODE_OFF, OFFSET_MODE_OFF);

	print("End of script!");
}

// -------------------------------------------------------------------------------------------------------------

run_ofco_coarse();

onAbortScript();

// -------------------------------------------------------------------------------------------------------------
