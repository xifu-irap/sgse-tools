//    @details
//
//    This script is used to characterise the spectral band shape of the error signal.
//
// -------------------------------------------------------------------------------------------------------------

// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");

/**
 *
 */
function caracErrorBandShape() {

    print("");
    print("***");
    print("* Configuring setup");
    print("***");

    // Selecting the pulse shaping set
	pulseShapingSet = 0;
	print(TAB1+"Selecting the pulse shaping set number " + pulseShapingSet + " (no pulse shaping)");

    // DEMUX feedback
	print(TAB1+"Setting the DMX feedback mode to OPEN_LOOP (FB0 -> FEEDBACK output)...");
	print(TAB1+"Setting the DMX FB0 to -1V for pixels 0 to 16 and to 1V for the others...");
	var fb = makeArray(DMX_NB_PIX_PER_COL, -1*Math.pow(2, DMX_NB_BITS_DAC_FDBK-1));
	for (var pix=17; pix<DMX_NB_PIX_PER_COL; pix++) fb[pix] = Math.pow(2, DMX_NB_BITS_DAC_FDBK-1)-1;

	for (var col=0; col<DMX_NB_COL; col++) {
		setDMX_pulseShapingSelection(col, pulseShapingSet);
		setDMX_fb0(col, fb);
		setDMX_sqm_FBMode(col, makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_OPEN_LOOP));
	}
	print("");

	// Switching ON the feedback for all the columns
	print(TAB1+"Switching the feedback ON for all the columns:");
    setDMX_safeFeedbackOnOff([ON, ON, ON, ON]);


	// Doing several dump files (will be averaged during data processing)
	alert("OK to measure dump files and finish the test?");

	nbDumpFiles = 32;
	print(TAB1+"Measuring " + nbDumpFiles + " dump files...");
	for (var i = 0; i<nbDumpFiles; i++) sendToDMXGoToDumpMode();


	print("Processing data ...")
	output = copyDirToBackupDirAndExecuteBat(analysis_tools_path,".\\SCRIPTS_ANALYSE\\dmx-dm","do_processing.bat")

}


function startSession(sessionName) {
    sendStartNewSession(sessionName, "");
}


/**
 * This function is called when the script is aborted
 */
function onAbortScript() {

    // de-activating data acquisition
    sendToDMXGoToIdleMode();

    // Switching OFF the columns
    setDMX_safeFeedbackOnOff([OFF, OFF, OFF, OFF]);

	print("End of script!");
}

// -------------------------------------------------------------------------------------------------------------

const sessionName = "ERRO_BANDSHAPE-------";
startSession(sessionName);

caracErrorBandShape();

onAbortScript();

// -------------------------------------------------------------------------------------------------------------





