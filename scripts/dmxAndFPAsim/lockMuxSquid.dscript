// -------------------------------------------------------------------------------------------------------------
//    email                     laurent.ravera@irap.omp.eu
//    @file                     lockMuxSquid.dscript
// -------------------------------------------------------------------------------------------------------------
//    @details
//
//    This file is used to use the DEMUX and the MUX SQUID of the FPAsim in closed loop mode.
//
// -------------------------------------------------------------------------------------------------------------

// imports
include("../includes/demux/dmxTools.dscript");
include("../includes/demux/dmxRegAddresses.dscript");
include("../includes/demux/dmxHk.dscript");
include("../includes/demux/dmxStart.dscript");

include("../includes/fpasim/fpasim/fpasim.dscript");
include("../includes/fpasim/fpasim_startup.dscript");
include("../includes/fpasim/fpasim_config.dscript");

include("../includes/fpasim/fpasim/fpasim_tools.dscript");
include("../includes/fpasim/fpasim/utils_tools.dscript");
include("../includes/fpasim/fpasim/cdce72010.dscript");
include("../includes/fpasim/fpasim/ads62p49.dscript");
include("../includes/fpasim/fpasim/dac3283.dscript");
include("../includes/fpasim/fpasim/amc7823.dscript");

include("../includes/common/utilTools.dscript");
include("../includes/common/constants.dscript");

// -------------------------------------------------------------------------------------------------------------

const col = 0;
sessionName = "lockingMuxLoop-col"+col;
sendStartNewSession(sessionName, "");

const savingDataWhileClosingLoop = false;
const savingDataWhilePulses = false;
const pulseDataDurationMs = 4000;

const doingPulsesRandomEnergies = false;
const pulseHeightPcMax = 70;  // Modulation max

const doingPulsesSingleEnergy = true;
const pulseHeightPcSingle = 90; // Modulation

const nbIterations = 500000; // number of pulses per pixels and per energy

const knorm = 0.077;
const ki = 1.2;
const kiknorm = ki*knorm; 

/*
  Starting and initializing the FPAsim
*/
fpasimStartup(); // If the FPAsim is already enabled nothing is done unless the "force_p" parameter is set to true.
fpasimConfig(raDelayOpt, SteadyMode90Fsr);
const TesSteady =  Math.round(STEADY_FSR * 90 / 100); // TES steady state

/*
 Starting and configuring the DEMUX
*/
const boxcarL = 1;
const boxcarLArray = [boxcarL, boxcarL, boxcarL, boxcarL];
const pattern = "FULL";
demuxStart(sampDelayOpt, boxcarLArray, fdbkDelayOpt, fb0Opt, offsetLSBOpt, offsetFineOpt, offsetCoarseOpt, pulseShapingSetOpt, lockPointVOpt, muxInputGain, ampInputGain, aOpt, pattern);

print(TAB1 + "Delock counters at the beggining: " + readDMX_delockCounters(col, false));

print(TAB1 + "Setting knorm to " + knorm);
print(TAB1 + "Setting ki to " + ki);
print(TAB1 + "Setting kiknorm to " + kiknorm);
for (var colId=0; colId<DMX_NB_COL; colId++) {
	setDMX_sqm_knorm(colId, makeArray(DMX_NB_PIX_PER_COL, knorm));
	setDMX_sqm_kiknorm(colId, makeArray(DMX_NB_PIX_PER_COL, kiknorm));
}

/*
Closing the loop
*/
waitMs(6000000, true, true, "OK to close the loop?");

print(TAB1 + "Starting Error acquisition while the loop is still open, then closing the feedback loop ...");
sendToDMXGoToErrorSignalMode();
const fileDurationMs = 2000;
if (savingDataWhileClosingLoop) sendToDMXSaveScienceRaw("errorDataWhileClosingLoop.fits", fileDurationMs, 1<<col, 0);
fbMode = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_CLOSED_LOOP);
setDMX_sqm_FBMode(col, fbMode);
waitMs(fileDurationMs);

print(TAB1 + "Setting data acquisition in SCIENCE mode...");
sendToDMXGoToScienceMode();

/*
Doing pulses
*/
if (doingPulsesRandomEnergies) {
	waitMs(6000000, true, true, "OK to send the pulses?");

	// Doing a data acquisition
	if (savingDataWhilePulses) sendToDMXSaveScienceRaw("pulses", pulseDataDurationMs , 1<<col, 0);

	// Computing pseudo random energies
	const a = 1103515245;
	const b = 12345;
	const m = Math.pow(2,31);
	//const pcMax = 80; // --> Delocks
	var pulseHeightPc = 1;  // initialisation
	for (iteration = 0; iteration < nbIterations; iteration++) {
		print(TAB2 + "Iteration " + iteration + " / " + nbIterations);
		for (var iPix=0; iPix < DMX_NB_PIX_PER_COL; iPix++) {
				pulseHeightPc = ((pulseHeightPc * a + b) % m ) * pulseHeightPcMax / m;
				pulseHeight = Math.round(TesSteady * pulseHeightPc / 100);
				sendToFPAsim_makePulse(iPix, 0, pulseHeight);
		}
	}
}

if (doingPulsesSingleEnergy) {
	waitMs(6000000, true, true, "OK to send the pulses?");

	// Doing a data acquisition
	if (savingDataWhilePulses) sendToDMXSaveScienceRaw("pulses", pulseDataDurationMs , 1<<col, 0);

	for (iteration = 0; iteration < nbIterations; iteration++) {
		print(TAB2 + "Iteration " + iteration + " / " + nbIterations);
		for (var iPix=0; iPix < DMX_NB_PIX_PER_COL; iPix++) {
				pulseHeight = Math.round(steady * pulseHeightPcSingle / 100);
				sendToFPAsim_makePulse(iPix, 0, pulseHeight);
		}
	}
}

waitMs(6000000, true, true, "Measurement of pulses is done");

// -------------------------------------------------------------------------------------------------------------
onAbortScript();

function onAbortScript() {
	sendStopSession();
	sendToDMXGoToIdleMode();
	print(TAB1 + "Delock counters at the end: " + readDMX_delockCounters(col, false));
	print("End of script!");
}



