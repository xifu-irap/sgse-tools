//    email                     laurent.ravera@irap.omp.eu
//    @file                     testpattern.dscript
// -------------------------------------------------------------------------------------------------------------
//    @details
//
//    This script defines and send a testpattern with a ramp shape on the TM link
//
// -------------------------------------------------------------------------------------------------------------

include("../common/utilTools.dscript");

//----
// Initialisation du firmware
//----

// Passage du data acquisition mode en IDLE
sendToDMXWriteAndReadRegister(0x4000, 0x0000);

// Desactivation du test pattern
sendToDMXWriteAndReadRegister(0x4150, 0x0000);

// Switching the feedback on in sequence
sendToDMXWriteRegister(0x4001, 0x1000); // col3 on -> 0x1000
sendToDMXWriteRegister(0x4001, 0x1100); // col3, col2 on -> 0x1100
sendToDMXWriteRegister(0x4001, 0x1110); // col3, col2, col1 on -> 0x1110
sendToDMXWriteRegister(0x4001, 0x1111); // col3, col2, col1, col0 on -> 0x1111

//----
// Debut du test
//----

// Configuration de la table des tests pattern (type pseudo pulse)
//      Rampe montante
sendToDMXWriteAndReadRegister(0x4100, 0x8000); // Valeur min
sendToDMXWriteAndReadRegister(0x4101, 0x0000); // 1 frame par marche (34 pixels)
sendToDMXWriteAndReadRegister(0x4102, 0x0010); // hauteur des marches = 16
sendToDMXWriteAndReadRegister(0x4103, 0x1000); // 4096 marches (x34 pixels => 139264 valeurs) 
//      Region inactive
sendToDMXWriteAndReadRegister(0x4104, 0x0000); 
sendToDMXWriteAndReadRegister(0x4105, 0x0000); 
sendToDMXWriteAndReadRegister(0x4106, 0x0000);
sendToDMXWriteAndReadRegister(0x4107, 0x0000);
//      Region inactive
sendToDMXWriteAndReadRegister(0x4108, 0x0000);
sendToDMXWriteAndReadRegister(0x4109, 0x0000);
sendToDMXWriteAndReadRegister(0x410A, 0x0000);
sendToDMXWriteAndReadRegister(0x410B, 0x0000);
//      Region inactive
sendToDMXWriteAndReadRegister(0x410C, 0x0000);
sendToDMXWriteAndReadRegister(0x410D, 0x0000);
sendToDMXWriteAndReadRegister(0x410E, 0x0000);
sendToDMXWriteAndReadRegister(0x410F, 0x0000);
//      Region inactive
sendToDMXWriteAndReadRegister(0x4110, 0x0000);
sendToDMXWriteAndReadRegister(0x4111, 0x0000);
sendToDMXWriteAndReadRegister(0x4112, 0x0000);
sendToDMXWriteAndReadRegister(0x4113, 0x0000);

// Configuration du data acquisition mode en TST PATTERN
sendToDMXWriteAndReadRegister(0x4000, 0x0007);
// Configuration du FEEDBACK MODE en TST PATTERN pour les pixels 0, 3 et 33 de la colonne 0 (le dernier pixel doit être configuré)
sendToDMXWriteAndReadRegister(0x0300, 0x0002);
sendToDMXWriteAndReadRegister(0x0303, 0x0002);
sendToDMXWriteAndReadRegister(0x0321, 0x0002);
// Configuration de FB0 a 0x55 pour les pixels 5, 7 et 33 de la colonne 0 (le dernier pixel doit être configuré)
sendToDMXWriteAndReadRegister(0x0205, 0x0055);
sendToDMXWriteAndReadRegister(0x0207, 0x0055);
sendToDMXWriteAndReadRegister(0x0221, 0x0055);

// Sauvegarde des donnees 
// UTILISATION DE COMMANDES SPECIFIQUES AU GSE IRAP
duration_ms = 2000;
sendToDMXSaveScienceRaw('tpt_'+maDate()+'.fits', duration_ms, 0xF, 0)

// Activation du test pattern (decommenter la ligne souhaitee)
sendToDMXWriteAndReadRegister(0x4150, 0x0030); // a l'infini
//sendToDMXWriteAndReadRegister(0x4150, 0x0023); // 3 fois

// Attente pendant l acquisition
waitMs(duration_ms);

//----
// Fin du test
//----

// Passage du data acquisition mode en IDLE
sendToDMXWriteAndReadRegister(0x4000, 0x0000);

// Desactivation du test pattern
sendToDMXWriteAndReadRegister(0x4150, 0x0000);

// Desactivation des 4 colonnes en sequence (important pour les vrais DEMUX)
sendToDMXWriteRegister(0x4001, 0x1110); // col0 off -> 0x1110
sendToDMXWriteRegister(0x4001, 0x1100); // col0, col1 off -> 0x1100
sendToDMXWriteRegister(0x4001, 0x1000); // col0, col1, col2 off -> 0x1000
sendToDMXWriteRegister(0x4001, 0x0000); // col0, col1, col2, col3 off -> 0x0000

