//    @details
//
//    This file checks the low level commands of the dmx_tools to read the default values of the DEMUX registers.
//
// -------------------------------------------------------------------------------------------------------------

// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "dmxConfigurations.dscript")
include(includes_path + "dmxCheckConf.dscript")

/**
 * This function checks the default values of the registers in the DRE modules
 */
function dreCheckDefaults() {

    const sessionName = "CHECK-DEFAULTS--";

    // Asking for configuration
    const testTabText = [
                        "DMXA",
                        "DMXB",
                        "DMXA+DMXB"
                        ];
    const iTest = getItem("Select the module to test: ", testTabText);
    const test = testTabText[iTest];

    switch(test) {
        case "DMXA":
            sendStartNewSession(sessionName, test);
            sendSelectDMX(DMXA);
            defaults_dmxa_ok = dmxCheckDefaults(conf_default_fw);
            break;
        case "DMXB":
            sendStartNewSession(sessionName, test);
            sendSelectDMX(DMXB);
            defaults_dmxb_ok = dmxCheckDefaults(conf_default_fw);
            break;
        case "DMXA+DMXB":
            sendStartNewSession(sessionName, test);
            sendSelectDMX(DMXA);
            defaults_dmxa_ok = dmxCheckDefaults(conf_default_fw);

            sendSelectDMX(DMXB);
            defaults_dmxb_ok = dmxCheckDefaults(conf_default_fw);
            break;
    }

    sendStopSession();

}