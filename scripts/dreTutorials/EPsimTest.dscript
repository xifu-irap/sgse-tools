// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "rasTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");

/**
 * This function allows to test the EPsim
 */
function EPsimTest() {

	const ICU_main = 0;
	const ICU_redundant = 1;
	
 	// Asking for the SPI module to talk with
    const testTabText = [
								"SPI command to DMXA",
								"SPI command to DMXB",
								"SPI command to RAS",
								"Select ICU main",
								"Select ICU redundant",
								"End the test"];
								
	var exit = false;
	
	while(!exit){
		
		iTest = getItem("Which test do you want to do?: ", testTabText);
		test = testTabText[iTest];

		switch(test) {
			case "SPI command to DMXA":
				sendSelectDMX(DMXA);  // Sélectionne le DEMUX A
				setDMX_feedback_delay(0, -10); // Command to the selected DEMUX module
				setDMX_feedback_delay(0, 0);
				break;
			case "SPI command to DMXB":
				sendSelectDMX(DMXB);  // Sélectionne le DEMUX B
				setDMX_feedback_delay(0, -10); // Command to the selected DEMUX module
				setDMX_feedback_delay(0, 0);
				break;
			case "SPI command to RAS":
				readRAS_tMux(); // Command to the RAS
				break;
			case "Select ICU main":
				sendToTMTC_selectICU(ICU_main);
				break;
			case "Select ICU redundant":
				sendToTMTC_selectICU(ICU_redundant);
				break;
			case "End the test":
				exit = true;
			}
		}		
	}
	
EPsimTest();
print("End of the test");