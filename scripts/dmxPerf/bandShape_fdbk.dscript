//    @file                     bandShape_fdbk.dscript
// -------------------------------------------------------------------------------------------------------------
//    @details
//
//    This script is used to characterise the spectral band shape of the feedback signal.
//
// -------------------------------------------------------------------------------------------------------------

// imports
include("../../includes/dmxTools.dscript");
include("../../includes/dmxStart.dscript");

include("../../includes/common/utilTools.dscript");
include("../../includes/common/constants.dscript");

/**
 *
 */
function caracFdbkBandShape(short_square_p) {

    print("");
    print("***");
    print("* Configuring setup");
    print("***");

    // Selecting the pulse shaping set
	pulseShapingSet = 0;
	print(TAB1+"Selecting the pulse shaping set number " + pulseShapingSet + " (highest BW of the Feedback)");
	for (var col=0; col<DMX_NB_COL; col++)setDMX_pulseShapingSelection(col, pulseShapingSet);

    // Switching ON the feedback for all the columns
	print(TAB1+"Switching the feedback OnOff for all the columns:");
    const colOnOff = [ON, ON, ON, ON];
    setDMX_safeFeedbackOnOff(colOnOff);

    // DEMUX feedback
	print(TAB1+"Setting the DMX feedback mode to OPEN_LOOP (FB0 -> FEEDBACK output)...");
	print(TAB1+"Setting the DMX FB0 to -1V / 1V...");

	const Fb0Max = Math.pow(2, 13)-1;
	const Fb0Min = -1*Math.pow(2, 13);
    const Fb01 = [Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min,  
						Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max];
						
    const Fb02 = [Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min,  
						Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max];

	print(TAB1 + "Setting a square shape in the FB0 values");

	print(TAB1 + "Setting the feedback to Open loop (FB0 => output)");

	fbMode = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_OPEN_LOOP);

	for (var col=0; col<DMX_NB_COL; col++) {
		if (short_square_p) setDMX_fb0(col, Fb01);
		else setDMX_fb0(col, Fb02)
		setDMX_sqm_FBMode(col, fbMode);
	}

}

const short_square = true;  // Square period is 2 pixels
//const short_square = false; // Square period is 1 frame

caracFdbkBandShape(short_square);

// -------------------------------------------------------------------------------------------------------------

print("End of script!");





