//    email                     laurent.ravera@irap.omp.eu
//    @file                     noiseAnalysis.dscript
// -------------------------------------------------------------------------------------------------------------
//    @details
//
//    This file is used to characterise the noise at the input of the DEMUX.
//
// -------------------------------------------------------------------------------------------------------------

// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");

// -------------------------------------------------------------------------------------------------------------
//const FB_ONOFF = [OFF, OFF, ON, OFF]; // In order to use only column 2
const FB_ONOFF = [ON, ON, ON, ON]; // In order to use all the columns
const nbDumpFiles = 128;
const errorFileDurationInS = 20;
const errorFilenames = "error_noise";
const pulseShapingSet = 3;
const boxcarL = 0;
const boxcarLArray = [boxcarL, boxcarL, boxcarL, boxcarL];
const pattern = "FULL";

// -------------------------------------------------------------------------------------------------------------

function noise(fbOnOff_p, signal, fb_Volts) {

    const sessionName = "noise_" + signal + "_Fb" + fb_Volts + "V";
    startSession(sessionName);

    print(TAB1 + "Configuring the DEMUX");
    const fb_ADU = fb_Volts * Math.pow(2, 14) / 2;
    const offsetCoarse_Volts = 0.4;
    const offsetCoarse_ADU = offsetCoarse_Volts * Math.pow(2, 12) / 1;
    demuxStart(fbOnOff_p, sampDelayOpt, boxcarLArray, fdbkDelayOpt, fb_ADU, offsetLSBOpt, offsetFineOpt, offsetCoarse_ADU, pulseShapingSet, lockPointVOpt, muxInputGain, ampInputGain, aOpt, pattern);

    // Setting the sampling delay
	const samp_delay_p = 10;
	print(TAB1+"Setting the 4 registers SAMPLING_DELAY to " + samp_delay_p);
	for (var col=0; col<DMX_NB_COL; col++) setDMX_sampling_delay(col, samp_delay_p);

    // Measuring several dump files (will be averaged during data processing)
    print(TAB1 + "Measuring " + nbDumpFiles + " dump files...");
    for (var i = 0; i < nbDumpFiles; i++) sendToDMXGoToDumpMode();

    // Measuring error data
    sendToDMXGoToErrorSignalMode();
	//setDMX_dataAcqMode(ACQ_MODE_ERROR);
	
	print(TAB1 + "Measuring an error file...");
    sendToDMXSaveScienceRaw(errorFilenames, errorFileDurationInS * 1000, 0xF, 0);
    waitMs(errorFileDurationInS * 1000);

	sendStopSession();
}

function startSession(sessionName) {
    sendStartNewSession(sessionName, "");
}

function onAbortScript() {
	sendStopSession();
	sendToDMXGoToIdleMode();
	print("End of script!");
}

// -------------------------------------------------------------------------------------------------------------

var configId = -1;
const configTab = ["", "erro-100o", "erro-open", "erro-fdbk", "erro-ofco"];
while (configId === -1) configId = getItem("Please, select noise test configuration: ", configTab);
const analysed_signal = configTab[configId];

if (analysed_signal==="erro-fdbk") {
	print(TAB2 + "Measurement for Feedback at -0.5V");
    noise(FB_ONOFF, analysed_signal, -0.5);
	print(TAB2 + "Measurement for Feedback at 0V");
    noise(FB_ONOFF, analysed_signal, 0);
	print(TAB2 + "Measurement for Feedback at 0.5V");
    noise(FB_ONOFF, analysed_signal, 0.5);
}
else noise(FB_ONOFF, analysed_signal, 0);

onAbortScript();


// -------------------------------------------------------------------------------------------------------------