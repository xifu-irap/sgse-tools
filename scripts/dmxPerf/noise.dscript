// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");

// -------------------------------------------------------------------------------------------------------------
const errorFileDurationInS = 40;
const nbDumpFiles = 64;
const errorFilenames = "error_noise";

const fileConversionDurationInS = 50;

const conf0 = {text: "100Ohms --> ERROR", flag: "NOISE-ERRO-ONLY"};
const conf1 = {text: "FDBK --> ERROR", flag: "NOISE-FDBK-ERRO"};
const conf2 = {text: "OFCO --> ERROR", flag: "NOISE-OFCO-ERRO"};

// -------------------------------------------------------------------------------------------------------------

function configure_test() {

    // Asking for the configuration setup
    const confTextTab = [conf0.text, conf1.text, conf2.text];
    const confFlagTab = [conf0.flag, conf1.flag, conf2.flag];
    var confId = getItem("Please, indicates the test configuration: ", confTextTab);
    var conf = confFlagTab[confId];

    // Setting the feedback
	print(TAB1 + "Switching the feedback OnOff to ON for all the columns:");
	setDMX_safeFeedbackOnOff([ON, ON, ON, ON]);

	print(TAB1 + "Setting the feedback mode to OPEN LOOP for all columns and all pixels");
	fbMode_OPEN_LOOP = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_OPEN_LOOP);
	for (var colId = 0; colId < DMX_NB_COL; colId++) setDMX_sqm_FBMode(colId, fbMode_OPEN_LOOP);

	print(TAB1 + "Setting the offset mode to OFFSET for all columns");

    colOffsetMode = [OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET];
    setDMX_offsetMode(colOffsetMode);
	print(TAB1 + "Setting the Ofset fine to 0");

    for (colId = 0; colId < DMX_NB_COL; colId++) {
        setDMX_sqa_OffsetLSB(colId, OFFSET_LSB_ADU_MIN);
        setDMX_sqa_OffsetFine(colId, 0, 0);
    }

    return conf;
}


function measure_data(fdbk_V, ofco_coarse_V, confName, boxcarL) {

    print(TAB2 + "Measurement for Feedback at " + fdbk_V + " V and Ofco coarse at " + ofco_coarse_V + " V and Boxcar length = " + boxcarL);

    // Setting the feedback
    var fdbk_ADU = fdbk_V * Math.pow(2, 14) / 2;
    var fb = makeArray(DMX_NB_PIX_PER_COL, fdbk_ADU);
	for (var col=0; col<DMX_NB_COL; col++) setDMX_fb0(col, fb);

    // Setting the offset coarse
    var ofco_coarse_ADU = ofco_coarse_V * Math.pow(2, 12) / 1;
    for (col = 0; col < DMX_NB_COL; col++) setDMX_sqa_OffsetCoarse(col, ofco_coarse_ADU);

    // Setting the boxcar length
    setDMX_boxcarLength([boxcarL, boxcarL, boxcarL, boxcarL]);

    // Opening a new session
    const sessionName = confName + "-BXL" + ("0" + boxcarL).slice(-1) + "_FDBK" + toStringWithNoSigns(fdbk_V, "V") + "_OFCO" + toStringWithNoSigns(ofco_coarse_V, "V");
    sendStartNewSession(sessionName, "");

    // Measuring several dump files (will be averaged during data processing)
    print(TAB2+TAB1 + "Measuring " + nbDumpFiles + " dump files...");
    for (var i = 0; i < nbDumpFiles; i++) sendToDMXGoToDumpMode();

	
    // Measuring error data
    sendToDMXGoToErrorSignalMode();
	print(TAB2+TAB1 + "Measuring error data during " + errorFileDurationInS + " seconds...");
    sendToDMXSaveScienceRaw(errorFilenames, errorFileDurationInS * 1000, 0xF, 0);
    waitMs(errorFileDurationInS * 1000 + 1000);

	print(TAB2+"Waiting for file conversion...");
	waitMs(fileConversionDurationInS*1000);
	
	print("Processing data ...")
	output = copyDirToBackupDirAndExecuteBat(analysis_tools_path,".\\SCRIPTS_ANALYSE\\dmx-dm","do_processing.bat")

	onAbortScript();
	
}


function onAbortScript() {
	sendToDMXGoToIdleMode();
	sendStopSession();
	print("Stopping current session");
}


function noise() {

    plotSmallLine();
    print("/ Noise measurement");
    plotSmallLine();
    print("");

    confName = configure_test();

    if (confName==="NOISE-FDBK-ERRO") {
        ofco_coarse_V = 0;
        fdbk_V = 0;
        boxcarL = 0;
        measure_data(fdbk_V, ofco_coarse_V, confName, boxcarL);

        ofco_coarse_V = 0;
        fdbk_V = 0.5;
        boxcarL = 0;
        measure_data(fdbk_V, ofco_coarse_V, confName, boxcarL);
    }
    else if (confName==="NOISE-OFCO-ERRO") {
        ofco_coarse_V = 0;
        fdbk_V = 0;
        boxcarL = 0;
        measure_data(fdbk_V, ofco_coarse_V, confName, boxcarL);

        ofco_coarse_V = 0.25;
        fdbk_V = 0;
        boxcarL = 0;
        measure_data(fdbk_V, ofco_coarse_V, confName, boxcarL);
    }
    else {
        boxcarL = 0;
        measure_data(0, 0, confName, boxcarL);

        //boxcarL = 3;
        //measure_data(0, 0, confName, boxcarL);
    }

}


// -------------------------------------------------------------------------------------------------------------

noise();

// -------------------------------------------------------------------------------------------------------------