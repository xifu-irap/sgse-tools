//    @file                     linearity_fdbkAndError.dscript
// -------------------------------------------------------------------------------------------------------------
//    @details
//
//    This script is used to characterize the linearity of the feedback + error signals linearity.
//    This is a global characterization. The linearity of the error and feedback signals are not characterized
//    Individualy.
//    The scan is done in several ietrations to reduce the number of measurements per scan
//
// -------------------------------------------------------------------------------------------------------------

// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");

const boxcarL = 3;

// -------------------------------------------------------------------------------------------------------------

function configure_test() {

	// setting the MUX_SQ_FB_DELAY
	const delay_min = -512;
	const delay_max = 40;
	var fb_delay = delay_min - 1;
	while (fb_delay < delay_min || fb_delay > delay_max) {
		fb_delay = getInt("Fdbk delay? [" + delay_min + "; " + delay_max + "]");
	}
	for (var colId = 0; colId < DMX_NB_COL; colId++) setDMX_feedback_delay(colId, fb_delay);

	// setting the SAMPLING_DELAY
	const samp_delay = 16;
	print(TAB1 + "Setting the sampling to 16");
	for (colId = 0; colId < DMX_NB_COL; colId++) setDMX_sampling_delay(colId, samp_delay);

	// Setting the boxcar length
	print(TAB1 + "Setting the Boxcar length to 4 samples");
	setDMX_boxcarLength([boxcarL, boxcarL, boxcarL, boxcarL]);

	// Setting the pulse shaping set
	print(TAB1 + "Setting the pulse shaping set to 0 (no pulse shaping)");
	const pulseShapingSet = 0;
	for (colId=0; colId<DMX_NB_COL; colId++) setDMX_pulseShapingSelection(colId, pulseShapingSet);

	print(TAB1 + "Switching the feedback OnOff to ON for all the columns:");
	setDMX_safeFeedbackOnOff([ON, ON, ON, ON]);

	print(TAB1 + "Setting the feedback mode to TEST PATTERN for all columns and all pixels");
	fbMode_TPT = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_TESTPATTERN);
	for (colId = 0; colId < DMX_NB_COL; colId++) setDMX_sqm_FBMode(colId, fbMode_TPT);
}


function onAbortScript() {
	sendToDMXGoToIdleMode();
	sendStopSession();
	print("End of script!");
}


/**
 * This function drives the test
 */
function linearity_fdbkAndError() {

	plotSmallLine();
	print("/ Feedback and Error linearity measurement");
	plotSmallLine();
	print("");

	const sessionName = "FDBK-ERROR-LIN--BXL"+("0" + boxcarL).slice(-1);
	sendStartNewSession(sessionName, "");

	configure_test();

	// Defining the test pattern for the scan of the feedback DAC values
	const infinitely = true;
	const nbTime = 0x9;
	const increment = Math.pow(2, DMX_NB_BITS_TPT) / Math.pow(2, DMX_NB_BITS_DAC_FDBK);
	const nbStepsPerScanBits = 11;
	const nbStepsPerScan = Math.pow(2, nbStepsPerScanBits);
	const nbStepsTotal = Math.pow(2, DMX_NB_BITS_DAC_FDBK);
	const nbScans = nbStepsTotal / nbStepsPerScan;

	print(TAB1 + "Setting data acquisition mode to ERROR mode...");
	sendToDMXGoToErrorSignalMode();

	// Several scans are measured because Xifu Studio can't acquire long scans
	print(TAB1 + nbScans + " scans will be measured:");
	const b = 0;
	const c = Math.pow(2, DMX_NB_BITS_TPT) / nbStepsPerScan;
	const N = nbStepsPerScan;
	for (var scan = 0; scan < nbScans; scan++) {

		print(TAB3 + "Setting test pattern number " + scan + " / " + nbScans);
		a = -1 * Math.pow(2, DMX_NB_BITS_TPT - 1) + scan * increment;
		const rampPattern = [
			[a, b, c, N],  // Slope upward
			[0, 0, 0, 0],  // Nothing
			[0, 0, 0, 0],  // Nothing
			[0, 0, 0, 0],  // Nothing
			[0, 0, 0, 0]   // Nothing
		];
		setDMX_testPattern(rampPattern);

		print(TAB3 + "Activating the test pattern...");
		setDMX_testPatternEnable(true, infinitely, nbTime);

		waitMs(500);

		if (scan === 0) getText("OK to save the scan files for all the columns?", "OK");
		for (var colId = 0; colId < DMX_NB_COL; colId++) {
			sendSaveDMXScan(colId, "scan_" + maDate() + "_col" + colId + ".fits");
		}

		// Stopping the current test pattern
		setDMX_testPatternEnable(false, infinitely, nbTime);
		print("");

	}

	print("Processing data ...")
	output = copyDirToBackupDirAndExecuteBat(analysis_tools_path,".\\SCRIPTS_ANALYSE\\dmx-dm","do_processing.bat")
	//addToFile(output)

}


// -------------------------------------------------------------------------------------------------------------

linearity_fdbkAndError();

onAbortScript();

// -------------------------------------------------------------------------------------------------------------
