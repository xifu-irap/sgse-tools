// imports
const includes_path = "../../includes/";
include(includes_path + "dmxTools.dscript");
include(includes_path + "utilTools.dscript");
include(includes_path + "common_constants.dscript");

// -------------------------------------------------------------------------------------------------------------
const errorFileDurationInS = 40;
const nbDumpFiles = 0;
//const errorFilenames = "fdbk1V_";
const errorFilenames = "ofco1V_";

const fileConversionDurationInS = 40;

// -------------------------------------------------------------------------------------------------------------

function configure_test(fdbk_ADU, ofco_coarse_ADU) {

	print(TAB1 + "Setting the feedback mode to OPEN LOOP for all columns and all pixels");
	fbMode_OPEN_LOOP = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_OPEN_LOOP);
	for (var colId = 0; colId < DMX_NB_COL; colId++) setDMX_sqm_FBMode(colId, fbMode_OPEN_LOOP);

    var fb = makeArray(DMX_NB_PIX_PER_COL, fdbk_ADU);
	for (var col=0; col<DMX_NB_COL; col++) setDMX_fb0(col, fb);


	print(TAB1 + "Setting the offset mode to OFFSET for all columns");
    colOffsetMode = [OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET, OFFSET_MODE_OFFSET];
    setDMX_offsetMode(colOffsetMode);
    
	print(TAB1 + "Setting the Offset");
	const OFFSET_COARSE = Math.round(ofco_coarse_ADU);  
    for (colId = 0; colId < DMX_NB_COL; colId++) {
        setDMX_sqa_OffsetLSB(colId, OFFSET_LSB_ADU_MIN);
        setDMX_sqa_OffsetFine(colId, 0, 0);
        setDMX_sqa_OffsetCoarse(colId, ofco_coarse_ADU);
    }
}


function measure_data(fdbk_ADU, ofco_coarse_ADU, boxcarL) {

    plotSmallLine();
    print("/ Feedback 1V + Error measurement");
    plotSmallLine();
    print("");

    print(TAB2 + "Measurement for Feedback at " + fdbk_ADU + " ADU, Ofco at " + ofco_coarse_ADU + " and Boxcar length = " + boxcarL);

    // Setting the boxcar length
    setDMX_boxcarLength([boxcarL, boxcarL, boxcarL, boxcarL]);

    // Opening a new session
    const sessionName = "GAIN_VS_TEMP---FDBK" + fdbk_ADU + "_OFCO" + ofco_coarse_ADU + "_BXL" + ("0" + boxcarL).slice(-1);
    sendStartNewSession(sessionName, "");

    // Measuring several dump files (will be averaged during data processing)
    print(TAB2+TAB1 + "Measuring " + nbDumpFiles + " dump files...");
    for (var i = 0; i < nbDumpFiles; i++) sendToDMXGoToDumpMode();

    // Measuring error data
    sendToDMXGoToErrorSignalMode();
	print(TAB2+TAB1 + "Measuring error data during " + errorFileDurationInS + " seconds...");
    sendToDMXSaveScienceRaw(errorFilenames, errorFileDurationInS * 1000, 0xF, 0);
    waitMs(errorFileDurationInS * 1000 + 1000);

	print(TAB2+"Waiting for file conversion...");
	waitMs(fileConversionDurationInS*1000);
}


function onAbortScript() {
	sendStopSession();
	print("End of measurement");
}


// -------------------------------------------------------------------------------------------------------------

fdbk_ADU = Math.pow(2, 13)-1;
ofco_coarse_ADU = Math.round(OFFSET_COARSE_ADU_MAX * 0.88) // ratio to avoid saturation of error
boxcarL = 7;

configure_test(fdbk_ADU, ofco_coarse_ADU);
measure_data(fdbk_ADU, ofco_coarse_ADU, boxcarL);
onAbortScript();

// -------------------------------------------------------------------------------------------------------------