// imports
include("../demux/dmxTools.dscript");
include("../demux/dmxRegAddresses.dscript");
include("../demux/dmxHk.dscript");
include("../demux/dmxStart.dscript");

include("../common/utilTools.dscript");
include("../common/constants.dscript");

/**
 *
 */
function caracErrorkBandShape() {

	/*
	Starting and configuring the DEMUX
	*/
	const pulseShapingSet  = 0;
	const boxcarL = 0;
	const boxcarLArray = [boxcarL, boxcarL, boxcarL, boxcarL];
	// Nulling the fast DAC contribution to the offset
	OffsetFine0 = 0;
	offsetLSB0 = 0;
	inputGain =  [1, 1, 1, 1];
	demuxStart(sampDelayOpt, boxcarLArray, fdbkDelayOpt, fb0Opt, offsetLSB0, OffsetFine0, offsetCoarseOpt, pulseShapingSet, lockPointVOpt, inputGain);

}

//caracErrorkBandShape();




col=2;



sessionName = "errorBandShape-col"+col;

sendStartNewSession(sessionName, "");





// Doing several dump files (will be averaged during data processing

nbDumpFiles = 32;

print(TAB1+"Measuring " + nbDumpFiles + " dump files...");

for (var i = 0; i<nbDumpFiles; i++) {

	setDMX_dataAcqMode(ACQ_MODE_DUMP);

}



// Scanning the different values of the sampling delay

// Using all sampling delay settings 

setDMX_dataAcqMode(ACQ_MODE_ERROR);

duration = 200;

delta_duration=100;

nbErrorFiles = 32;

print(TAB1+"Measuring " + nbErrorFiles + " error files...");



for (var i=0; i<nbErrorFiles; i++) {

	// Doing an error file

	filename="ErrorFile_" + ("00" + i).slice(-2);

	sendToDMXSaveScienceRaw(filename, duration, 1<<col);

	waitMs(duration+delta_duration);

}


// -------------------------------------------------------------------------------------------------------------
print("End of script!");





