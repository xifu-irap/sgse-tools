//    @details
//
//    This script is used to characterise the spectral band shape of the feedback signal.
//
// -------------------------------------------------------------------------------------------------------------

// imports
include("../demux/dmxTools.dscript");
include("../demux/dmxRegAddresses.dscript");
include("../demux/dmxHk.dscript");
include("../demux/dmxStart.dscript");

include("../common/utilTools.dscript");
include("../common/constants.dscript");

/**
 *
 */
function caracFdbkBandShape() {


	/*

	Starting and configuring the DEMUX

	*/

	const pulseShapingSet  = 0;

	const boxcarL = 0;

	const boxcarLArray = [boxcarL, boxcarL, boxcarL, boxcarL];

	// Nulling the fast DAC contribution to the offset

	OffsetFine0 = 0;

	offsetLSB0 = 0;

	inputGain =  [1, 1, 1, 1];

	demuxStart(sampDelayOpt, boxcarLArray, fdbkDelayOpt, fb0Opt, offsetLSB0, OffsetFine0, offsetCoarseOpt, pulseShapingSet, lockPointVOpt, inputGain);



	/*

	Configuring a set of Fb0

	*/

	const Fb0Min = -1*Math.pow(2, 15);

	const Fb0Max = Math.pow(2, 15)-1;
    const Fb01 = [Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min,  

						Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max, Fb0Min, Fb0Max];
    const Fb02 = [Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min, Fb0Min,  

						Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max, Fb0Max];



	print(TAB1 + "Setting a square shape in the FB0 values");

	print(TAB1 + "Setting the feedback to Open loop (FB0 => output)");

	fbMode = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_OPEN_LOOP);

	for (var col=0; col<DMX_NB_COL; col++) {

		setDMX_fb0(col, Fb02);

		setDMX_sqm_FBMode(col, fbMode);

	}



}


caracFdbkBandShape();

// -------------------------------------------------------------------------------------------------------------
print("End of script!");





