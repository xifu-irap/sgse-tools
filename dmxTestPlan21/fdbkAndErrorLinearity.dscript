// -------------------------------------------------------------------------------------------------------------
//    email                     laurent.ravera@irap.omp.eu
//    @file                     fdbkAndErrorLinearity.dscript
// -------------------------------------------------------------------------------------------------------------
//    @details
//
//    This script is used to characterize the linearity of the feedback + error signals linearity.
//    This is a global characterization. The linearity of the error and feedback signals are not characterized
//    Individualy.
//    The scan is done in several ietrations to reduce the number of measurements per scan
//
// -------------------------------------------------------------------------------------------------------------

// imports
include("../demux/dmxTools.dscript");
include("../demux/dmxRegAddresses.dscript");
include("../demux/dmxHk.dscript");
include("../demux/dmxStart.dscript");

include("../fpasim/fpasim/fpasim.dscript");
include("../fpasim/fpasim_startup.dscript");
include("../fpasim/fpasim_config.dscript");

include("../fpasim/fpasim/fpasim_tools.dscript");
include("../fpasim/fpasim/utils_tools.dscript");
include("../fpasim/fpasim/cdce72010.dscript");
include("../fpasim/fpasim/ads62p49.dscript");
include("../fpasim/fpasim/dac3283.dscript");
include("../fpasim/fpasim/amc7823.dscript");

include("../common/utilTools.dscript");
include("../common/constants.dscript");

// -------------------------------------------------------------------------------------------------------------

plotSmallLine();
print("/ Feedback and Error linearity measurement");
plotSmallLine();
print("");

sessionName = "fdbkAndErrorLinearity";
sendStartNewSession(sessionName, "");

/*
 Starting and configuring the DEMUX
*/
print(TAB1 + "Starting the DEMUX with the default parameters");
const boxcarL = 1;
const boxcarLArray = [boxcarL, boxcarL, boxcarL, boxcarL];
const pattern = "FULL";
demuxStart(sampDelayOpt, boxcarLArray, fdbkDelayOpt, fb0Opt, offsetLSBOpt, offsetFineOpt, offsetCoarseOpt, pulseShapingSetOpt, lockPointVOpt, muxInputGain, ampInputGain, aOpt, pattern);

print(TAB1 + "Setting the DMX feedback mode to TEST PATTERN for all columns and all pixels");
fbMode = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_TESTPATTERN);
for (var colId=0; colId<DMX_NB_COL; colId++) setDMX_sqm_FBMode(colId, fbMode);

print(TAB1 + "Setting data acquisition mode to ERROR mode...");
sendToDMXGoToErrorSignalMode();

// Defining the test pattern for the scan of the feedback DAC values
const nbStepsMaxBits = 10;
const nbStepsMax = Math.pow(2, nbStepsMaxBits);
const nbIterations = Math.pow(2, DMX_NB_BITS_DAC_FDBK-1) / nbStepsMax;
print(TAB1 + nbIterations + " scans will be measured:");

for (var iter=0; iter<nbIterations; iter++) {

	print(TAB3 + "Setting test pattern number " + iter);
	const a = -1 * Math.pow(2, DMX_NB_BITS_TPT - 1) + iter;
	const b = 0;
	const c = Math.pow(2, DMX_NB_BITS_TPT) / (nbStepsMax / 2);
	const N = nbStepsMax / 2;
	const aa = Math.pow(2, DMX_NB_BITS_TPT - 1) - 1 - iter;
	const fullPattern = [
		[a, b, c, N],  // Slope upward
		[aa, b, -c, N],  // Slope downward
		[0, 0, 0, 0],  // Nothing
		[0, 0, 0, 0],  // Nothing
		[0, 0, 0, 0]  // Nothing
	];

	print(TAB3 + "Activating the test pattern...");
	var enable = true;
	var infinitely = true;
	var nbTime = 0x9;
	setDMX_testPatternEnable(enable, infinitely, nbTime);

	waitMs(1000);
	getText("Scan of the feedback and error signals is ongoing. Do a scan acquisition:", "OK");

	print(TAB1 + "Stopping the test pattern...");
	var enable = false;
	setDMX_testPatternEnable(enable, infinitely, nbTime);

}

sendStopSession();
onAbortScript();

function onAbortScript() {
	sendToDMXGoToIdleMode();
	print("End of script!");
}



