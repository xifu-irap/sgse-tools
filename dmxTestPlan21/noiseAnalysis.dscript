//    email                     laurent.ravera@irap.omp.eu
//    @file                     noiseAnalysis.dscript
// -------------------------------------------------------------------------------------------------------------
//    @details
//
//    This file is used to characterise the noise at the input of the DEMUX.
//
// -------------------------------------------------------------------------------------------------------------

// imports
include("../demux/dmxTools.dscript");
include("../demux/dmxRegAddresses.dscript");
include("../demux/dmxHk.dscript");
include("../demux/dmxStart.dscript");

include("../fpasim/fpasim/fpasim.dscript");
include("../fpasim/fpasim_startup.dscript");
include("../fpasim/fpasim_config.dscript");

include("../fpasim/fpasim/fpasim_tools.dscript");
include("../fpasim/fpasim/utils_tools.dscript");
include("../fpasim/fpasim/cdce72010.dscript");
include("../fpasim/fpasim/ads62p49.dscript");
include("../fpasim/fpasim/dac3283.dscript");
include("../fpasim/fpasim/amc7823.dscript");

include("../common/utilTools.dscript");
include("../common/constants.dscript");

// -------------------------------------------------------------------------------------------------------------

//const signal = "erro-100o";
//const signal = "erro-only";
const signal = "erro-fdbk";
//const signal = "erro-ofco";
//const signal = "conf-FPAs";
const nbDumpFiles = 128;
const errorFileDurationInS = 20;
const errorFilenames="error_noise";

const sessionName = "noise_"+signal;
startSession(sessionName);

print(TAB1+"Configuring the DEMUX");
const pulseShapingSet  =  3;
const boxcarL = 0;
const boxcarLArray = [boxcarL, boxcarL, boxcarL, boxcarL];
const pattern = "FULL";
const fb_Volts = 0.4;
const fb_ADU = fb_Volts * Math.pow(2, 14)/ 2;
const offsetCoarse_Volts = 0.4;
const offsetCoarse_ADU = offsetCoarse_Volts * Math.pow(2, 12)/ 1;
demuxStart(sampDelayOpt, boxcarLArray, fdbkDelayOpt, fb_ADU, offsetLSBOpt, offsetFineOpt, offsetCoarse_ADU, pulseShapingSet, lockPointVOpt, muxInputGain, ampInputGain, aOpt, pattern);

// Measuring several dump files (will be averaged during data processing)
print(TAB1+"Measuring " + nbDumpFiles + " dump files...");
for (var i = 0; i<nbDumpFiles; i++) sendToDMXGoToDumpMode();

// Measuring error data
sendToDMXGoToErrorSignalMode();
sendToDMXSaveScienceRaw(errorFilenames, errorFileDurationInS*1000, 0xF, 0);
waitMs(errorFileDurationInS*1000);

onAbortScript();

function startSession(sessionName) {
    // Init CDIF IRAP
    sendToTMTC_SetWireIn(0, 1);
    sendToTMTC_SetWireIn(0, 0);
    sendToTMTC_SetWireIn(0, 2);
    sendStartNewSession(sessionName, "");
}

function onAbortScript() {
	sendStopSession();
	sendToDMXGoToIdleMode();
	print("End of script!");
}

// -------------------------------------------------------------------------------------------------------------