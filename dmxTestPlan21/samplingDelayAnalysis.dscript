//    email                     laurent.ravera@irap.omp.eu
//    @file                     samplingDelayAnalysis.dscript
// -------------------------------------------------------------------------------------------------------------
//    @details
//
//    This file is used to characterise the timing parameters in the FPAsim + DMX0 configuration.
//
// -------------------------------------------------------------------------------------------------------------

// imports
include("../demux/dmxTools.dscript");
include("../demux/dmxRegAddresses.dscript");
include("../demux/dmxHk.dscript");
include("../demux/dmxStart.dscript");

include("../fpasim/fpasim/fpasim.dscript");
include("../fpasim/fpasim_startup.dscript");
include("../fpasim/fpasim_config.dscript");

include("../fpasim/fpasim/fpasim_tools.dscript");
include("../fpasim/fpasim/utils_tools.dscript");
include("../fpasim/fpasim/cdce72010.dscript");
include("../fpasim/fpasim/ads62p49.dscript");
include("../fpasim/fpasim/dac3283.dscript");
include("../fpasim/fpasim/amc7823.dscript");

include("../common/utilTools.dscript");
include("../common/constants.dscript");


// -------------------------------------------------------------------------------------------------------------

const col = 2;

/*
  Starting and initializing the FPAsim
  If the FPAsim function is already enabled nothing is done unless the "force_p" parameter is set to true.
*/
fpasimStartup();

/*
  Configuring the FPAsim
*/
fpasimConfig(raDelayOpt, SteadyMode90Fsr);

/*
 Starting and configuring the DEMUX
*/
const pulseShapingSet  =  3;
const boxcarL = 1;
const nbDumpFiles = 16;


const boxcarLArray = [boxcarL, boxcarL, boxcarL, boxcarL];
const pattern = "FULL";
demuxStart(sampDelayOpt, boxcarLArray, fdbkDelayOpt, fb0Opt, offsetLSBOpt, offsetFineOpt, offsetCoarseOpt, pulseShapingSet, lockPointVOpt, muxInputGain, ampInputGain, aOpt, pattern);

// DEMUX feedback
print(TAB1+"Setting a different FB0 for pixel 0...");
var fb = makeArray(DMX_NB_PIX_PER_COL, fb0Opt);
fb[0] += 500;
for (var icol=0; icol<DMX_NB_COL; icol++) setDMX_fb0(icol, fb);


sessionName = "samplingDelay-col"+col+"-Bxl"+("00" + boxcarL).slice(-2);
sendStartNewSession(sessionName, "");

// Doing several dump files (will be averaged during data processing
print(TAB1+"Measuring " + nbDumpFiles + " dump files...");
for (var i = 0; i<nbDumpFiles; i++) {
	sendToDMXGoToDumpMode();
}

// Scanning the different values of the sampling delay
// Using all sampling delay settings 
sendToDMXGoToErrorSignalMode();
//sendToDMXGoToScienceMode();
duration = 200;
delta_duration=100;
nbErrorFiles = 20;
print(TAB1+"Measuring " + nbErrorFiles + " error files...");

for (var sampDelay=0; sampDelay<nbErrorFiles; sampDelay++) {
	print(TAB2+"Doing a measurement with a SAMPLING DELAY set to " + sampDelay);
	setDMX_sampling_delay(col, sampDelay);
	sampDelayVerif = readDMX_sampling_delay(col);
	if (sampDelayVerif !== sampDelay) print(TAB3 + "Houston we have a problem!!");
	// Doing an error file
	filename="SamplingDelay_" + ("00" + sampDelay).slice(-2);
	sendToDMXSaveScienceRaw(filename, duration, 1<<col);
	waitMs(duration+delta_duration);
}

sendToDMXGoToIdleMode();

// -------------------------------------------------------------------------------------------------------------
sendStopSession();
print("End of script!");
