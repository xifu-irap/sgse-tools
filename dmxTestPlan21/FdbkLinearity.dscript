// imports

include("../equipments/MSO64_LIB.dscript")

include("../demux/dmxTools.dscript");
include("../demux/dmxRegAddresses.dscript");
include("../demux/dmxHk.dscript");

include("../common/utilTools.dscript");
include("../common/constants.dscript");

/**
 * Converts the DAC codes into feedback values.
 *   The DAC 5675A-SP converts 14-bits unsigned values into an analogue signal.
 *   At system level the feedback values are considered to be S(16,2) values.
 *   The DEMUX firmware converts the S(16,2) values to U(14,0) values for the DAC.
 *   This function does the reverse conversion in order to control the values that
 *   will be sent to the DAC.
 * @param {number} val_p - The DAC value U(14,0).
 * @param {boolean} neg_p - If true the 14-bit value is replaced by (2^14-1-value).
 * @return feedbackValue - The feedback value S(16,2)
 */
function convertDac2Feedback(val_p, neg_p) {

    const FDBK_DAC_NBITS = 14;
    const offset = Math.pow(2, FDBK_DAC_NBITS-1);

    if ((val_p < 0) || (val_p > Math.pow(2, FDBK_DAC_NBITS)-1)) {
        print("ERROR, DAC value is incorrect! Should be betwwen 0 and 2^14-1 --> " + val_p);
        return;
    }

	var feedbackValue = (val_p - offset);

	if (neg_p) feedbackValue = Math.pow(2, FDBK_DAC_NBITS)-1 - feedbackValue;

	return feedbackValue*4;
}


/**
 * Sets different values to a fb DAC in order to measure the output level for each DAC BIT
 *   The execution of this script has to be combined with measurements at the DEMUX output.
 * @param {boolean} neg_p - If true the 14-bit value is replaced by (2^14-1-value).
 */
function characLinearityFdbk(neg_p) {

	//Open the oscilloscope socket
	var osc_socket = connect_MSO64();
	print("Connected to "+get_osc_id(osc_socket));
	
	
	//Creating a savefile
	var savefile_id = 0;
	switchToFileContext(savefile_id);
	clearFileContent();

    const FDBK_DAC_NBITS = 14;
	const FDBK_DAC_AMP = 2;
	
	const DAC_HALF_LSB = FDBK_DAC_AMP/Math.pow(2,FDBK_DAC_NBITS+1)

    print("");
    print("***");
    print("* characLinearityFdbk function");
    print("***");
    print("");

    // Switching ON the feedbacks
	print(TAB1+"Switching feedbacks ON...");
    setDMX_feedbackOnOff([ON, ON, ON, ON]);

    // DEMUX feedback
	print(TAB1+"Setting the DMX feedback mode to OPEN_LOOP (FB0 -> FEEDBACK output)...");
    const fdbkMode = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_OPEN_LOOP);
    for (var col=0; col<DMX_NB_COL; col++) setDMX_sqm_FBMode(col, fdbkMode);

	//oscilloscope init

	

	//installation des mesures

	for(var nchan=1;nchan<5;nchan++) AddNewMeasurementAtIndex(osc_socket,nchan,nchan,MEAS_TYPE.ACRMS)

	
	SetAllchannelState(osc_socket,[1,1,1,1]); // All channels ON
	SetManualHorizontalMode(osc_socket,true); //Can set RL and SR independantly 
	AdjustRLWhenSRMove(osc_socket,false); //=> (time/div will change when RL or SR is changed)
	var sr = 100e6 ;
	SetSampleRate(osc_socket,sr); //Antialiasing @ 50MHz
	var rl = 1/sr;
	SetRecordLength(osc_socket,rl);
	const VMAX = 1.1;
	const VMIN = -1.1;
	var scale  = (VMAX - VMIN) / EXTREM_VAL.VDIV;
	var position = (VMAX + VMIN)/(2*scale)
	for(var nchan=1;nchan<5;nchan++){
		SetScale(osc_socket,nchan,scale); //Vertical scaling
		SetPosition(osc_socket,nchan,position)
		SetBandwidth(osc_socket,nchan,500e6); //Bandwidth 500 MHz
	}
	SetAcqMode(osc_socket, ACQ_MODE.HIRES); //Hires (12bits minimum guaranted. 16 bits � =625 G�ch./s (Haute r�solution) ; 200 MHz sur toutes les voies )
	
	//Set the MUX FBDK at  max to measure worst case rms
	print(TAB1 + "Estimating the lenght of an acquisition... ");
	var value = 0x3FFF;
	var acrms = new Array(4)
    var valueFbck = convertDac2Feedback(value, neg_p);
    for (col = 0; col<DMX_NB_COL; col++){
		setDMX_fb0(col, makeArray(DMX_NB_PIX_PER_COL, valueFbck));
		WaitForAnAcquisition(osc_socket); //wait for a complete acquisition to estimate RMS
		//acrms[col] = GetImmediateMeasurement(osc_socket,col+1,MEAS_TYPE.ACRMS);

		acrms[col] = GetMeasurementMeanValue(osc_socket,col+1)
	}

	
	rl = Math.pow(Math.max(acrms[0],acrms[1],acrms[2],acrms[3]),2)/Math.pow(DAC_HALF_LSB,2) *10  // 10 stands here from additional margin compare to the half LSB only
	
	SetRecordLength(osc_socket,rl);
	

	//installation des mesures

	for(var nchan=1;nchan<5;nchan++) AddNewMeasurementAtIndex(osc_socket,nchan,nchan,MEAS_TYPE.MEAN)

	
	//Write parameters to savefile
	for(var nchan=1;nchan<5;nchan++) addToFile("Analog Bandwidth Channel "+nchan+": "+GetBandwidth(osc_socket,nchan))
	addToFile("Record Length: "+GetRecordLength(osc_socket))
	addToFile("Sample Rate: "+GetSampleRate(osc_socket))
	addToFile("Col0,Col1,Col2,Col3")
	
	//answer = getText("Start loop", " ");
    // Setting the codes for each bit (from 2^0 to 2^13)
	var meas = new Array(4)
    for (var code=0; code<Math.pow(2,FDBK_DAC_NBITS); code+=128) {

        // New setting
        var valueFbck = convertDac2Feedback(code, neg_p);
        print(TAB2 + "Setting FB DAC to " + code + " (feedback = " + valueFbck + ")");
        for (col = 0; col<DMX_NB_COL; col++) setDMX_fb0(col, makeArray(DMX_NB_PIX_PER_COL, valueFbck));
        
		for (col = 0; col<DMX_NB_COL; col++){	
		// Measurement
			WaitForAnAcquisition(osc_socket); //wait for a complete acquisition to estimate RMS
			//meas[col] = GetImmediateMeasurement(osc_socket,col+1,MEAS_TYPE.MEAN);

			meas[col] = GetMeasurementMeanValue(osc_socket,col+1)
		}
		// Save
		addToFile(meas[0]+","+meas[1]+","+meas[2]+","+meas[3])

    }

	saveFileContent("MUX_FDBK_LINEARITY_MEAS.csv")
	
	disconnect_MSO64(osc_socket)
}



// -------------------------------------------------------------------------------------------------------------


characLinearityFdbk(true);


// -------------------------------------------------------------------------------------------------------------
print("End of script!");