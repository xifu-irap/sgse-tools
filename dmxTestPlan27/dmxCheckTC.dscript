//
//    This file checks the error codes on the SPI TC link. Only few error codes can be verified.
//
// -------------------------------------------------------------------------------------------------------------

// imports
include("../demux/dmxTools.dscript");
include("../demux/dmxRegAddresses.dscript");
include("../common/utilTools.dscript");
include("../common/constants.dscript");


/**
 * This function sends a TC for a specific SPI error
 * @param {string} ERROR_NAME_p - name of the error flag to be displayed.
 * @param {number} ADDRESS_p - address of the register to be used when sending the command.
 * @param {number} VALUE_p - value of the parameter to be used when sending the command.
 * @param {number} ERROR_CODE_p - expected error code related to the command.
 */
function makeTCError(ERROR_NAME_p, ADDRESS_p, VALUE_p, ERROR_CODE_p) {
    print(TAB1 + "Sending value " + VALUE_p + " to address " + ADDRESS_p);
    print(TAB1 + "This should generate an " + ERROR_NAME_p + " error");
    print(TAB1 + "The error code should be " + to_hexaString(ERROR_CODE_p));
	sendToDMXWriteRegister(ADDRESS_p, VALUE_p);
    var answer=getText("Type enter for the next step...", "");
}


/**
 * This function makes different kinds of TC errors
 */
function dmxTCCheck() {

    const ADD_DMX_WRONG_ADDRESS = 0x4099;

    /******************************************************************************************************************/
    plotLongLine();
    var ERROR_NAME = "INVALID_REGISTER_ADDRESS";
    var ADDRESS = ADD_DMX_WRONG_ADDRESS;
    var VALUE = 0x0000;
    var ERROR_CODE = SPI_ERROR_INVALID_REGISTER_ADDRESS;
    makeTCError(ERROR_NAME, ADDRESS, VALUE, ERROR_CODE);

    /******************************************************************************************************************/
    plotLongLine();
    var ERROR_NAME = "ATTEMPT_TO_WRITE_IN_READ_ONLY_REGISTER";
    var ADDRESS = ADD_DMX_HK_P5V0_ANA;
    var VALUE = 0x0000;
    var ERROR_CODE = SPI_ERROR_READ_ONLY_REGISTER;
    makeTCError(ERROR_NAME, ADDRESS, VALUE, ERROR_CODE);

    /******************************************************************************************************************/
    plotLongLine();
    var ERROR_NAME = "PARAMETER_IS_OUT_OF_RANGE";
    var ADDRESS = ADD_DMX_DATA_ACQ_MODE;
    var VALUE = 0x0010;
    var ERROR_CODE = SPI_ERROR_PARAMETER_OUT_OF_RANGE;
    makeTCError(ERROR_NAME, ADDRESS, VALUE, ERROR_CODE);

}

// ----- Running the test
dmxTCCheck();

// -------------------------------------------------------------------------------------------------------------
