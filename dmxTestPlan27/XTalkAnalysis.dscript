// imports
include("../demux/dmxTools.dscript");
include("../demux/dmxRegAddresses.dscript");
include("../demux/dmxHk.dscript");
include("../demux/dmxStart.dscript");

include("../common/utilTools.dscript");
include("../common/constants.dscript");


// -------------------------------------------------------------------------------------------------------------

const config = "_not-loaded";
//const config = "_bob-looped";
//const config = "_harness-08";

// -------------------------------------------------------------------------------------------------------------


/*
 Starting and configuring the DEMUX
*/
const boxcarL = 0;
const nbDumpFiles = 16;

const boxcarLArray = [boxcarL, boxcarL, boxcarL, boxcarL];
const pattern = "FULL";
const fdbkDelay = -3;
demuxStart(sampDelayOpt, boxcarLArray, fdbkDelay, fb0Opt, offsetLSBOpt, offsetFineOpt, offsetCoarseOpt, pulseShapingSetOpt, lockPointVOpt, muxInputGain, ampInputGain, aOpt, pattern);


for (pulseShapingSet = 0; pulseShapingSet<2; pulseShapingSet++) {

	print(TAB1+"Selecting the pulse shaping set number " + pulseShapingSet + ":");
	for (var col=0; col<DMX_NB_COL; col++)	setDMX_pulseShapingSelection(col, pulseShapingSet);

	for (var cPerp = 0; cPerp < DMX_NB_COL; cPerp++) {

		const sessionName = "XTalk_" + "ColPerp-" + cPerp + "_pulseShape-" + pulseShapingSet + config;

		// Configuring DEMUX feedback
		print(TAB1+"Setting a different FB0 for pixel 0 on column " + cPerp + " ...");
		const margin = 1500; // Pour accepter des impulsions positives et negatives
		const min_val = -Math.pow(2, DMX_NB_BITS_DAC_FDBK-1) + margin;
		const max_val = Math.pow(2, DMX_NB_BITS_DAC_FDBK-1) - margin;
		var fb = makeArray(DMX_NB_PIX_PER_COL, min_val);
		for (var icol=0; icol<DMX_NB_COL; icol++) setDMX_fb0(icol, fb);
		fb[0] = max_val;
		setDMX_fb0(cPerp, fb);

		sendStartNewSession(sessionName, "");

		/////////////////////////////////////////////////////////////////
		// Doing several dump files (will be averaged during data processing)
		print(TAB1+"Measuring " + nbDumpFiles + " dump files...");
		for (var i = 0; i<nbDumpFiles; i++) {
			sendToDMXGoToDumpMode();
		}
	}
}


onAbortScript();

// -------------------------------------------------------------------------------------------------------------

function onAbortScript() {
	sendToDMXGoToIdleMode();
	sendStopSession();
	print("End of script!");
}
