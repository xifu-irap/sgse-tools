// -------------------------------------------------------------------------------------------------------------
//    email                     laurent.ravera@irap.omp.eu
//    @file                     linearity_fdbkAndError.dscript
// -------------------------------------------------------------------------------------------------------------
//    @details
//
//    This script is used to characterize the linearity of the feedback + error signals linearity.
//    This is a global characterization. The linearity of the error and feedback signals are not characterized
//    Individualy.
//    The scan is done in several ietrations to reduce the number of measurements per scan
//
// -------------------------------------------------------------------------------------------------------------

// imports
include("../demux/dmxTools.dscript");
include("../demux/dmxRegAddresses.dscript");
include("../demux/dmxHk.dscript");
include("../demux/dmxStart.dscript");

include("../fpasim/fpasim/fpasim.dscript");
include("../fpasim/fpasim_startup.dscript");
include("../fpasim/fpasim_config.dscript");

include("../fpasim/fpasim/fpasim_tools.dscript");
include("../fpasim/fpasim/utils_tools.dscript");
include("../fpasim/fpasim/cdce72010.dscript");
include("../fpasim/fpasim/ads62p49.dscript");
include("../fpasim/fpasim/dac3283.dscript");
include("../fpasim/fpasim/amc7823.dscript");

include("../common/utilTools.dscript");
include("../common/constants.dscript");

// -------------------------------------------------------------------------------------------------------------
const FB_ONOFF = [ON, ON, ON, ON]; // In order to use all the columns

plotSmallLine();
print("/ Feedback and Error linearity measurement");
plotSmallLine();
print("");

sessionName = "fdbkAndErrorLinearity";
sendStartNewSession(sessionName, "");

/*
 Starting and configuring the DEMUX
*/
print(TAB1 + "Starting the DEMUX with the default parameters");
const boxcarL = 1;
const boxcarLArray = [boxcarL, boxcarL, boxcarL, boxcarL];
const pattern = "FULL";
const fdbkDelayBob = -3;
demuxStart(FB_ONOFF, sampDelayOpt, boxcarLArray, fdbkDelayBob, fb0Opt, offsetLSBOpt, offsetFineOpt, offsetCoarseOpt, pulseShapingSetOpt, lockPointVOpt, muxInputGain, ampInputGain, aOpt, pattern);

print(TAB1 + "Setting the DMX feedback mode to TEST PATTERN for all columns and all pixels");
fbMode_TPT = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_TESTPATTERN);
for (var colId=0; colId<DMX_NB_COL; colId++) setDMX_sqm_FBMode(colId, fbMode_TPT);

print(TAB1 + "Setting data acquisition mode to ERROR mode...");
sendToDMXGoToErrorSignalMode();

// Defining the test pattern for the scan of the feedback DAC values
const infinitely = true;
const nbTime = 0x9;
const increment = Math.pow(2, DMX_NB_BITS_TPT) / Math.pow(2, DMX_NB_BITS_DAC_FDBK);
const nbStepsPerScanBits = 11;
const nbStepsPerScan = Math.pow(2, nbStepsPerScanBits);
const nbStepsTotal = Math.pow(2, DMX_NB_BITS_DAC_FDBK);
const nbScans = nbStepsTotal / nbStepsPerScan;
print(TAB1 + nbScans + " scans will be measured:");

for (var scan=0; scan<nbScans; scan++) {

	print(TAB3 + "Setting test pattern number " + scan + " / " + nbScans);
	const a = -1 * Math.pow(2, DMX_NB_BITS_TPT - 1) + scan*increment;
	const b = 0;
	const c = Math.pow(2, DMX_NB_BITS_TPT) / nbStepsPerScan;
	const N = nbStepsPerScan;
	const rampPattern = [
		[a, b, c, N],  // Slope upward
		[0, 0, 0, 0],  // Nothing
		[0, 0, 0, 0],  // Nothing
		[0, 0, 0, 0],  // Nothing
		[0, 0, 0, 0]  // Nothing
	];
	setDMX_testPattern(rampPattern);

	print(TAB3 + "Activating the test pattern...");
	setDMX_testPatternEnable(true, infinitely, nbTime);

	waitMs(1000);

	if (scan === 0) getText("OK to save the scan files for all the columns?", "OK");	
	for (var colId=0; colId<DMX_NB_COL; colId++) {
		sendSaveDMXScan(colId, "scan_"+maDate()+"_col"+colId+".fits");
	}

	print(TAB1 + "Stopping the test pattern...");
	setDMX_testPatternEnable(false, infinitely, nbTime);
	print("");

}

onAbortScript();

function onAbortScript() {
	sendToDMXGoToIdleMode();
	sendStopSession();
	print("End of script!");
}



