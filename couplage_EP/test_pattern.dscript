//    email                     laurent.ravera@irap.omp.eu
//    @file                     testpattern.dscript
// -------------------------------------------------------------------------------------------------------------
//    @details
//
//    This script defines and send a testpattern with a ramp shape on the TM link
//
// -------------------------------------------------------------------------------------------------------------

include("../common/utilTools.dscript");

//----
// Initialisation du firmware DEMUX au cas ou...
//----

// Passage du data acquisition mode en IDLE
sendToDMXWriteRegister(0x4000, 0x0000);

// Init GSE IRAP (specific IRAP, init EGSE FIFO)
sendToTMTC_SetWireIn(0 , 1);
sendToTMTC_SetWireIn(0 , 0);
sendToTMTC_SetWireIn(0 , 2);

// Desactivation du test pattern
sendToDMXWriteRegister(0x4150, 0x0000);

// Desctivation des 4 colonnes
sendToDMXWriteRegister(0x4001, 0x0000);


//----
// Debut du test
//----

// Configuration de la table des tests pattern (type pseudo pulse)
//      Rampe montante
sendToDMXWriteRegister(0x4100, 0x8000); // Valeur min
sendToDMXWriteRegister(0x4101, 0x0000); // 1 frame par marche (34 pixels)
sendToDMXWriteRegister(0x4102, 0x0010); // hauteur des marches = 16
sendToDMXWriteRegister(0x4103, 0x1000); // 4096 marches (x34 pixels => 139264 valeurs) 
//      Region inactive
sendToDMXWriteRegister(0x4104, 0x0000); 
sendToDMXWriteRegister(0x4105, 0x0000); 
sendToDMXWriteRegister(0x4106, 0x0000);
sendToDMXWriteRegister(0x4107, 0x0000);
//      Region inactive
sendToDMXWriteRegister(0x4108, 0x0000);
sendToDMXWriteRegister(0x4109, 0x0000);
sendToDMXWriteRegister(0x410A, 0x0000);
sendToDMXWriteRegister(0x410B, 0x0000);
//      Region inactive
sendToDMXWriteRegister(0x410C, 0x0000);
sendToDMXWriteRegister(0x410D, 0x0000);
sendToDMXWriteRegister(0x410E, 0x0000);
sendToDMXWriteRegister(0x410F, 0x0000);
//      Region inactive
sendToDMXWriteRegister(0x4110, 0x0000);
sendToDMXWriteRegister(0x4111, 0x0000);
sendToDMXWriteRegister(0x4112, 0x0000);
sendToDMXWriteRegister(0x4113, 0x0000);

// Configuration du data acquisition mode en TST PATTERN
sendToDMXWriteRegister(0x4000, 0x0007);
//sendToDMXGoToTestPatternMode();


// Sauvegarde des donnees 
// UTILISATION DE COMMANDES SPECIFIQUES AU GSE IRAP
duration_ms = 2000;

sendToDMXSaveScienceRaw('tpt_'+maDate()+'.fits', duration_ms, 0xF)





// Activation du test pattern (decommenter la ligne souhaitee)

sendToDMXWriteRegister(0x4150, 0x0030); // a l'infini

//sendToDMXWriteRegister(0x4150, 0x0021); // 1 fois





// Attente pendant l acquisition

waitMs(duration_ms);




//----
// Fin du test
//----

// Passage du data acquisition mode en IDLE
sendToDMXWriteRegister(0x4000, 0x0000);

// Desactivation du test pattern
sendToDMXWriteRegister(0x4150, 0x0000);

// Desctivation des 4 colonnes
sendToDMXWriteRegister(0x4001, 0x0000);

