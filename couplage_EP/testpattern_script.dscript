//    email                     laurent.ravera@irap.omp.eu
//    @file                     testpattern_script.dscript
// -------------------------------------------------------------------------------------------------------------
//    @details
//
//    This file defines and runs a testpattern which mimics a pulse
//
// -------------------------------------------------------------------------------------------------------------


// Verification des registres DATA ACQ MODE et TEST PATTERN
sendToDMXReadRegister(0x4000); // ADD_DMX_DATA_ACQ_MODE
sendToDMXReadRegister(0x4150); // ADD_DMX_TEST_PATTERN_ENABLE

// Configuration de la table des tests pattern (type pseudo pulse)
//      Plateau au debut du pattern --> correspond a l'espacement entre pulses
sendToDMXWriteRegister(0x4100, 0x7000); // 87,5 pourcent FSR
sendToDMXWriteRegister(0x4101, 0x1000);
sendToDMXWriteRegister(0x4102, 0x0000); // hauteur des marches = 0
sendToDMXWriteRegister(0x4103, 0x0001); // 1 plateau
//      Pente descendante raide
sendToDMXWriteRegister(0x4104, 0x7000); // 87,5 pourcent FSR
sendToDMXWriteRegister(0x4105, 0x0000); // 1 frame entre 2 marches
sendToDMXWriteRegister(0x4106, 0xFF90); // hauteur des marches = -112
sendToDMXWriteRegister(0x4107, 0x0200); // 512 marches
//      Plateau
sendToDMXWriteRegister(0x4108, 0x9000); // 12,5 pourcent FSR
sendToDMXWriteRegister(0x4109, 0x0200); // longueur du plateau = 512 frames
sendToDMXWriteRegister(0x410A, 0x0000); // hauteur des marches = 0
sendToDMXWriteRegister(0x410B, 0x0001); // 1 plateau
//      Pente montante
sendToDMXWriteRegister(0x410C, 0x9000); // 12,5 pourcent FSR
sendToDMXWriteRegister(0x410D, 0x0000); // 1 frame entre 2 marches
sendToDMXWriteRegister(0x410E, 0x001C); // hauteur des marches = 28
sendToDMXWriteRegister(0x410F, 0x0400); // 1024 marches
//      Pente montante douce
sendToDMXWriteRegister(0x4110, 0x1000); // 50 pourcent FSR
sendToDMXWriteRegister(0x4111, 0x0000); // 1 frame entre 2 marches
sendToDMXWriteRegister(0x4112, 0x000E); // hauteur des marches = 14
sendToDMXWriteRegister(0x4113, 0x0800); // 2048 marches

// Activation des 4 colonnes
sendToDMXWriteRegister(0x4001, 0x1111);

// Passage du data acquisition mode en ERROR SIGNAL
sendToDMXWriteRegister(0x4000, 0x0002);

// Activation du test pattern en infini
sendToDMXWriteRegister(0x4150, 0x0030);

// Attente
waitMs(5000);

// Passage du data acquisition mode en IDLE
sendToDMXWriteRegister(0x4000, 0x0000);

// Desactivation du test pattern
sendToDMXWriteRegister(0x4150, 0x0000);

// Desctivation des 4 colonnes
sendToDMXWriteRegister(0x4001, 0x0000);

