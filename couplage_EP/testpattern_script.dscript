//    email                     laurent.ravera@irap.omp.eu
//    @file                     testpattern_script.dscript
// -------------------------------------------------------------------------------------------------------------
//    @details
//
//    This file defines and runs a testpattern.
//
// -------------------------------------------------------------------------------------------------------------


// Verification des registres DATA ACQ MODE et TEST PATTERN
sendToDMXReadRegister(0x4000); // ADD_DMX_DATA_ACQ_MODE
sendToDMXReadRegister(0x4150); // ADD_DMX_TEST_PATTERN_ENABLE

// Configuration de la table des tests pattern
sendToDMXWriteRegister(0x4100, 0x1000);
sendToDMXWriteRegister(0x4101, 0x0003);
sendToDMXWriteRegister(0x4102, 0x0000);
sendToDMXWriteRegister(0x4103, 0x0004);
sendToDMXWriteRegister(0x4104, 0x1400);
sendToDMXWriteRegister(0x4105, 0x0004);
sendToDMXWriteRegister(0x4106, 0x0400);
sendToDMXWriteRegister(0x4107, 0x0009);
sendToDMXWriteRegister(0x4108, 0x3800);
sendToDMXWriteRegister(0x4109, 0x000a);
sendToDMXWriteRegister(0x410A, 0x0000);
sendToDMXWriteRegister(0x410B, 0x0001);
sendToDMXWriteRegister(0x410C, 0x3000);
sendToDMXWriteRegister(0x410D, 0x0002);
sendToDMXWriteRegister(0x410E, 0xf800);
sendToDMXWriteRegister(0x410F, 0x0004);
sendToDMXWriteRegister(0x4110, 0x1000);
sendToDMXWriteRegister(0x4111, 0x000e);
sendToDMXWriteRegister(0x4112, 0x0000);
sendToDMXWriteRegister(0x4113, 0x0001);

// Passage du data acquisition mode en TST_PATTERN
sendToDMXWriteRegister(0x4000, 0x0007);

// Activation du test pattern en infini
sendToDMXWriteRegister(0x4150, 0x0030);

// Attente
waitMs(500);

// Passage du data acquisition mode en IDLE
sendToDMXWriteRegister(0x4000, 0x0000);

// Désactivation du test pattern
sendToDMXWriteRegister(0x4150, 0x0000);
