// imports
include("../ras/rasTools.dscript");
include("../ras/rasRegAddresses.dscript");
include("../ras/rasSequences.dscript");

while(true) {
	const addr = ADD_RAS_PS_HIGH;
	const param = 0x0555;
	sendToRASWriteRegister(addr, param);
}