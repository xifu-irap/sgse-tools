// -------------------------------------------------------------------------------------------------------------
//    email                     laurent.ravera@irap.omp.eu
//    @file                     lockMuxSquid.dscript
// -------------------------------------------------------------------------------------------------------------
//    @details
//
//    This file is used to use the DEMUX and the MUX SQUID of the FPAsim in closed loop mode.
//
// -------------------------------------------------------------------------------------------------------------

// imports
include("../demux/dmxTools.dscript");
include("../demux/dmxRegAddresses.dscript");
include("../demux/dmxHk.dscript");
include("../demux/dmxStart.dscript");

include("../fpasim/fpasim/fpasim.dscript");
include("../fpasim/fpasim_startup.dscript");
include("../fpasim/fpasim_config.dscript");

include("../fpasim/fpasim/fpasim_tools.dscript");
include("../fpasim/fpasim/utils_tools.dscript");
include("../fpasim/fpasim/cdce72010.dscript");
include("../fpasim/fpasim/ads62p49.dscript");
include("../fpasim/fpasim/dac3283.dscript");
include("../fpasim/fpasim/amc7823.dscript");

include("../common/utilTools.dscript");
include("../common/constants.dscript");

// -------------------------------------------------------------------------------------------------------------

const col = 3;
sessionName = "lockingMuxLoop-col"+col;
sendStartNewSession(sessionName, "");

const doingPulses = true;
const pulseHeightPc = [15, 20];
pulseHeight = [pulseHeightPc.length];
for (var i=0; i<pulseHeightPc.length; i++) {
	pulseHeight[i] = Math.round(STEADY_FSR * pulseHeightPc[i] / 100);
}

const nbIterations = 1000; // number of pulses per pixels and per energy

const knorm_reel = 1/16;
const knorm = Math.round(knorm_reel * Math.pow(2, 18)); 

const ki = 1.2;
const kiknorm_reel = ki*knorm_reel;
const kiknorm = Math.round(kiknorm_reel * Math.pow(2, 16)); 

/*
  Starting and initializing the FPAsim
  If the FPAsim function is already enabled nothing is done unless the "force_p" parameter is set to true.
*/
fpasimStartup();

/*
  Configuring the FPAsim
*/
fpasimConfig(raDelayOpt, SteadyMode90Fsr);

/*
 Starting and configuring the DEMUX
*/
const pulseShapingSet  = 0;
const boxcarL = 0;
const boxcarLArray = [boxcarL, boxcarL, boxcarL, boxcarL];
const pattern = "FULL";

demuxStart(sampDelayOpt, boxcarLArray, fdbkDelayOpt, fb0Opt, offsetLSBOpt, offsetFineOpt, offsetCoarseOpt, pulseShapingSet, lockPointVOpt, muxInputGain, ampInputGain, aOpt, pattern);

print(TAB1 + "Delock counters at the beggining: " + readDMX_delockCounters(col, false));

print(TAB1 + "Setting knorm to " + knorm);
print(TAB1 + "Setting ki to " + ki);
print(TAB1 + "Setting kiknorm to " + kiknorm);
for (var colId=0; colId<DMX_NB_COL; colId++) {
	setDMX_sqm_knorm(colId, makeArray(DMX_NB_PIX_PER_COL, knorm));
	setDMX_sqm_kiknorm(colId, makeArray(DMX_NB_PIX_PER_COL, kiknorm));
}

//print(TAB1 + "Starting data acquisition in ERROR mode...");
//sendToDMXGoToErrorSignalMode();

print(TAB1 + "Setting data acquisition in SCIENCE mode...");
sendToDMXGoToScienceMode();

/*
Closing the loop
*/

waitMs(6000000, true, true, "OK to close the loop?");
print(TAB1 + "closing the feedback loop ...");

//fbMode = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_OPEN_LOOP);
//fbMode[11] = FEEDBACK_MODE_CLOSED_LOOP;
fbMode = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_CLOSED_LOOP);
setDMX_sqm_FBMode(col, fbMode);

/*
Doing pulses
*/

if (doingPulses) {
	waitMs(6000000, true, true, "OK to send the pulses?");

	// Doing a data acquisition
	sendToDMXSaveScienceRaw("pulses" , 1000 , 8);

	for (iteration = 0; iteration < nbIterations; iteration++) {
		print(TAB2 + "Iteration " + iteration + " / " + nbIterations);
		for (iPulse=0; iPulse < pulseHeight.length; iPulse++) {
			for (var iPix=0; iPix < DMX_NB_PIX_PER_COL; iPix++) {
				sendToFPAsim_makePulse(iPix, 0, pulseHeight[iPulse]);
			}
		}
	}
}

waitMs(6000000, true, true, "Measurement of pulses is ongoing...");


// -------------------------------------------------------------------------------------------------------------
sendStopSession();
onAbortScript();

function onAbortScript() {
	sendToDMXGoToIdleMode();
	print(TAB1 + "Delock counters at the end: " + readDMX_delockCounters(col, false));
	print("End of script!");
}



