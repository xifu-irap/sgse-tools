// -- CONSTANTS ---------

// strings
const TAB1 = "   ";
const TAB2 = repeat(TAB1, 2);
const TAB3 = repeat(TAB1, 3);


// -- FUNCTIONS --------

/**
 * Copy a dictionnary into an other in such a way the 2 dictionnaries are independant
 * @param {dictionnary} dictionnary - dictionnary to be copied
 */
function copy_dict(dictionnary) {
	copy_dict = new Object();
	Object.keys(dictionnary).forEach(function(key) {
		copy_dict[key] =  dictionnary[key];
	});

	return copy_dict;
}


/**
 * Converts a number into a string replacing the sign with a caracter
 * "-" -> "M" and "+" -> "P"
 * @param {number} value_p - value
 * @param {character} unit_p - defines the parameter unit V or A
 */
function toStringWithNoSigns(value_p, unit_p) {
    pref = "P";
    if (value_p < 0) pref = "M";
	var text =  pref + Math.abs(value_p);
	var dot = false;
	var text_copie = '',
	for (var i=0; i<text.length; i++) {

		if (text[i] === '.') {
			text_copie = text_copie + unit_p;
			dot = true; // The unit has been written instead of the dot
		}
		else text_copie =  text_copie + text[i];
	}

	if (! dot) {  // there is no dot, the unit is written at the end of the value
		text_copie = text_copie + unit_p;
	}

	return text_copie;
}



/**
 * Check if an array includes a value
 * @param {array} array_p - array
 * @param {number} value_p - value
 */
function doesArrayInclude(array_p, value_p) {
	var answer = false;
	for (var i=0; i<array_p.length; i++) {
		if (array_p[i] === value_p) answer = true;
	}
	return answer;
}


/**
 * Creates and initialises an array with a single value.
 * @param {number} nValues - Number
 * @param {number} value - Number
 * @return {array} tab - output array
 */
function makeArray(nValues, value) {
	var tab = [];
	for (var i = 0; i < nValues; i++) tab[i] = value;
	return tab;
}


/**
 * Compares the content of two arrays (valid for numbers and arrays of any dimension).
 * @param {array} tabA_p - First array
 * @param {array} tabB_p - Second array
 * @return {boolean} areEqual - True if the two arrays are equal, False if not
 */
function arraysAreEquals(tabA_p, tabB_p) {

	if (typeof(tabA_p) === 'number' && typeof(tabB_p) === 'number') return tabA_p === tabB_p;
	else {
		if (tabA_p.length !== tabB_p.length) return false;
        else  {
			for (var i=0; i<tabA_p.length; i++) if (!arraysAreEquals(tabA_p[i], tabB_p[i])) return false;
			return true;
        }
    }
}


/**
 * This function checks if two arrays are equals. It displays a message accordingly and updates an error counter.
 * @param {array} array1 - first value
 * @param {array} array2 - second value
 * @param {number} ERROR_COUNT - counter to be updated if the 2 arrays are different
 * @param {string} TAB - Tabulation to be inserted before the message
 * @return {number} ERROR_COUNT - the updated value of the error counter
 */
function error_manager(array1, array2, ERROR_COUNT, TAB) {

    const ARROW = "-----------------------------------------------> ";
    const MESSAGE_ERROR = ARROW + " [ ERROR ]";
    const MESSAGE_OK = ARROW + " [  OK  ]";

    var MESSAGE = MESSAGE_OK;
    if (!arraysAreEquals(array1, array2)) {
        MESSAGE = MESSAGE_ERROR;
        ERROR_COUNT++;
    }
    print(TAB + MESSAGE);

    return ERROR_COUNT;
}


/**
 * Flattens a 2D array
 * @param {array} array_p - 2D array
 * @return {array} result - 1D array
 */
function flatten(array_p) {
	var result = [];
	for (var i=0; i<array_p.length; i++) {
		for (var j=0; j<array_p[i].length; j++) {
			result.push(array_p[i][j])
		}
	}
	return result;
}


/**
 * Prints the content of an array in several lines.
 * @param {array} tab - Array
 * @param {string} startStr - String to be print at the beginning of each line
 * @param {number} sliceSize - Number of elements per line
 */
function printArrayInSlices(tab, startStr, sliceSize) {
	// Default values
	if (typeof(startStr) === 'undefined') startStr = "";
	if (typeof(sliceSize) === 'undefined') sliceSize = 10;

	const l = tab.length;
    for (var i=0; i<l; i+=sliceSize) {
        print(startStr + tab.slice(i, i+sliceSize));
    }
}

/**
 * Converts a signed int value into a 2's complement signed int value.
 * @param {number} value_p - signed int value to convert
 * @param {number} width_p - value number of bits
 * @return {number} converted value
 */
function convert_sInt_to_2compInt(value_p, width_p) {
    var val;
    if ((value_p < -Math.pow(2, width_p-1)) || (value_p > Math.pow(2, width_p-1)-1)) {
        print("ERROR, impossible to do the conversion." + value_p);
    } else {
		if (value_p < 0) val = Math.pow(2, width_p-1) | (value_p + Math.pow(2, width_p-1));
		else val = value_p;
		return val;
	}
}


/**
 * Convert a 2's complement signed int to a signed int value.
 * @param {number} value_p - 2's complement signed int value to convert
 * @param {number} width_p - value number of bits
 * @return {number} converted value
 */
function convert_2compInt_to_sInt(value_p, width_p) {
    var val;
    if ((value_p >> width_p) !== 0) {
        print("ERROR, incorrect number of bits.");
    } else {
		if (value_p >> (width_p-1) === 0) {  // value is positive
			val = value_p;
		}
		else {  // value is negative
			val = -Math.pow(2, (width_p-1)) + value_p % Math.pow(2, (width_p-1));
		}
		return val;
	}
}


/**
 * Print a line with "-".
 */
function plotLongLine() {
    print("/--------------------------------------------------------------------------------------------------------/");
}


/**
 * Print a small line with "-".
 */
function plotSmallLine() {
    print("/-------------------");
}

/**
 * Converts an integer into a string in hexadecimal format.
 * @param {number} value_p - Integer to be converted
 * @return {string} converted value
 */
function to_hexaString(value_p) {
	var result = "undefined";
	//if (typeof(value_p) !== 'undefined') result = "0x" + value_p.toString(16).toUpperCase().slice(-4);
	if (typeof(value_p) !== 'undefined') result = "0x" + value_p.toString(16).toUpperCase();
    return result;
}


/**
 * Repeats a string.
 * @param {string} str_in - base string
 * @param {number} nb - number of repetitions
 * @return {string} str_out - the output string
 */
function repeat(str_in, nb) {
    var str_out = "";
	for (var i=0; i<nb; i++) str_out += str_in;
    return str_out;
}


/**
 * GUI to read operator name
 *   A list of pre-defined names is proposed.
 *   If none is selected a tab allows to enter a text
 * @return {string} operatorName - selected name
 */
 function get_operatorName()
{
	const operatorTab = ["", "Augusto", "Corentin", "David", "Odile", "Laurent", "Sylvain", "Yann"];
    var operatorName;
	var operatorId = getItem("Please, select the operator name: ", operatorTab);
	if (operatorId === -1) operatorName = getText("Please, type the operator name:", "");
	else operatorName = operatorTab[operatorId];
	return(operatorName);
}


/**
 * GUI to read a name for the session
 * @return {string} sessionName - name of the session
 */
function get_sessionName()
{
	var sessionName = getText("Please, type the session name:", "Default_session_name");
	return(sessionName);
}


/**
 * Provides the current date
 * @return {string} date - date in the format : YYYYMMDD_HHMMSS
 */
function maDate()
{
	const d = new Date();
	return d.getFullYear()+"-"+(("00" +(d.getMonth()+1).toString()).slice(-2))+"-"+(("00" +(d.getDate()).toString()).slice(-2))+"_"+(("00" +(d.getHours()).toString()).slice(-2))+"h"+(("00" +(d.getMinutes()).toString()).slice(-2))+"m"+(("00" +(d.getSeconds()).toString()).slice(-2))+"s";
}


/**
* Converts a duration in ms to a duration string in minutes, seconds and ms
* @param {number} tMs - Duration in ms
* @return {string} - MmSSsXXX
*/
function tMs_2_string(tMs) {
    const tMin = Math.floor(tMs/60000);
    const tSec = Math.floor((tMs-tMin*60000)/1000);
    const tMs2 = Math.floor(tMs-tMin*60000-tSec*1000);
    return(tMin+"m"+tSec+"s"+tMs2)
}

//---------------------------------------------------------------------------------------------------------------------------------------
function saveLogToBackupDir(destFilename)
{
	getLatestValue("DISP_BackupsCurrentDirectory")
	saveLogContent(DISP_BackupsCurrentDirectory + "\\" + destFilename)
}

//---------------------------------------------------------------------------------------------------------------------------------------
function copyFileToBackupDir(filename,destFilename)
{
	var filename = (typeof filename !== 'undefined') ? filename : __FILE__;
	getLatestValue("DISP_BackupsCurrentDirectory")
	copyFile(filename,DISP_BackupsCurrentDirectory+"\\"+destFilename)
}

//---------------------------------------------------------------------------------------------------------------------------------------
function copyDirToBackupDir(sourceDir,subdir)
{
	getLatestValue("DISP_BackupsCurrentDirectory")
	cmdLine = "xcopy "+sourceDir.replace("/","\\")+ " "+DISP_BackupsCurrentDirectory+subdir+"\\ /E /Y"
	exec(cmdLine)
}

//---------------------------------------------------------------------------------------------------------------------------------------
function copyDirToBackupDirAndExecuteBat(sourceDir,subdir, batFile)
{
	getLatestValue("DISP_BackupsCurrentDirectory")
	cmdLine = "xcopy "+sourceDir.replace("/","\\")+ " "+DISP_BackupsCurrentDirectory+subdir+"\\ /E /Y"
	exec(cmdLine)
	return execute(DISP_BackupsCurrentDirectory+subdir+"\\"+batFile,DISP_BackupsCurrentDirectory+subdir,240000)
}

//---------------------------------------------------------------------------------------------------------------------------------------
function zipFitsErrorData()
{
	getLatestValue("DISP_BackupsCurrentDirectory")
	exec(getEGSEDirectory()+"\\rar.exe m -ep "+DISP_BackupsCurrentDirectory+"\\dmx_data\\error_data.rar "+DISP_BackupsCurrentDirectory+"\\dmx_data\\error_*.fits")
}


