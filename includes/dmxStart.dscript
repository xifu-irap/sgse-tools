/**
 * Configuring the demux
 *  Applies a configuration to the demux
 *  Configures the demux in open loop for the feedback and the ofco.
 * @param {dictionnary} conf_p: content of the demux registers
 */
function demuxStart(conf_p) {

    print("");
    print("***");
    print("* Configuring DEMUX firmware");
    print("***");

	print(TAB1 + "Going to IDL acquisition mode...");
	sendToDMXGoToIdleMode();
	
	print(TAB1 + "Switching off the test pattern (just in case...)");
	setDMX_testPatternEnable(false, false, 0);

    // Switching OFF the feedback for all the columns
	//print(TAB1 + "Switching OFF the feedback for all the columns...");
    //setDMX_safeFeedbackOnOff([OFF, OFF, OFF, OFF]);
	
	print(TAB1 + "Setting the test pattern");

	// Definition of a fast test pattern on FSR
    const a1 = -1*Math.pow(2, 15);
    const b1 = 0;
    const c1 = 16;
    const N1 = 4095;
    const aa1 = Math.pow(2, 15)-1;
	const fullSawPattern = [
        [a1, b1, c1, N1],  // Slope upward -32768 -> 32704
        [aa1, b1, -c1, N1],  // Slope downward 32767 -> -32705
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0]  // Nothing
    ];
	
	// Definition of a fast test pattern on a small range around FB0
    const b2 = 3;
	const c2 = 1;
    const N2 = 64;
	const a2 = Math.pow(2, 2) * conf_p["MUX_SQ_FB0"][0] - Math.round(N2/2*c2);
	const aa2 = Math.pow(2, 2) * conf_p["MUX_SQ_FB0"][0] + Math.round(N2/2*c2);

	const miniSawPattern = [
        [a2, b2, c2, N2],  // Slope upward
        [aa2, b2, -c2, N2],  // Slope downward
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0]  // Nothing
    ];

	// Definition of a slow test pattern on FSR
    const a3 = -1 * Math.pow(2, 15);
    const b3 = 7;
    const c3 = Math.pow(2,1);
    const N3 = Math.pow(2,16)/c3 - 1;
    const aa3 = Math.pow(2, 15)-1;
    const slowSawPattern = [
        [a3, b3, c3, N3],  // Slope upward
        [aa3, b3, -c3, N3],  // Slope downward
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0]  // Nothing
    ];

	// Definition of a slow test pattern on FSR on a small range around Ofco coarse
    const b4 = 3;
    const c4 = 1;
    const N4 = 511;
	const a4 = Math.pow(2, 4)*conf_p["AMP_SQ_OFFSET_COARSE"][0] - Math.round(N4*c4/2)-Math.pow(2,15);
	const aa4 = Math.pow(2, 4)*conf_p["AMP_SQ_OFFSET_COARSE"][0] + Math.round(N4*c4/2)-Math.pow(2,15);
    const miniSlowSawPattern = [
        [a4, b4, c4, N4],  // Slope upward
        [aa4, b4, -c4, N4],  // Slope downward
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0]  // Nothing
    ];

    switch (conf_p["PATTERN"]) {
    case "FULL":
		print(TAB2 + "Defining a pattern over the full range");
		setDMX_testPattern(fullSawPattern);
		break;
	case "MINI FB0":
        print(TAB2 + "Defining a pattern over a small range around FB0");
        setDMX_testPattern(miniSawPattern);
        break;
    case "FULL SLOW":
        print(TAB2 + "Defining a slow pattern over the full range");
        setDMX_testPattern(slowSawPattern);
        break;
    case "MINI OFCO":
        print(TAB2 + "Defining a slow pattern over a small range around Ofco coarse");
        setDMX_testPattern(miniSlowSawPattern);
        break;
    default:
        print(TAB2 + "Error, test pattern is unknown")
	}
	print("");

    // set the register: SAMPLING_DELAY
    print(TAB1+"Setting the 4 registers SAMPLING_DELAY to " + conf_p["SAMPLING_DELAY"]);
	for (var col=0; col<DMX_NB_COL; col++) setDMX_sampling_delay(col, conf_p["SAMPLING_DELAY"][col]);

	// Setting the BOXCAR LENGTH
    print(TAB1+"Setting the boxcar length to " + conf_p["BOXCAR_LENGTH"]);
	for (var col=0; col<DMX_NB_COL; col++) setDMX_boxcarLength(conf_p["BOXCAR_LENGTH"][col]);

    // set the register: MUX_SQ_FB_DELAY
    print(TAB1 + "Setting the register MUX_SQ_FB_DELAY to " + conf_p["MUX_SQ_FB_DELAY"]);
	for (col=0; col<DMX_NB_COL; col++) setDMX_feedback_delay(col, conf_p["MUX_SQ_FB_DELAY"][col]);

    // set the register: AMP_SQ_OFFSET_MUX_DELAY
    print(TAB1 + "Setting the register AMP_SQ_OFFSET_MUX_DELAY to " + conf_p["AMP_SQ_OFFSET_MUX_DELAY"]);
	for (col=0; col<DMX_NB_COL; col++) setDMX_offsetMUX_delay(col, conf_p["AMP_SQ_OFFSET_MUX_DELAY"][col]);

    // set the register: AMP_SQ_OFFSET_DAC_DELAY
    print(TAB1 + "Setting the register AMP_SQ_OFFSET_DAC_DELAY to " + conf_p["AMP_SQ_OFFSET_DAC_DELAY"]);
	for (col=0; col<DMX_NB_COL; col++) setDMX_offsetDAC_delay(col, conf_p["AMP_SQ_OFFSET_DAC_DELAY"][col]);

    // Selecting the pulse shaping set
	print(TAB1+"Selecting the pulse shaping set number " + conf_p["PULSE_SHAPING_SELECTION"] + ":");
	for (col=0; col<DMX_NB_COL; col++) setDMX_pulseShapingSelection(col, conf_p["PULSE_SHAPING_SELECTION"][col]);

	// Autorelock
	print(TAB1 + "Setting auto relock parameters");
	print(TAB2 + "Delay: " + conf_p["RELOCK_DELAY"]);
	print(TAB2 + "Threshold: " + conf_p["RELOCK_THRESHOLD"]);
	for (col=0; col<DMX_NB_COL; col++) {
		setDMX_relock_delay(col, conf_p["RELOCK_DELAY"]);
		setDMX_relock_threshold(col, conf_p["RELOCK_THRESHOLD"]);
	}

    // DEMUX offset
	print(TAB1+"Setting the Offset close to the AMP SQUID operating point...");
	for (col=0; col<DMX_NB_COL; col++) {

		tab_offset_fine = makeArray(DMX_NB_PIX_PER_COL, conf_p["AMP_SQ_OFFSET_FINE"][col]);
		setDMX_sqa_OffsetFine(col, tab_offset_fine, tab_offset_fine);
		setDMX_sqa_OffsetLSB(col, conf_p["AMP_SQ_OFFSET_LSB"][col]);
		setDMX_sqa_OffsetLSBptr(col, conf_p["AMP_SQ_OFFSET_LSB_PTR"][col]);
		setDMX_sqa_OffsetCoarse(col, conf_p["AMP_SQ_OFFSET_COARSE"][col]);
	}

    // Setting parameters A, knorm and kiknorm
	print(TAB1+"Setting the feedback parameter A to: " + conf_p["A"]);
	print(TAB1+"Setting the Mux SQUID FLL ki to: " + conf_p["MUX_SQ_KI"]);
	print(TAB1+"Setting the Mux SQUID FLL knorm to: " + conf_p["MUX_SQ_KNORM"]);
	print(TAB1+"Setting the Amp SQUID FLL ki to: " + conf_p["AMP_SQ_KI"]);
	print(TAB1+"Setting the Amp SQUID FLL knorm to: " + conf_p["AMP_SQ_KNORM"]);
	for (col=0; col<DMX_NB_COL; col++) {
	    setDMX_a(col, makeArray(DMX_NB_PIX_PER_COL, conf_p["A"][col]));
	    setDMX_sqm_kiknorm(col, makeArray(DMX_NB_PIX_PER_COL, conf_p["MUX_SQ_KI"][col] * conf_p["MUX_SQ_KNORM"][col]));
	    setDMX_sqm_knorm(col, makeArray(DMX_NB_PIX_PER_COL, conf_p["MUX_SQ_KNORM"][col]));
	    setDMX_sqa_kiknorm(col, conf_p["AMP_SQ_KI"][col] * conf_p["AMP_SQ_KNORM"][col]);
	    setDMX_sqa_knorm(col, conf_p["AMP_SQ_KNORM"][col]);
	}
	
    // Setting the Mux SQUID FLL LOCKPOINT_V
	print(TAB1+"Setting the Mux SQUID FLL lockpoint voltage: " + conf_p["MUX_SQ_LOCKPOINT_V"]);
	for (col=0; col<DMX_NB_COL; col++)	setDMX_sqm_lockpointV(col, makeArray(DMX_NB_PIX_PER_COL, conf_p["MUX_SQ_LOCKPOINT_V"][col]));

    // Setting the MUX INPUT GAIN
	print(TAB1 + "Setting the MUX SQUID loop input gain to " + conf_p["MUX_SQ_INPUT_GAIN"]);
	for (col=0; col<DMX_NB_COL; col++) setDMX_sqm_inputGain(col, conf_p["MUX_SQ_INPUT_GAIN"][col]);

    // Setting the Amp SQUID FLL LOCKPOINT_V
	print(TAB1+"Setting the Amp SQUID FLL lockpoint voltage: " + conf_p["AMP_SQ_LOCKPOINT_V"]);
	for (col=0; col<DMX_NB_COL; col++)	setDMX_sqa_lockpointV(col, conf_p["AMP_SQ_LOCKPOINT_V"][col]);

    // Setting the AMP INPUT GAIN
	print(TAB1 + "Setting the AMP SQUID loop input gain to " + conf_p["AMP_SQ_INPUT_GAIN"]);
	for (col=0; col<DMX_NB_COL; col++) setDMX_sqa_inputGain(col, conf_p["AMP_SQ_INPUT_GAIN"][col]);

    // DEMUX feedback
	print(TAB1+"Setting the DMX FB0 values: " + conf_p["MUX_SQ_FB0"]);
	for (col=0; col<DMX_NB_COL; col++) {
	    setDMX_fb0(col, makeArray(DMX_NB_PIX_PER_COL, conf_p["MUX_SQ_FB0"][col]));
	}

    // Feedback ON/OFF
	//print(TAB1+"Switching the feedback ON/OFF to: " + conf_p["MUX_SQ_FB_ON_OFF"]);
    //setDMX_safeFeedbackOnOff(conf_p["MUX_SQ_FB_ON_OFF"]);

    // Feedback mode
	print(TAB1+"Setting the DMX feedback mode to: " + conf_p["MUX_SQ_FB_MODE"]);
	for (col=0; col<DMX_NB_COL; col++) {
	    setDMX_sqm_FBMode(col, makeArray(DMX_NB_PIX_PER_COL, conf_p["MUX_SQ_FB_MODE"][col]));
	}

    // Offset mode
	print(TAB1+"Setting the offset mode to: " + conf_p["AMP_SQ_OFFSET_MODE"]);
	setDMX_offsetMode(conf_p["AMP_SQ_OFFSET_MODE"]);

}

