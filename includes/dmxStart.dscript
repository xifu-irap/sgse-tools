/**
 * Definition of constants
 */

// Delays
const fdbkDelayOpt = -91;
const offsetDelayOpt = -94;
const sampDelayOpt = 16;
const pulseShapingSetOpt = 1;

// Levels
const fb0Opt = -528;

//const fb0Opt = 620*4;
const offsetLSBOpt = 10;
const offsetFineOpt = 0;
//const offsetLSBOpt = 0x0FFF;
//const offsetFineOpt = 7;
const offsetCoarseOpt = 800;

const lockPointVOpt = -3832;  // pour locker sur le MUX SQUID
//const lockPointVOpt = 1000;  // pour locker sur l'AMP SQUID
//const lockPointVOpt = 500;  // pour locker sur l'AMP SQUID

const aOpt = [0.2, 0.2, 0.2, 0.2];
const muxInputGain = [-1, -1, -1, -1];
const ampInputGain = [1, 1, 1, 1];

/**
 * Configuring the demux
 *  Applies a configuration to the demux
 *  Configures the demux in open loop for the feedback and the ofco.
 * @param {dictionnary} conf_p
 *    conf_p["samp_delay"]          --> sampling delay [0, 19]
 *    conf_p["fb_delay"]            --> feedback delay [-512, 40]
 *    conf_p["ofco_mux_delay"]      --> ofco MUX delay [-512, 40]
 *    conf_p["bxLength"]            --> boxcar length, 4 values U(4,0)
 *    conf_p["fb0"]                 --> feedback at MUX SQUID operating point s(16,2)
 *    conf_p["offsetLSB"]           --> offset LSB value at AMP SQUID operating point U(12,0)
 *    conf_p["offsetFine"]          --> offset fine value at AMP SQUID operating point U(3,0)
 *    conf_p["offsetCoarse"]        --> offset coarse value at AMP SQUID operating point U(12,0)
 *    conf_p["pulseShapingSet"]     --> pulse shaping set Id [0-3]
 *    conf_p["lockPointVMuxFll"]    --> lockpoint voltage for the Mux SQUID FLL (four values) (S(12,0)
 *    conf_p["lockPointVAmpFll"]    --> lockpoint voltage for the Amp SQUID FLL (four values) (S(12,0)
 *    conf_p["muxInputGain"]        --> input gain for the MUX SQUID loop (four values) S(4,0)
 *    conf_p["ampInputGain"]        --> input gain for the AMP SQUID loop (four values) S(4,0)
 *    conf_p["a"]                   --> "a" parameter of the FLL algorithm = 1/(1+Tau) (four values) U(16, 16)
 *    conf_p["pattern"]             --> name of the pre-defined test pattern
 */

var conf_opti = new Object();
conf_opti["samp_delay"] = 16;           // sampling delay [0, 19]
conf_opti["fb_delay"] = -91;            // feedback delay [-512, 40]
conf_opti["ofco_mux_delay"] = -94;      // ofco MUX delay [-512, 40]
conf_opti["bxLength"] = [1, 1, 1, 1];   // boxcar length, 4 values U(4,0)
conf_opti["fb0"] = -528                 // feedback at MUX SQUID operating point s(16,2)
conf_opti["offsetLSB"] = 10;            // offset LSB value at AMP SQUID operating point U(12,0)
conf_opti["offsetFine"] = 0;            // offset fine value at AMP SQUID operating point U(3,0)
conf_opti["offsetCoarse"] = 2500;       // offset coarse value at AMP SQUID operating point U(12,0)
conf_opti["pulseShapingSet"] = 0;       // pulse shaping set Id [0-3]
conf_opti["lockPointVMuxFll"] = [-3832, -3832, -3832, -3832];   // lockpoint voltage for the Mux SQUID FLL (four values) (S(12,0)
conf_opti["lockPointVAmpFll"] = [800, 800, 800, 800];           // lockpoint voltage for the Amp SQUID FLL (four values) (S(12,0)
conf_opti["muxInputGain"] = [-1, -1, -1, -1];   // input gain for the MUX SQUID loop (four values) S(4,0)
conf_opti["ampInputGain"] = [1, 1, 1, 1];       // input gain for the AMP SQUID loop (four values) S(4,0)
conf_opti["a"] = [0.2, 0.2, 0.2, 0.2];  // "a" parameter of the FLL algorithm = 1/(1+Tau) (four values) U(16, 16)
conf_opti["pattern"] = "FULL";          // name of the pre-defined test pattern

function demuxStart(conf_p) {

	// Autorelock parameters
	const relockThreshold = 0xFFFF;
	const relockDelay = 0xFFFF;
	//const relockThreshold = 0x0030;
	//const relockDelay = 400;  // Number of frames
	
    print("");
    print("***");
    print("* Configuring DEMUX firmware");
    print("***");

	print(TAB1 + "Going to IDL acquisition mode...");
	sendToDMXGoToIdleMode();
	
	print(TAB1 + "Switching off the test pattern (just in case...)");
	setDMX_testPatternEnable(false, false, 0);

    // Switching OFF the feedback for all the columns
	print(TAB1+"Switching OFF the feedback OnOff for all the columns...");
    setDMX_safeFeedbackOnOff([OFF, OFF, OFF, OFF]);
	
	print(TAB1 + "Setting the test pattern");
    const a1 = -1*Math.pow(2, 15);
    const b1 = 0;
    const c1 = 16;
    const N1 = 4095;
    const aa1 = Math.pow(2, 15)-1;
	const fullPattern = [
        [a1, b1, c1, N1],  // Slope upward -32768 -> 32704
        [aa1, b1, -c1, N1],  // Slope downward 32767 -> -32705
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0]  // Nothing
    ];
	
    const N2 = 1400;
	const c2 = 4;
	const a2 = conf_p["fb0"] - Math.round(N2/2*c2);
	const aa2 = conf_p["fb0"] + Math.round(N2/2*c2);
    const b2 = 3;
	const miniPattern = [
        [a2, b2, c2, N2],  // Slope upward
        [aa2, b2, -c2, N2],  // Slope downward
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0],  // Nothing
        [0, 0, 0, 0]  // Nothing
    ];

	if (conf_p["pattern"] === "FULL") {
		print(TAB2 + "Defining the pattern over a full range"); 
		setDMX_testPattern(fullPattern);
	}
	else {
		if (conf_p["pattern"] === "MINI") {
			print(TAB2 + "Defining the pattern over a reduced range"); 
			setDMX_testPattern(miniPattern);
		}
		else print(TAB2 + "Error, unknown pattern type");
	}
	print("");

    // set the register: SAMPLING_DELAY
    print(TAB1+"Setting the 4 registers SAMPLING_DELAY to " + conf_p["samp_delay"]);
	for (var col=0; col<DMX_NB_COL; col++) setDMX_sampling_delay(col, conf_p["samp_delay"]);

	// Setting the BOXCAR LENGTH
    print(TAB1+"Setting the boxcar length to " + conf_p["bxLength"]);
	setDMX_boxcarLength(conf_p["bxLength"]);

    // set the register: MUX_SQ_FB_DELAY
    print(TAB1 + "Setting the register MUX_SQ_FB_DELAY to " + conf_p["fb_delay"]);
	for (col=0; col<DMX_NB_COL; col++) setDMX_feedback_delay(col, conf_p["fb_delay"]);

    // set the register: AMP_SQ_OFFSET_MUX_DELAY
    print(TAB1 + "Setting the register AMP_SQ_OFFSET_MUX_DELAY to " + conf_p["ofco_mux_delay"]);
	for (col=0; col<DMX_NB_COL; col++) setDMX_offsetMUX_delay(col, conf_p["ofco_mux_delay"]);

    // Selecting the pulse shaping set
	print(TAB1+"Selecting the pulse shaping set number " + conf_p["pulseShapingSet"] + ":");
	for (col=0; col<DMX_NB_COL; col++)	setDMX_pulseShapingSelection(col, conf_p["pulseShapingSet"]);

	// Autorelock
	print(TAB1 + "Setting auto relock parameters");
	print(TAB2 + "Delay: " + relockDelay);
	print(TAB2 + "Threshold: " + relockThreshold);
	for (col=0; col<DMX_NB_COL; col++) {
		setDMX_relock_delay(col, relockDelay);
		setDMX_relock_threshold(col, relockThreshold);
	}

    // DEMUX offset
	print(TAB1+"Setting the Offset close to the AMP SQUID operating point...");
	for (col=0; col<DMX_NB_COL; col++) {
		setDMX_sqa_OffsetLSB(col, conf_p["offsetLSB"]);
		setDMX_sqa_OffsetLSBptr(col, conf_p["offsetLSB"]);
		setDMX_sqa_OffsetFine(col, makeArray(DMX_NB_PIX_PER_COL, conf_p["offsetFine"]), makeArray(DMX_NB_PIX_PER_COL, conf_p["offsetFine"]));
		setDMX_sqa_OffsetCoarse(col, conf_p["offsetCoarse"]);
	}

    // Setting parameter A
	print(TAB1+"Setting the feedback parameter A: " + conf_p["a"]);
	for (col=0; col<DMX_NB_COL; col++)	setDMX_a(col, makeArray(DMX_NB_PIX_PER_COL, conf_p["a"]));
	
    // Setting the Mux SQUID FLL LOCKPOINT_V
	print(TAB1+"Setting the Mux SQUID FLL lockpoint voltage: " + conf_p["lockPointVMuxFll"]);
	for (col=0; col<DMX_NB_COL; col++)	setDMX_sqm_lockpointV(col, makeArray(DMX_NB_PIX_PER_COL, conf_p["lockPointVMuxFll"][col]));

    // Setting the MUX INPUT GAIN
	print(TAB1 + "Setting the MUX SQUID loop input gain to " + conf_p["muxInputGain"]);
	for (col=0; col<DMX_NB_COL; col++) setDMX_sqm_inputGain(col, conf_p["muxInputGain"][col]);

    // Setting the Amp SQUID FLL LOCKPOINT_V
	print(TAB1+"Setting the Amp SQUID FLL lockpoint voltage: " + conf_p["lockPointVAmpFll"]);
	for (col=0; col<DMX_NB_COL; col++)	setDMX_sqa_lockpointV(col, conf_p["lockPointVAmpFll"][col]);

    // Setting the AMP INPUT GAIN
	print(TAB1 + "Setting the AMP SQUID loop input gain to " + conf_p["ampInputGain"]);
	for (col=0; col<DMX_NB_COL; col++) setDMX_sqa_inputGain(col, conf_p["ampInputGain"][col]);

    // DEMUX feedback
	print(TAB1+"Setting the DMX FB0 values: " + conf_p["fb0"]);
    var fb = makeArray(DMX_NB_PIX_PER_COL, conf_p["fb0"]);
	for (col=0; col<DMX_NB_COL; col++) setDMX_fb0(col, fb);

	print(TAB1+"Switching ON the feedback for all the columns");
    setDMX_safeFeedbackOnOff([ON, ON, ON, ON]);

	print(TAB1+"Setting the DMX feedback mode to OPEN LOOP...");
	fbMode = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_OPEN_LOOP);
	for (col=0; col<DMX_NB_COL; col++) setDMX_sqm_FBMode(col, fbMode);

    // DEMUX offset compensation
	print(TAB1+"Setting the offset mode to OFFSET (OFFSET -> OFFSET output)...");
	setDMX_offsetMode(makeArray(DMX_NB_COL, OFFSET_MODE_OFFSET));

}

// -------------------------------------------------------------------------------------------------------------
