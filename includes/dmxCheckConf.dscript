//    @file                     include/dmxCheckConf.dscript
// -------------------------------------------------------------------------------------------------------------
//    @details
//
//    This file defines a script that compares the values of the DEMUX registers with a reference configuration.
//
// -------------------------------------------------------------------------------------------------------------

function dmxCheckDefaults(ref_conf) {

    var ERROR_COUNTER = 0;

    /******************************************************************************************************************/
    print("<pre>")
    plotLongLine();
    print("| Testing the default values of the DEMUX registers...");
    print("| " + maDate());


    /******************************************************************************************************************/
    plotLongLine();
    print("Reading the firmware version");
    fwVersion = readDMX_firmwareVersion(true);

    /******************************************************************************************************************/
    plotLongLine();
    print("Reading the hardware version");
    readDMX_hardwareVersion(true);
    plotLongLine();
    print("</pre>");


    print("{{collapse(Click to see the full script report...)");
    print("<pre>");
    /* DATA_ACQ_MODE **************************************************************************************************/
    plotLongLine();
    print("Testing the DATA_ACQ_MODE register:");
    var fw_value = readDMX_dataAcqMode();
    print(TAB1 + "Firmware value is: " + fw_value);
    print(TAB1 + "Expected value is: " + ref_conf["DATA_ACQ_MODE"]);
    ERROR_COUNTER = error_manager(fw_value, ref_conf["DATA_ACQ_MODE"], ERROR_COUNTER, TAB1);

    /* MUX_SQ_FB_ON_OFF ***********************************************************************************************/
    plotLongLine();
    print("Testing the MUX_SQ_FB_ON_OFF register:");
    fw_value = readDMX_feedbackOnOff();
    print(TAB1 + "Firmware value is: " + fw_value);
    print(TAB1 + "Expected value is: " + ref_conf["MUX_SQ_FB_ON_OFF"]);
    ERROR_COUNTER = error_manager(fw_value, ref_conf["MUX_SQ_FB_ON_OFF"], ERROR_COUNTER, TAB1);

    /* AMP_SQ_OFFSET_MODE *********************************************************************************************/
    plotLongLine();
    print("Testing the AMP_SQ_OFFSET_MODE register:");
    fw_value = readDMX_offsetMode();
    print(TAB1 + "Firmware value is: " + fw_value);
    print(TAB1 + "Expected value is: " + ref_conf["AMP_SQ_OFFSET_MODE"]);
    ERROR_COUNTER = error_manager(fw_value, ref_conf["AMP_SQ_OFFSET_MODE"], ERROR_COUNTER, TAB1);

    /* TEST_PATTERN ***************************************************************************************************/
    plotLongLine();
    print("Testing the TEST_PATTERN registers:");
    fw_value = readDMX_testPattern();
    print(TAB1 + "Firmware value is: " + fw_value);
    print(TAB1 + "Expected value is: " + ref_conf["TEST_PATTERN"]);
    ERROR_COUNTER = error_manager(fw_value, ref_conf["TEST_PATTERN"], ERROR_COUNTER, TAB1);

    /* TEST_PATTERN_ENABLE ********************************************************************************************/
    plotLongLine();
    print("Testing the TEST_PATTERN_ENABLE register:");
    fw_value = readDMX_testPatternEnable();
    print(TAB1 + "Firmware value is: " + fw_value);
    print(TAB1 + "Expected values are: " + ref_conf["TEST_PATTERN_ENABLE"]);
    ERROR_COUNTER = error_manager(fw_value, ref_conf["TEST_PATTERN_ENABLE"], ERROR_COUNTER, TAB1);

    /* BOXCAR_LENGTH **************************************************************************************************/
    plotLongLine();
    print("Testing the BOXCAR_LENGTH register:");
    fw_value = readDMX_boxcarLength();
    print(TAB1 + "Firmware value is: " + fw_value);
    print(TAB1 + "Expected value is: " + ref_conf["BOXCAR_LENGTH"]);
    ERROR_COUNTER = error_manager(fw_value, ref_conf["BOXCAR_LENGTH"], ERROR_COUNTER, TAB1);

    /* A **************************************************************************************************************/
    plotLongLine();
    print("Testing the A register:");
    for (var col=0; col<DMX_NB_COL; col++) {
        print(TAB1 + "Testing column " + col);
        fw_value = readDMX_a(col);
        print(TAB2 + "Firmware value is: " + fw_value);
        print(TAB2 + "Expected value is: " + ref_conf["A"][col]);
        ERROR_COUNTER = error_manager(fw_value, ref_conf["A"][col], ERROR_COUNTER, TAB2);
    }

    /* MUX_SQ_INPUT_GAIN **********************************************************************************************/
    plotLongLine();
    print("Testing the MUX_SQ_INPUT_GAIN register:");
    fw_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) fw_value[col] = readDMX_sqm_inputGain(col);
    print(TAB1 + "Firmware value is: " + fw_value);
    print(TAB2 + "Expected value is: " + ref_conf["MUX_SQ_INPUT_GAIN"]);
    ERROR_COUNTER = error_manager(fw_value, ref_conf["MUX_SQ_INPUT_GAIN"], ERROR_COUNTER, TAB2);

    /* AMP_SQ_INPUT_GAIN **********************************************************************************************/
    plotLongLine();
    print("Testing the AMP_SQ_INPUT_GAIN register:");
    fw_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) fw_value[col] = readDMX_sqa_inputGain(col);
    print(TAB1 + "Firmware value is: " + fw_value);
    print(TAB2 + "Expected value is: " + ref_conf["AMP_SQ_INPUT_GAIN"]);
    ERROR_COUNTER = error_manager(fw_value, ref_conf["AMP_SQ_INPUT_GAIN"], ERROR_COUNTER, TAB2);

    /* MUX_SQ_KI_KNORM ************************************************************************************************/
    plotLongLine();
    print("Testing the MUX_SQ_KI_KNORM register:");
    for (col=0; col<DMX_NB_COL; col++) {
        print(TAB1 + "Testing column " + col);
        fw_value = readDMX_sqm_kiknorm(col);
        print(TAB2 + "Firmware value is: " + fw_value);
        print(TAB2 + "Expected value is: " + ref_conf["MUX_SQ_KI_KNORM"][col]);
        ERROR_COUNTER = error_manager(fw_value, ref_conf["MUX_SQ_KI_KNORM"][col], ERROR_COUNTER, TAB2);
    }

    /* AMP_SQ_KI_KNORM ************************************************************************************************/
    plotLongLine();
    print("Testing the AMP_SQ_KI_KNORM register:");
    fw_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) fw_value[col] = readDMX_sqa_kiknorm(col);
    print(TAB1 + "Firmware value is: " + fw_value);
    print(TAB1 + "Expected value is: " + ref_conf["AMP_SQ_KI_KNORM"]);
    ERROR_COUNTER = error_manager(fw_value, ref_conf["AMP_SQ_KI_KNORM"], ERROR_COUNTER, TAB1);

    /* MUX_SQ_KNORM ***************************************************************************************************/
    plotLongLine();
    print("Testing the MUX_SQ_KNORM register:");
    for (col=0; col<DMX_NB_COL; col++) {
        print(TAB1 + "Testing column " + col);
        fw_value = readDMX_sqm_knorm(col);
        print(TAB2 + "Firmware value is: " + fw_value);
        print(TAB2 + "Expected value is: " + ref_conf["MUX_SQ_KNORM"][col]);
        ERROR_COUNTER = error_manager(fw_value, ref_conf["MUX_SQ_KNORM"][col], ERROR_COUNTER, TAB2);
    }

    /* AMP_SQ_KNORM ***************************************************************************************************/
    plotLongLine();
    print("Testing the AMP_SQ_KNORM register:");
    fw_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) fw_value[col] = readDMX_sqa_knorm(col);
    print(TAB1 + "Firmware value is: " + fw_value);
    print(TAB2 + "Expected value is: " + ref_conf["AMP_SQ_KNORM"]);
    ERROR_COUNTER = error_manager(fw_value, ref_conf["AMP_SQ_KNORM"], ERROR_COUNTER, TAB1);

    /* MUX_SQ_FB0 *****************************************************************************************************/
    plotLongLine();
    print("Testing the MUX_SQ_FB0 register:");
    for (col=0; col<DMX_NB_COL; col++) {
        print(TAB1 + "Testing column " + col);
        fw_value = readDMX_fb0(col);
        print(TAB2 + "Firmware value is: " + fw_value);
        print(TAB2 + "Expected value is: " + ref_conf["MUX_SQ_FB0"][col]);
        ERROR_COUNTER = error_manager(fw_value, ref_conf["MUX_SQ_FB0"][col], ERROR_COUNTER, TAB2);
    }

    /* MUX_SQ_LOCKPOINT_V *********************************************************************************************/
    plotLongLine();
    print("Testing the MUX_SQ_LOCKPOINT_V register:");
    for (col=0; col<DMX_NB_COL; col++) {
        print(TAB1 + "Testing column " + col);
        fw_value = readDMX_sqm_lockpointV(col);
        print(TAB2 + "Firmware value is: " + fw_value);
        print(TAB2 + "Expected value is: " + ref_conf["MUX_SQ_LOCKPOINT_V"][col]);
        ERROR_COUNTER = error_manager(fw_value, ref_conf["MUX_SQ_LOCKPOINT_V"][col], ERROR_COUNTER, TAB2);
    }

    /* AMP_SQ_LOCKPOINT_V *********************************************************************************************/
    if (fwVersion >= 0x14) {
        plotLongLine();
        print("Testing the AMP_SQ_LOCKPOINT_V register:");
        fw_value = [DMX_NB_COL];
        for (col=0; col<DMX_NB_COL; col++) fw_value[col] = readDMX_sqa_lockpointV(col);
        print(TAB1 + "Firmware value is: " + fw_value);
        print(TAB2 + "Expected value is: " + ref_conf["AMP_SQ_LOCKPOINT_V"]);
        ERROR_COUNTER = error_manager(fw_value, ref_conf["AMP_SQ_LOCKPOINT_V"], ERROR_COUNTER, TAB1);
    }

    /* MUX_SQ_FB_MODE *************************************************************************************************/
    plotLongLine();
    print("Testing the MUX_SQ_FB_MODE register:");
    for (col=0; col<DMX_NB_COL; col++) {
        print(TAB1 + "Testing column " + col);
        fw_value = readDMX_sqm_FBMode(col);
        print(TAB2 + "Firmware value is: " + fw_value);
        print(TAB2 + "Expected value is: " + ref_conf["MUX_SQ_FB_MODE"][col]);
        ERROR_COUNTER = error_manager(fw_value, ref_conf["MUX_SQ_FB_MODE"][col], ERROR_COUNTER, TAB2);
    }

    /* AMP_SQ_OFFSET_FINE *************************************************************************************************/
    plotLongLine();
    print("Testing the AMP_SQ_OFFSET_FINE register:");

    for (col=0; col<DMX_NB_COL; col++) {
        print(TAB1 + "Testing column " + col);

        fw_value = readDMX_sqa_OffsetFine(col);
        print(TAB2 + "Nominal mode:");
        print(TAB3 + "Firmware value is: ");
		print(fw_value[0]);
        print(TAB3 + "Expected value is: ");
		print(ref_conf["AMP_SQ_OFFSET_FINE"][col]);
        ERROR_COUNTER = error_manager(fw_value[0], ref_conf["AMP_SQ_OFFSET_FINE"][col], ERROR_COUNTER, TAB3);

        print(TAB2 + "Test pattern mode:");
        print(TAB3 + "Firmware value is: ");
		print(fw_value[1]);
        print(TAB3 + "Expected value is: ");
		print(ref_conf["AMP_SQ_OFFSET_FINE_PTR"][col]);
        ERROR_COUNTER = error_manager(fw_value[1], ref_conf["AMP_SQ_OFFSET_FINE_PTR"][col], ERROR_COUNTER, TAB3);
    }

    /* AMP_SQ_OFFSET_LSB_PTR ******************************************************************************************/
    plotLongLine();
    print("Testing AMP_SQ_OFFSET_LSB_PTR register:");
    fw_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) fw_value[col] = readDMX_sqa_OffsetLSBptr(col);
    print(TAB1 + "Firmware value is: " + fw_value);
    print(TAB2 + "Expected value is: " + ref_conf["AMP_SQ_OFFSET_LSB_PTR"]);
    ERROR_COUNTER = error_manager(fw_value, ref_conf["AMP_SQ_OFFSET_LSB_PTR"], ERROR_COUNTER, TAB1);

    /* AMP_SQ_OFFSET_LSB **********************************************************************************************/
    plotLongLine();
    print("Testing the AMP_SQ_OFFSET_LSB register:");
    fw_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) fw_value[col] = readDMX_sqa_OffsetLSB(col);
    print(TAB1 + "Firmware value is: " + fw_value);
    print(TAB2 + "Expected value is: " + ref_conf["AMP_SQ_OFFSET_LSB"]);
    ERROR_COUNTER = error_manager(fw_value, ref_conf["AMP_SQ_OFFSET_LSB"], ERROR_COUNTER, TAB1);

    /* AMP_SQ_OFFSET_COARSE *******************************************************************************************/
    plotLongLine();
    print("Testing the AMP_SQ_OFFSET_COARSE register:");
    fw_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) fw_value[col] = readDMX_sqa_OffsetCoarse(col);
    print(TAB1 + "Firmware value is: " + fw_value);
    print(TAB2 + "Expected value is: " + ref_conf["AMP_SQ_OFFSET_COARSE"]);
    ERROR_COUNTER = error_manager(fw_value, ref_conf["AMP_SQ_OFFSET_COARSE"], ERROR_COUNTER, TAB1);

    /* MUX_SQ_FB_DELAY ************************************************************************************************/
    plotLongLine();
    print("Testing the MUX_SQ_FB_DELAY register:");
    fw_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) fw_value[col] = readDMX_feedback_delay(col);
    print(TAB1 + "Firmware value is: " + fw_value);
    print(TAB2 + "Expected value is: " + ref_conf["MUX_SQ_FB_DELAY"]);
    ERROR_COUNTER = error_manager(fw_value, ref_conf["MUX_SQ_FB_DELAY"], ERROR_COUNTER, TAB1);

    /* AMP_SQ_OFFSET_DAC_DELAY ****************************************************************************************/
    plotLongLine();
    print("Testing the AMP_SQ_OFFSET_DAC_DELAY register:");
    fw_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) fw_value[col] = readDMX_offsetDAC_delay(col);
    print(TAB1 + "Firmware value is: " + fw_value);
    print(TAB2 + "Expected value is: " + ref_conf["AMP_SQ_OFFSET_DAC_DELAY"]);
    ERROR_COUNTER = error_manager(fw_value, ref_conf["AMP_SQ_OFFSET_DAC_DELAY"], ERROR_COUNTER, TAB1);

    /* AMP_SQ_OFFSET_MUX_DELAY ****************************************************************************************/
    plotLongLine();
    print("Testing the AMP_SQ_OFFSET_MUX_DELAY register:");
    fw_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) fw_value[col] = readDMX_offsetMUX_delay(col);
    print(TAB1 + "Firmware value is: " + fw_value);
    print(TAB2 + "Expected value is: " + ref_conf["AMP_SQ_OFFSET_MUX_DELAY"]);
    ERROR_COUNTER = error_manager(fw_value, ref_conf["AMP_SQ_OFFSET_MUX_DELAY"], ERROR_COUNTER, TAB1);

    /* SAMPLING_DELAY *************************************************************************************************/
    plotLongLine();
    print("Testing the SAMPLING_DELAY register:");
    fw_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) fw_value[col] = readDMX_sampling_delay(col);
    print(TAB1 + "Firmware value is: " + fw_value);
    print(TAB2 + "Expected value is: " + ref_conf["SAMPLING_DELAY"]);
    ERROR_COUNTER = error_manager(fw_value, ref_conf["SAMPLING_DELAY"], ERROR_COUNTER, TAB1);

    /* PULSE_SHAPING **************************************************************************************************/
    plotLongLine();
    print("Testing the PULSE_SHAPING register:");
    for (col=0; col<DMX_NB_COL; col++) {
        print(TAB1 + "Testing column " + col);
        fw_value = readDMX_pulseShaping(col);
        print(TAB2 + "Firmware value is: " + fw_value);
        print(TAB2 + "Expected value is: " + ref_conf["PULSE_SHAPING"]);
        ERROR_COUNTER = error_manager(fw_value, ref_conf["PULSE_SHAPING"], ERROR_COUNTER, TAB2);
    }

    /* PULSE_SHAPING_SELECTION ****************************************************************************************/
    plotLongLine();
    print("Testing the PULSE_SHAPING_SELECTION register:");
    fw_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) fw_value[col] = readDMX_pulseShapingSelection(col);
    print(TAB1 + "Firmware value is: " + fw_value);
    print(TAB2 + "Expected value is: " + ref_conf["PULSE_SHAPING_SELECTION"]);
    ERROR_COUNTER = error_manager(fw_value, ref_conf["PULSE_SHAPING_SELECTION"], ERROR_COUNTER, TAB1);

    /* RELOCK_DELAY ***************************************************************************************************/
    plotLongLine();
    print("Testing the RELOCK_DELAY register:");
    fw_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) fw_value[col] = readDMX_relock_delay(col);
    print(TAB1 + "Firmware value is: " + fw_value);
    print(TAB2 + "Expected value is: " + ref_conf["RELOCK_DELAY"]);
    ERROR_COUNTER = error_manager(fw_value, ref_conf["RELOCK_DELAY"], ERROR_COUNTER, TAB1);

    /* RELOCK_THRESHOLD ***********************************************************************************************/
    plotLongLine();
    print("Testing the RELOCK_THRESHOLD register:");
    fw_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) fw_value[col] = readDMX_relock_threshold(col);
    print(TAB1 + "Firmware value is: " + fw_value);
    print(TAB2 + "Expected value is: " + ref_conf["RELOCK_THRESHOLD"]);
    ERROR_COUNTER = error_manager(fw_value, ref_conf["RELOCK_THRESHOLD"], ERROR_COUNTER, TAB1);

    /* DELOCK_COUNTERS ************************************************************************************************/
    plotLongLine();
    print("Testing the DELOCK_COUNTERS register:");
    fw_value = [DMX_NB_COL];
    for (col=0; col<DMX_NB_COL; col++) fw_value[col] = readDMX_delockCounters(col);
    print(TAB1 + "Firmware value is: " + fw_value);
    const NB_PIX_EMPTY_ARRAY = makeArray(DMX_NB_PIX_PER_COL, 0);
    expected_value = [NB_PIX_EMPTY_ARRAY, NB_PIX_EMPTY_ARRAY, NB_PIX_EMPTY_ARRAY, NB_PIX_EMPTY_ARRAY];
    print(TAB1 + "Expected value is: " + expected_value);
    ERROR_COUNTER = error_manager(fw_value, expected_value, ERROR_COUNTER, TAB1);

    /******************************************************************************************************************/
    plotLongLine();
    print("</pre>");
    print("}}");

    print("<pre>");
    plotLongLine();
    if (ERROR_COUNTER === 1) print("Oups, " + ERROR_COUNTER + " error has been detected!");
    else    if (ERROR_COUNTER > 1) print("Oups, " + ERROR_COUNTER + " errors have been detected!");
        else print("Nice, no error detected");
    plotLongLine();
    print("</pre>");

    /******************************************************************************************************************/

    return ERROR_COUNTER === 0;

}
