// imports
include("../includes/demux/dmxTools.dscript");
include("../includes/common/constants.dscript");


/**
 * This function makes different kinds of TM files (TEST PATTERN, ERROR, DUMP)
 */
function dmxTMCheck() {

    const saveDataDurationMs = 300;

    /******************************************************************************************************************/
    plotLongLine();
    print("Configuring the test pattern...");

    const fakePulsePattern = [
    [0x7FFF, 0x0000, -1*0x0400, 0x0020],    // Very steep slope downward
    [-0x0001, 0x01FF, 0x0000, 0x0001],      // Plateau
    [-0x0001, 0x000F, 0x0040, 0x0100],      // Steep slope upward
    [0x3FFF, 0x000F, 0x0010, 0x0400],       // Slow slope upward
    [0x7FFF, 0x7FFF, 0x0000, 0x0001]];      // Plateau

    setDMX_testPattern(fakePulsePattern);

    print(TAB1 + "Checking the values in the firmware...");
    var checked_values = readDMX_testPattern();

    var checkIsOK = true;
    if (!arraysAreEquals(fakePulsePattern, checked_values)) checkIsOK = false;

    if (checkIsOK) print(TAB1 + "The values in the firmware are as expected.");
    else print(TAB1 + "ERROR, the values in the firmware are not the expected ones.");


    /******************************************************************************************************************/
    plotLongLine();
    print("===> Testing the TEST PATTERN data acquisition mode...");

    print(TAB1 + "Configuring the data acquisition mode to: TEST_PATTERN");
    setDMX_dataAcqMode(ACQ_MODE_TSTPATTERN);

    // Start saving some data
    sendToDMXSaveScienceRaw("feedbackInErrorSignal", saveDataDurationMs, 0xF, 0);

    print(TAB1 + "Saving some data while enabling the test pattern for 4 iterations");
    const enable = true;
    const infinite = false;
    const numberIterations = 4;
    setDMX_testPatternEnable(enable, infinite, numberIterations)

    waitMs(1000); //      On attend que le test pattern soit passé

    //      Des données de type test pattern sont envoyées sur le lien science
    // ==>> La sauvegarde dans un fichier SCIENCE / TEST PATTERN doit commencer
    //      Quand le test pattern est terminé le mode d'acquisition passe en IDLE.
    //      Le DEMUX ne produit plus de données
    // ==>> La sauvegarde dans le fichier doit se terminer


    /******************************************************************************************************************/
    plotLongLine();
    print("===> Testing the ERROR data acquisition mode...");
    print("Sending the test pattern to the SQM feedback...");
    print(TAB1 + "The feedback loopback shall be plugged on the DEMUX!!");

    print(TAB1 + "Configuring the data acquisition mode to: ERROR");
    setDMX_dataAcqMode(ACQ_MODE_ERROR);
    //      Des données de type ERROR commencent à être envoyées sur le lien science
    // ==>> La sauvegarde dans un fichier ERROR doit commencer

    print(TAB1 + "Configuring the feedback mode of column 1, pixel 0 and 5 to: TEST PATTERN");
    var colId = 1;
    var FBMode = [
        FEEDBACK_MODE_TESTPATTERN, FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP,
        FEEDBACK_MODE_TESTPATTERN, FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP,
        FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP,
        FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP,
        FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP,
        FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP,
        FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP, FEEDBACK_MODE_OPEN_LOOP];
    setDMX_sqm_FBMode(colId, FBMode);

    print(TAB1 + "Activating the 4 columns");
    setDMX_safeFeedbackOnOff([ON, ON, ON, ON]);

    // Start saving some data
    sendToDMXSaveScienceRaw("feedbackInErrorSignal", saveDataDurationMs, 0xF, 0);

    print(TAB1 + "Saving some data while enabling the test pattern for 4 iterations");
    setDMX_testPatternEnable(enable, infinite, numberIterations);

    waitMs(1000); //      On attend que le test pattern soit passé

    print("  Configuring the data acquisition mode to: IDLE");
    setDMX_dataAcqMode(ACQ_MODE_IDLE);

    //      Le DEMUX ne produit plus de données
    // ==>> La sauvegarde dans le fichier doit se terminer
    //      On doit observer l'effet du pulse shaping qui est programmé à 20MHz par défaut

    /******************************************************************************************************************/
    plotLongLine();
    print("===> Testing the DUMP data acquisition mode...");

    print(TAB1 + "Setting the feedback FB0 values");
    const minVal = -1*Math.pow(2, 13);
    const maxVal = Math.pow(2, 13) - (1/Math.pow(2, 2));

    const tabFb0 = [
        maxVal, minVal, maxVal, minVal, minVal, minVal, minVal, minVal, minVal,
        minVal, minVal, minVal, minVal, minVal, minVal, minVal, minVal, minVal,
        minVal, minVal, minVal, minVal, minVal, minVal, minVal, minVal, minVal,
        minVal, minVal, minVal, minVal, minVal, minVal, minVal
    ];
    for (var col=0; col<DMX_NB_COL; col++) setDMX_fb0(col, tabFb0);

    print(TAB1 + "Configuring the feedback mode to: OPEN LOOP");
    var tabFbModesOpenLoop = makeArray(DMX_NB_PIX_PER_COL, FEEDBACK_MODE_OPEN_LOOP);
    for (col=0; col<DMX_NB_COL; col++) setDMX_sqm_FBMode(col, tabFbModesOpenLoop);

    print(TAB1 + "Measuring DUMP data");
    setDMX_dataAcqMode(ACQ_MODE_DUMP);

    //      Des données de type DUMP sont envoyées sur le lien science
    // ==>> Un fichier doit être généré
    //      Lorsque le DUMP est terminé (1360 valeurs) le mode d'acquisition repasse en IDLE
    //      Le DEMUX ne produit plus de données
    // ==>> La sauvegarde dans le fichier doit se terminer

    /******************************************************************************************************************/
    plotLongLine();
}


function startSession(sessionName) {
    sendStartNewSession(sessionName, "");
}


/**
 * This function is called when the script is aborted
 */
function onAbortScript() {

    // de-activating the test pattern
    setDMX_testPatternEnable(false, false, 0);

    // de-activating data acquisition
    sendToDMXGoToIdleMode();

    // Switching OFF the columns
    setDMX_safeFeedbackOnOff([OFF, OFF, OFF, OFF]);

	print("End of script!");
}


// -------------------------------------------------------------------------------------------------------------

startSession("dmxCheckTM");

// ----- Running the test
dmxTMCheck();

onAbortScript();

// -------------------------------------------------------------------------------------------------------------
